# Server
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# Database
MONGODB_URI=mongodb://localhost:27017/vn_itjobs

# Security & Secrets (Bắt buộc phải đổi ở production)
COOKIE_SECRET=change_me_to_a_secure_cookie_secret_at_least_32_chars
JWT_SECRET=change_me_to_a_secure_jwt_secret_at_least_32_chars
ADMIN_JWT_SECRET=change_me_to_a_secure_admin_jwt_secret_at_least_32_chars

# Application Settings
ADMIN_PATH=admin
EMPLOYER_REQUIRE_APPROVAL=true

# Storage Driver: local | cloudinary
STORAGE_DRIVER=local

# Cloudinary (Tùy chọn khi STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
