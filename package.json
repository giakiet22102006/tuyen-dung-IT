{
  "name": "vn-itjobs",
  "version": "1.0.0",
  "description": "VN.ITJobs - Website tuyển dụng IT và Quản trị Admin",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:css",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/assets/css/tailwind.css --watch",
    "seed": "node src/scripts/seed.js",
    "create-admin": "node src/scripts/create-admin.js",
    "benchmark": "node src/scripts/benchmark.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "file-type": "^19.6.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.2.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pug": "^3.0.3",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.2",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.2"
  }
}
