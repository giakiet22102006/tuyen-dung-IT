        block title 
    body(class="min-h-screen flex flex-col bg-white text-[#121212]")
        //- Header
        include ../partials/header.pug
        //- End Header

        //- Banner cảnh báo cho Employer pending
        if role === 'employer' && currentUser && currentUser.status === 'pending'
            div(class="bg-[#FFF3CD] border-b border-[#FFEEBA] text-[#856404] py-[12px] px-[20px] text-center font-[500] text-[14px]")
                <i class="fa-solid fa-circle-exclamation mr-[8px]"></i>
                | Tài khoản công ty của bạn đang chờ quản trị viên phê duyệt. Trong thời gian này, bạn chưa thể đăng hoặc chỉnh sửa việc làm.

        //- Flash messages toàn cục (nếu có)
        if flash && flash.success && !currentPath.includes("/login") && !currentPath.includes("/signup") && !currentPath.includes("/change-password")
            .contain(class="mt-[20px]")
                div(class="p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
        if flash && flash.error && !currentPath.includes("/login") && !currentPath.includes("/signup") && !currentPath.includes("/change-password")
            .contain(class="mt-[20px]")
                div(class="p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}

        //- Thân trang tự động mở rộng để cố định footer ở chân trang
        main(class="main-content flex-1 flex flex-col w-full")
            block main

        //- Footer 
        include ../partials/footer.pug
        //- End Footer 

        //- Floating Support & Feedback Widget
        include ../partials/feedback-widget.pug

        script(src="/assets/js/main.js?v=2.6")
        script(src="/assets/js/ai-features.js?v=2.2")
