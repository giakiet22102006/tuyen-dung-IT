                  "name": "VN.ITJobs",
                  "legalName": "Công ty Cổ phần Công nghệ VN.ITJobs Việt Nam",
                  "alternateName": "Công ty Cổ phần Công nghệ VN.ITJobs Việt Nam",
                  "url": "https://tuyen-dung-it.vercel.app",
