                  },
                  "image": "https://tuyen-dung-it.vercel.app/assets/images/og-image.png",
                  "description": "Nền tảng tuyển dụng IT và kết nối nhân tài công nghệ hàng đầu Việt Nam, hỗ trợ tìm kiếm việc làm lập trình viên, tra cứu lương IT và AI Matchmaking.",
                  "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Tầng 12, Tòa nhà Keangnam Landmark 72, Đường Phạm Hùng",
                    "addressLocality": "Nam Từ Liêm",
