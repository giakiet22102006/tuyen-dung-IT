doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="csrf-token", content=csrfToken)
        - const siteUrl = "https://tuyen-dung-it.vercel.app"
        - const pageUrl = canonicalUrl || (siteUrl + (currentPath === "/" ? "" : (currentPath || "")))
        - const pageTitle = title || "VN.ITJobs - Nền tảng tuyển dụng IT & Việc làm Developer hàng đầu Việt Nam"
        - const pageDesc = metaDescription || "VN.ITJobs là nền tảng tuyển dụng IT hàng đầu Việt Nam, kết nối hơn 100.000+ lập trình viên với hàng nghìn việc làm công nghệ chất lượng cao tại Hà Nội, TP.HCM, Đà Nẵng và Remote."
        - const pageImage = ogImage || (siteUrl + "/assets/images/og-image.png")
        - const pageType = ogType || "website"
        link(rel="canonical", href=pageUrl)
        meta(name="description", content=pageDesc)
        meta(property="og:site_name", content="VN.ITJobs")
        meta(property="og:type", content=pageType)
        meta(property="og:url", content=pageUrl)
        meta(property="og:title", content=pageTitle)
        meta(property="og:description", content=pageDesc)
        meta(property="og:image", content=pageImage)
        meta(property="og:image:width", content="1200")
        meta(property="og:image:height", content="630")
        meta(property="og:locale", content="vi_VN")
        meta(name="twitter:card", content="summary_large_image")
        meta(name="twitter:title", content=pageTitle)
        meta(name="twitter:description", content=pageDesc)
        meta(name="twitter:image", content=pageImage)
        link(rel="icon", type="image/svg+xml", href="/assets/images/favicon.svg")
        link(rel="alternate icon", href="/favicon.ico")
        link(rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin)
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(rel="dns-prefetch" href="https://cdnjs.cloudflare.com")
        link(rel="dns-prefetch" href="https://fonts.googleapis.com")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap")
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css")
        link(rel="stylesheet", href="/assets/css/tailwind.css?v=2.6")
        link(rel="stylesheet", href="/assets/css/style.css?v=2.6")
        script(type="application/ld+json").
            {
