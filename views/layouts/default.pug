                  "description": "Nền tảng tuyển dụng IT và Việc làm Developer hàng đầu Việt Nam",
                  "inLanguage": "vi-VN",
                  "potentialAction": {
                    "@type": "SearchAction",
                    "target": {
                      "@type": "EntryPoint",
                      "urlTemplate": "https://tuyen-dung-it.vercel.app/search?keyword={search_term_string}"
