                  "sameAs": [
                    "https://github.com",
                    "https://www.linkedin.com"
                  ]
                },
                {
                  "@type": "SoftwareApplication",
                  "@id": "https://tuyen-dung-it.vercel.app/#software",
                  "name": "VN.ITJobs",
                  "applicationCategory": "BusinessApplication",
