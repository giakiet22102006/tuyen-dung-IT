doctype html
html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(name="csrf-token" content=csrfToken)
        meta(name="robots" content="noindex, nofollow")
        link(rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg")
        link(rel="alternate icon" href="/favicon.ico")
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap")
        block title
            title #{title || "Quản trị viên - VN.ITJobs"}
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css")
        link(rel="stylesheet" href="/assets/css/tailwind.css?v=2.3")
        style.
            .admin-stat-card {
                padding: 22px 24px !important;
                border-radius: 12px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
            }
        script(src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js")
    body(class="bg-[#F8F9FA] text-[#121212] font-['Lexend',sans-serif] antialiased min-h-screen flex flex-col lg:flex-row")
        //- Sidebar Quản trị
        aside(id="adminSidebar" class="hidden lg:flex w-full lg:w-[260px] bg-[#000065] text-white flex-shrink-0 flex-col justify-between py-[24px] px-[20px] transition-all")
            div
                div(class="flex items-center justify-between pb-[24px] border-b border-white/10 mb-[24px]")
                    a(href="/" + adminPath class="font-[700] text-[20px] tracking-wide flex items-center gap-[10px]")
                        span(class="text-[#0088FF]") VN.
                        span ITJobs
                        span(class="text-[12px] bg-[#0088FF] px-[8px] py-[2px] rounded font-[600]") ADMIN
                    button(id="sidebarCloseBtn" class="lg:hidden text-white/80 hover:text-white text-[20px]")
                        <i class="fa-solid fa-xmark"></i>

                nav(class="space-y-[8px]")
                    a(href="/" + adminPath class="flex items-center gap-[12px] px-[16px] py-[12px] rounded-[6px] text-[15px] font-[500] hover:bg-white/10 transition-colors " + (currentPath === "/" + adminPath ? "bg-[#0088FF] text-white font-[600]" : "text-white/80"))
                        <i class="fa-solid fa-chart-pie w-[20px]"></i>
                        span Bảng điều khiển

                    a(href="/" + adminPath + "/employers" class="flex items-center gap-[12px] px-[16px] py-[12px] rounded-[6px] text-[15px] font-[500] hover:bg-white/10 transition-colors " + (currentPath.startsWith("/" + adminPath + "/employers") ? "bg-[#0088FF] text-white font-[600]" : "text-white/80"))
                        <i class="fa-solid fa-building w-[20px]"></i>
                        span Nhà tuyển dụng

                    a(href="/" + adminPath + "/candidates" class="flex items-center gap-[12px] px-[16px] py-[12px] rounded-[6px] text-[15px] font-[500] hover:bg-white/10 transition-colors " + (currentPath.startsWith("/" + adminPath + "/candidates") ? "bg-[#0088FF] text-white font-[600]" : "text-white/80"))
                        <i class="fa-solid fa-users w-[20px]"></i>
                        span Ứng viên

                    a(href="/" + adminPath + "/logs" class="flex items-center gap-[12px] px-[16px] py-[12px] rounded-[6px] text-[15px] font-[500] hover:bg-white/10 transition-colors " + (currentPath.startsWith("/" + adminPath + "/logs") ? "bg-[#0088FF] text-white font-[600]" : "text-white/80"))
                        <i class="fa-solid fa-clock-rotate-left w-[20px]"></i>
                        span Nhật ký hệ thống

                    a(href="/" + adminPath + "/feedbacks" class="flex items-center gap-[12px] px-[16px] py-[12px] rounded-[6px] text-[15px] font-[500] hover:bg-white/10 transition-colors " + (currentPath.startsWith("/" + adminPath + "/feedbacks") ? "bg-[#0088FF] text-white font-[600]" : "text-white/80"))
                        <i class="fa-solid fa-headset w-[20px]"></i>
                        span Sự cố & Đánh giá web

                    a(href="/" + adminPath + "/articles" class="flex items-center gap-[12px] px-[16px] py-[12px] rounded-[6px] text-[15px] font-[500] hover:bg-white/10 transition-colors " + (currentPath.startsWith("/" + adminPath + "/articles") ? "bg-[#0088FF] text-white font-[600]" : "text-white/80"))
                        <i class="fa-solid fa-newspaper w-[20px]"></i>
                        span Cẩm nang IT

                    div(class="pt-[16px] mt-[16px] border-t border-white/10")
                        a(href="/" target="_blank" class="flex items-center gap-[12px] px-[16px] py-[12px] rounded-[6px] text-[14px] text-white/70 hover:bg-white/10 transition-colors")
                            <i class="fa-solid fa-arrow-up-right-from-square w-[20px]"></i>
                            span Xem trang công khai

            div(class="pt-[20px] border-t border-white/10 mt-[24px]")
                if currentAdmin
                    div(class="mb-[16px] px-[8px]")
                        div(class="text-[14px] font-[600] truncate") #{currentAdmin.fullName}
                        div(class="text-[12px] text-white/60 capitalize flex items-center gap-[6px] mt-[2px]")
                            span(class="w-[8px] h-[8px] rounded-full bg-emerald-400 inline-block")
                            span #{currentAdmin.role === 'superadmin' ? 'Super Administrator' : 'Administrator'}

                form(action="/" + adminPath + "/logout" method="POST")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    button(type="submit" class="w-full flex items-center gap-[10px] px-[16px] py-[10px] rounded-[6px] text-[14px] font-[500] bg-white/10 hover:bg-red-600/80 text-white transition-colors cursor-pointer")
                        <i class="fa-solid fa-right-from-bracket"></i>
                        span Đăng xuất

        //- Main Content
        div(class="flex-1 flex flex-col min-w-0")
            //- Header
            header(class="bg-white border-b border-[#E5E7EB] px-[24px] py-[16px] flex items-center justify-between")
                div(class="flex items-center gap-[16px]")
                    button(id="sidebarToggleBtn" class="lg:hidden text-[#4B5563] text-[20px] cursor-pointer")
                        <i class="fa-solid fa-bars"></i>
                    div(class="font-[600] text-[18px] text-[#111827]") Hệ thống Quản trị VN.ITJobs

                div(class="flex items-center gap-[16px]")
                    if currentAdmin
                        span(class="text-[13px] bg-blue-50 text-blue-700 font-[500] px-[10px] py-[4px] rounded-full border border-blue-200")
                            <i class="fa-solid fa-shield-halved mr-[4px]"></i> #{currentAdmin.email}

            //- Body Content
            main(class="p-[20px] lg:p-[32px] flex-1")
                if flash && flash.success
                    div(class="mb-[24px] p-[16px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[8px] text-[15px] flex items-center justify-between")
                        div(class="flex items-center gap-[10px]")
                            <i class="fa-solid fa-circle-check text-[18px]"></i>
                            span #{flash.success}
                if flash && flash.error
                    div(class="mb-[24px] p-[16px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[8px] text-[15px] flex items-center justify-between")
                        div(class="flex items-center gap-[10px]")
                            <i class="fa-solid fa-circle-exclamation text-[18px]"></i>
                            span #{flash.error}

                block main

        //- ========================================================
        //- MODAL 1: AI BÁO CÁO XU HƯỚNG THỊ TRƯỜNG IT (MARKET INSIGHTS)
        //- ========================================================
        div(id="modalAiMarketInsights" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px]")
            div(class="bg-white rounded-[12px] shadow-2xl max-w-[760px] w-full max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn")
                div(class="p-[20px] border-b border-[#E5E7EB] flex items-center justify-between bg-gradient-to-r from-blue-50 to-indigo-50")
                    div(class="flex items-center gap-[10px]")
                        div(class="w-[38px] h-[38px] rounded-full bg-[#000065] text-white flex items-center justify-center")
                            <i class="fa-solid fa-chart-line text-[#0088FF]"></i>
                        div
                            h3(class="font-[700] text-[18px] text-[#111827]") Báo Cáo Xu Hướng Thị Trường Tuyển Dụng IT
                            p(class="text-[12px] text-[#6B7280]") Báo cáo tự động tổng hợp từ dữ liệu thực tế trên sàn VN.ITJobs
                    button(type="button" id="btnCloseAiMarketInsights" class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                        <i class="fa-solid fa-xmark"></i>

                div(class="p-[24px] overflow-y-auto flex-1 space-y-[20px]")
                    div(id="aiMarketLoading" class="py-[40px] text-center space-y-[12px]")
                        div(class="inline-block animate-spin text-[#0088FF] text-[36px]")
                            <i class="fa-solid fa-circle-notch"></i>
                        p(class="font-[600] text-[16px] text-gray-800") 🤖 AI đang phân tích dữ liệu thị trường và tổng hợp xu hướng...
                        p(class="text-[13px] text-gray-500 max-w-[360px] mx-auto") Đang tổng hợp phân tích từ toàn bộ tin tuyển dụng, nhà tuyển dụng và kỹ năng hot.

                    div(id="aiMarketContent" class="hidden space-y-[20px]")
                        div(class="bg-blue-50/60 p-[16px] rounded-[8px] border border-blue-200")
                            h4(class="text-[13px] font-[700] text-[#000065] mb-[8px] flex items-center gap-[6px]")
                                <i class="fa-solid fa-fire text-amber-500"></i>
                                span Top Kỹ Năng "Săn Đón" Nhất Hiện Tại
                            div(id="aiMarketHotSkills" class="flex flex-wrap gap-[6px]")

                        div(class="bg-white p-[16px] rounded-[8px] border border-gray-200")
                            h4(class="text-[14px] font-[700] text-gray-900 mb-[6px] flex items-center gap-[6px]")
                                <i class="fa-solid fa-money-bill-trend-up text-emerald-600"></i>
                                span Xu hướng Mức Lương IT
                            p(id="aiMarketSalary" class="text-[14px] text-gray-700 leading-relaxed")

                        div(class="bg-white p-[16px] rounded-[8px] border border-gray-200")
                            h4(class="text-[14px] font-[700] text-gray-900 mb-[6px] flex items-center gap-[6px]")
                                <i class="fa-solid fa-chart-pie text-blue-600"></i>
                                span Đánh giá Nhu Cầu Tuyển Dụng Theo Mảng Công Nghệ
                            p(id="aiMarketDemand" class="text-[14px] text-gray-700 leading-relaxed")

                        div(class="bg-amber-50/70 p-[16px] rounded-[8px] border border-amber-200")
                            h4(class="text-[14px] font-[700] text-amber-900 mb-[6px] flex items-center gap-[6px]")
                                <i class="fa-solid fa-lightbulb text-amber-600"></i>
                                span Khuyến Nghị Chiến Lược Cho Quản Trị Viên & Doanh Nghiệp
                            p(id="aiMarketAdvice" class="text-[14px] text-amber-950 leading-relaxed")

        script(src="/assets/js/ai-features.js?v=3.0")
        script.
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const closeBtn = document.getElementById('sidebarCloseBtn');
            const sidebar = document.getElementById('adminSidebar');
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', () => {
                    sidebar.classList.toggle('hidden');
                });
            }
            if (closeBtn && sidebar) {
                closeBtn.addEventListener('click', () => {
                    sidebar.classList.add('hidden');
                });
            }
