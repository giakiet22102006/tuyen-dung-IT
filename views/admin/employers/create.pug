extends ../../layouts/admin.pug

block title
    title Thêm mới Nhà tuyển dụng - VN.ITJobs Admin

block main
    div(class="max-w-[800px] mx-auto space-y-[24px]")
        div(class="flex items-center gap-[10px]")
            a(href="/" + adminPath + "/employers" class="text-[#0088FF] hover:underline text-[14px]")
                <i class="fa-solid fa-arrow-left mr-[4px]"></i> Danh sách NTD
            span(class="text-gray-400") /
            span(class="font-[600] text-[#111827] text-[14px]") Thêm mới

        div(class="bg-white p-[28px] rounded-[10px] border border-[#E5E7EB] shadow-xs")
            h1(class="font-[700] text-[20px] text-[#111827] mb-[20px]") Thêm mới Nhà tuyển dụng thủ công

            form(action="/" + adminPath + "/employers/create" method="POST" class="space-y-[18px]")
                input(type="hidden" name="_csrf" value=csrfToken)

                div
                    label(for="companyName" class="block text-[14px] font-[500] text-[#374151] mb-[6px]") Tên công ty *
                    input(type="text" id="companyName" name="companyName" value=(old && old.companyName || "") required class="w-full border border-[#D1D5DB] rounded-[6px] px-[16px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                    if errors && errors.companyName
                        p(class="text-red-500 text-[12px] mt-[4px]") #{errors.companyName}

                div
                    label(for="email" class="block text-[14px] font-[500] text-[#374151] mb-[6px]") Email đăng nhập *
                    input(type="email" id="email" name="email" value=(old && old.email || "") required class="w-full border border-[#D1D5DB] rounded-[6px] px-[16px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                    if errors && errors.email
                        p(class="text-red-500 text-[12px] mt-[4px]") #{errors.email}

                div(class="grid grid-cols-1 sm:grid-cols-2 gap-[16px]")
                    div
                        label(for="city" class="block text-[14px] font-[500] text-[#374151] mb-[6px]") Thành phố *
                        select(id="city" name="city" class="w-full border border-[#D1D5DB] rounded-[6px] px-[16px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF] cursor-pointer")
                            each c in cities
                                option(value=c.value selected=(old && old.city === c.value)) #{c.label}
                    div
                        label(for="phone" class="block text-[14px] font-[500] text-[#374151] mb-[6px]") Số điện thoại liên hệ
                        input(type="text" id="phone" name="phone" value=(old && old.phone || "") class="w-full border border-[#D1D5DB] rounded-[6px] px-[16px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")

                div
                    label(for="address" class="block text-[14px] font-[500] text-[#374151] mb-[6px]") Địa chỉ trụ sở / văn phòng
                    input(type="text" id="address" name="address" value=(old && old.address || "") placeholder="Ví dụ: Tầng 12 Keangnam Landmark 72..." class="w-full border border-[#D1D5DB] rounded-[6px] px-[16px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")

                div(class="grid grid-cols-1 sm:grid-cols-2 gap-[16px]")
                    div
                        label(for="companyModel" class="block text-[14px] font-[500] text-[#374151] mb-[6px]") Mô hình công ty
                        input(type="text" id="companyModel" name="companyModel" value=(old && old.companyModel || "") placeholder="Product / Outsourcing" class="w-full border border-[#D1D5DB] rounded-[6px] px-[16px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                    div
                        label(for="status" class="block text-[14px] font-[500] text-[#374151] mb-[6px]") Trạng thái khởi tạo
                        select(id="status" name="status" class="w-full border border-[#D1D5DB] rounded-[6px] px-[16px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF] cursor-pointer")
                            option(value="active" selected) Hoạt động ngay
                            option(value="pending") Chờ duyệt

                div(class="pt-[12px] flex items-center justify-end gap-[12px]")
                    a(href="/" + adminPath + "/employers" class="px-[18px] py-[10px] border border-[#D1D5DB] rounded-[6px] text-[14px] font-[500] text-[#4B5563] hover:bg-gray-50") Hủy
                    button(type="submit" class="bg-[#0088FF] hover:bg-[#0070D2] text-white px-[22px] py-[10px] rounded-[6px] font-[600] text-[14px] transition-colors cursor-pointer") Tạo tài khoản
