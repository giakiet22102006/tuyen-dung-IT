extends ../../layouts/admin.pug

block title
    title Chi tiết: #{employer.companyName} - VN.ITJobs Admin

block main
    div(class="space-y-[24px]")
        //- Breadcrumb & Actions
        div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-[16px]")
            div(class="flex items-center gap-[10px]")
                a(href="/" + adminPath + "/employers" class="text-[#0088FF] hover:underline text-[14px]")
                    <i class="fa-solid fa-arrow-left mr-[4px]"></i> Danh sách NTD
                span(class="text-gray-400") /
                span(class="font-[600] text-[#111827] text-[14px]") #{employer.companyName}

            div(class="flex items-center gap-[8px] flex-wrap")
                a(href="/" + adminPath + "/employers/" + employer._id + "/edit" class="bg-amber-500 hover:bg-amber-600 text-white px-[14px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px]")
                    <i class="fa-solid fa-pen-to-square"></i>
                    span Sửa thông tin

                form(action="/" + adminPath + "/employers/" + employer._id + "/reset-password" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn đặt lại mật khẩu ngẫu nhiên cho Nhà tuyển dụng này?');" class="inline")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    button(type="submit" class="bg-gray-700 hover:bg-gray-800 text-white px-[14px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px] cursor-pointer")
                        <i class="fa-solid fa-key"></i>
                        span Đặt lại MK

                if employer.status === 'pending'
                    form(action="/" + adminPath + "/employers/" + employer._id + "/approve" method="POST" class="inline")
                        input(type="hidden" name="_csrf" value=csrfToken)
                        button(type="submit" class="bg-[#059669] hover:bg-[#047857] text-white px-[16px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px] cursor-pointer")
                            <i class="fa-solid fa-check"></i>
                            span Phê duyệt

                if employer.status === 'active'
                    button(type="button" onclick="document.getElementById('banModal').classList.remove('hidden')" class="bg-[#DC2626] hover:bg-[#B91C1C] text-white px-[14px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px] cursor-pointer")
                        <i class="fa-solid fa-ban"></i>
                        span Khóa tài khoản

                if employer.status === 'banned'
                    form(action="/" + adminPath + "/employers/" + employer._id + "/unban" method="POST" class="inline")
                        input(type="hidden" name="_csrf" value=csrfToken)
                        button(type="submit" class="bg-[#059669] hover:bg-[#047857] text-white px-[14px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px] cursor-pointer")
                            <i class="fa-solid fa-unlock"></i>
                            span Mở khóa

                if !employer.deletedAt
                    form(action="/" + adminPath + "/employers/" + employer._id + "/delete" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa mềm Nhà tuyển dụng này không?');" class="inline")
                        input(type="hidden" name="_csrf" value=csrfToken)
                        button(type="submit" class="bg-gray-600 hover:bg-gray-700 text-white px-[14px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px] cursor-pointer")
                            <i class="fa-solid fa-trash"></i>
                            span Xóa mềm
                else
                    form(action="/" + adminPath + "/employers/" + employer._id + "/restore" method="POST" class="inline")
                        input(type="hidden" name="_csrf" value=csrfToken)
                        button(type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-[14px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px] cursor-pointer")
                            <i class="fa-solid fa-rotate-left"></i>
                            span Khôi phục

                if currentAdmin && currentAdmin.role === 'superadmin'
                    form(action="/" + adminPath + "/employers/" + employer._id + "/hard-delete" method="POST" onsubmit="return confirm('CẢNH BÁO: Hành động này sẽ XÓA VĨNH VIỄN công ty cùng toàn bộ tin tuyển dụng và hồ sơ ứng tuyển liên quan. Không thể phục hồi! Bạn có chắc chắn không?');" class="inline")
                        input(type="hidden" name="_csrf" value=csrfToken)
                        button(type="submit" class="bg-red-800 hover:bg-red-900 text-white px-[14px] py-[8px] rounded-[6px] text-[13px] font-[600] flex items-center gap-[6px] cursor-pointer")
                            <i class="fa-solid fa-trash-can"></i>
                            span Xóa vĩnh viễn

        //- Thông tin công ty Card
        div(class="bg-white p-[24px] rounded-[10px] border border-[#E5E7EB] shadow-xs")
            div(class="flex flex-col sm:flex-row items-start sm:items-center gap-[20px] pb-[20px] border-b border-[#E5E7EB]")
                img(src=(employer.logo && employer.logo.url ? employer.logo.url : "/assets/images/demo/demo4.png") alt=employer.companyName class="w-[80px] h-[80px] object-contain rounded-[8px] border border-[#E5E7EB] p-[4px]")
                div(class="flex-1")
                    div(class="flex items-center gap-[12px] flex-wrap")
                        h2(class="font-[700] text-[22px] text-[#111827]") #{employer.companyName}
                        if employer.deletedAt
                            span(class="px-[10px] py-[2px] rounded-full text-[12px] font-[600] bg-gray-100 text-gray-700 border border-gray-300") Đã xóa mềm
                        else if employer.status === 'pending'
                            span(class="px-[10px] py-[2px] rounded-full text-[12px] font-[600] bg-amber-50 text-amber-700 border border-amber-300") Chờ duyệt
                        else if employer.status === 'active'
                            span(class="px-[10px] py-[2px] rounded-full text-[12px] font-[600] bg-emerald-50 text-emerald-700 border border-emerald-300") Hoạt động
                        else if employer.status === 'banned'
                            span(class="px-[10px] py-[2px] rounded-full text-[12px] font-[600] bg-red-50 text-red-700 border border-red-300") Đã khóa

                    p(class="text-[14px] text-[#6B7280] mt-[4px]")
                        <i class="fa-solid fa-location-dot mr-[4px]"></i> #{labels.getCityLabel(employer.city)} • #{employer.address || "Chưa cập nhật địa chỉ"}

            div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px] pt-[20px]")
                div
                    p(class="text-[13px] text-[#6B7280]") Email đăng nhập
                    p(class="font-[600] text-[15px] text-[#111827] mt-[2px]") #{employer.email}
                div
                    p(class="text-[13px] text-[#6B7280]") Số điện thoại
                    p(class="font-[600] text-[15px] text-[#111827] mt-[2px]") #{employer.phone || "Chưa có"}
                div
                    p(class="text-[13px] text-[#6B7280]") Tổng việc làm đã đăng
                    p(class="font-[600] text-[15px] text-[#0088FF] mt-[2px]") #{jobs ? jobs.length : 0} việc làm
                div
                    p(class="text-[13px] text-[#6B7280]") Tổng CV nhận được
                    p(class="font-[600] text-[15px] text-[#059669] mt-[2px]") #{applicationCount || 0} hồ sơ

            if employer.banReason
                div(class="mt-[20px] p-[12px] bg-red-50 border border-red-200 rounded-[6px] text-red-700 text-[14px]")
                    span(class="font-[600]") Lý do khóa tài khoản: 
                    span #{employer.banReason}

        //- Danh sách tin tuyển dụng của công ty
        div(class="bg-white rounded-[10px] border border-[#E5E7EB] shadow-xs overflow-hidden")
            div(class="p-[20px] border-b border-[#E5E7EB] flex items-center justify-between")
                h3(class="font-[700] text-[17px] text-[#111827]") Tin tuyển dụng của công ty (#{jobs ? jobs.length : 0})

            div(class="overflow-x-auto")
                table(class="w-full text-left border-collapse text-[14px]")
                    thead(class="bg-[#F9FAFB] text-[#4B5563] text-[12px] uppercase font-[600] border-b border-[#E5E7EB]")
                        tr
                            th(class="py-[12px] px-[20px]") Tiêu đề công việc
                            th(class="py-[12px] px-[20px]") Mức lương
                            th(class="py-[12px] px-[20px]") Cấp bậc
                            th(class="py-[12px] px-[20px]") Hiển thị
                            th(class="py-[12px] px-[20px] text-right") Thao tác duyệt bài
                    tbody(class="divide-y divide-[#E5E7EB]")
                        if jobs && jobs.length > 0
                            each job in jobs
                                tr(class="hover:bg-gray-50 transition-colors")
                                    td(class="py-[14px] px-[20px] font-[600] text-[#111827]")
                                        a(href="/jobs/" + job.slug target="_blank" class="hover:text-[#0088FF]") #{job.title}
                                    td(class="py-[14px] px-[20px] text-[#0088FF] font-[500]") #{formatSalary(job.salaryMin, job.salaryMax)}
                                    td(class="py-[14px] px-[20px] text-[#4B5563]") #{labels.getPositionLabel(job.position)}
                                    td(class="py-[14px] px-[20px]")
                                        if job.deletedAt
                                            span(class="px-[8px] py-[2px] rounded text-[12px] font-[600] bg-gray-100 text-gray-600") Đã xóa
                                        else if job.moderation === 'visible'
                                            span(class="px-[8px] py-[2px] rounded text-[12px] font-[600] bg-emerald-50 text-emerald-700") Công khai
                                        else
                                            span(class="px-[8px] py-[2px] rounded text-[12px] font-[600] bg-red-50 text-red-700") Đã ẩn
                                    td(class="py-[14px] px-[20px] text-right space-x-[6px]")
                                        button(type="button" onclick="window.scanJobWithAi('" + job._id + "')" class="px-[10px] py-[5px] bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 rounded text-[12px] font-[600] cursor-pointer")
                                            <i class="fa-solid fa-shield-halved mr-[4px]"></i> AI Quét
                                        form(action="/" + adminPath + "/jobs/" + job._id + "/moderation" method="POST" class="inline")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            if job.moderation === 'visible'
                                                button(type="submit" class="px-[12px] py-[5px] bg-amber-100 hover:bg-amber-200 text-amber-800 rounded text-[12px] font-[600] cursor-pointer") Ẩn bài
                                            else
                                                button(type="submit" class="px-[12px] py-[5px] bg-emerald-100 hover:bg-emerald-200 text-emerald-800 rounded text-[12px] font-[600] cursor-pointer") Hiện bài
                        else
                            tr
                                td(colspan="5" class="py-[24px] text-center text-[#6B7280]") Công ty chưa đăng tin tuyển dụng nào.

        //- Lịch sử thao tác Audit Logs của công ty này
        div(class="bg-white rounded-[10px] border border-[#E5E7EB] shadow-xs overflow-hidden")
            div(class="p-[20px] border-b border-[#E5E7EB]")
                h3(class="font-[700] text-[17px] text-[#111827]") Lịch sử can thiệp của Quản trị viên (Audit Logs)

            div(class="overflow-x-auto")
                table(class="w-full text-left border-collapse text-[13px]")
                    thead(class="bg-[#F9FAFB] text-[#4B5563] text-[12px] uppercase font-[600] border-b border-[#E5E7EB]")
                        tr
                            th(class="py-[10px] px-[20px]") Thời gian
                            th(class="py-[10px] px-[20px]") Admin thực hiện
                            th(class="py-[10px] px-[20px]") Hành động
                            th(class="py-[10px] px-[20px]") Chi tiết (Meta)
                    tbody(class="divide-y divide-[#E5E7EB]")
                        if auditLogs && auditLogs.length > 0
                            each log in auditLogs
                                tr
                                    td(class="py-[12px] px-[20px] text-[#6B7280]") #{formatDateTime(log.createdAt)}
                                    td(class="py-[12px] px-[20px] font-[500] text-[#111827]") #{log.adminId ? log.adminId.fullName : "Hệ thống"}
                                    td(class="py-[12px] px-[20px] font-[600] text-[#0088FF]") #{log.action}
                                    td(class="py-[12px] px-[20px] text-[#4B5563]") #{JSON.stringify(log.meta || {})}
                        else
                            tr
                                td(colspan="4" class="py-[20px] text-center text-[#6B7280]") Chưa có nhật ký thao tác nào đối với công ty này.

    //- Modal Nhập lý do khóa tài khoản
    div(id="banModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-[20px]")
        div(class="bg-white rounded-[10px] max-w-[480px] w-full p-[24px] shadow-lg")
            h3(class="font-[700] text-[18px] text-[#111827] mb-[12px]") Khóa tài khoản Nhà tuyển dụng
            p(class="text-[14px] text-[#6B7280] mb-[16px]") Vui lòng nhập lý do khóa tài khoản. Người dùng sẽ nhìn thấy lý do này khi cố gắng đăng nhập.
            form(action="/" + adminPath + "/employers/" + employer._id + "/ban" method="POST")
                input(type="hidden" name="_csrf" value=csrfToken)
                textarea(name="reason" required rows="3" placeholder="Ví dụ: Vi phạm điều khoản đăng tin tuyển dụng sai sự thật..." class="w-full border border-[#D1D5DB] rounded-[6px] p-[12px] text-[14px] focus:outline-none focus:border-[#0088FF] mb-[16px]")
                div(class="flex justify-end gap-[10px]")
                    button(type="button" onclick="document.getElementById('banModal').classList.add('hidden')" class="px-[16px] py-[8px] bg-gray-100 hover:bg-gray-200 text-[#374151] rounded text-[13px] font-[500] cursor-pointer") Hủy bỏ
                    button(type="submit" class="px-[16px] py-[8px] bg-[#DC2626] hover:bg-[#B91C1C] text-white rounded text-[13px] font-[600] cursor-pointer") Xác nhận khóa

    //- Modal AI Moderation Scan Result
    div(id="modalAiJobModeration" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px]")
        div(class="bg-white rounded-[12px] shadow-2xl max-w-[560px] w-full max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn")
            div(class="p-[20px] border-b border-[#E5E7EB] flex items-center justify-between bg-gradient-to-r from-indigo-50 to-purple-50")
                div(class="flex items-center gap-[10px]")
                    div(class="w-[36px] h-[36px] rounded-full bg-indigo-600 text-white flex items-center justify-center")
                        <i class="fa-solid fa-shield-halved"></i>
                    div
                        h3(class="font-[700] text-[17px] text-[#111827]") Kết Quả Quét An Toàn Tin Tuyển Dụng
                        p(class="text-[12px] text-[#6B7280]") Kiểm tra tự động bằng AI phát hiện gian lận & vi phạm
                button(type="button" id="btnCloseAiJobMod" class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                    <i class="fa-solid fa-xmark"></i>

            div(class="p-[24px] overflow-y-auto flex-1 space-y-[16px]")
                div(id="aiModLoading" class="py-[32px] text-center space-y-[10px]")
                    div(class="inline-block animate-spin text-indigo-600 text-[32px]")
                        <i class="fa-solid fa-circle-notch"></i>
                    p(class="font-[600] text-[15px] text-gray-800") 🤖 AI đang quét nội dung tin tuyển dụng...

                div(id="aiModContent" class="hidden space-y-[16px]")
                    div(class="flex items-center justify-between p-[16px] rounded-[8px] bg-gray-50 border border-gray-200")
                        div
                            p(class="text-[12px] font-[600] text-gray-500 uppercase") Mức độ an toàn
                            div(id="aiModRiskBadge" class="mt-[4px]")
                        div(class="text-right")
                            p(class="text-[12px] font-[600] text-gray-500 uppercase") Điểm tin cậy
                            span(id="aiModScore" class="text-2xl font-bold text-gray-900")

                    div
                        h4(class="text-[13px] font-[700] text-gray-800 mb-[6px]") Dấu hiệu cảnh báo phát hiện:
                        div(id="aiModFlags")

                    div
                        h4(class="text-[13px] font-[700] text-gray-800 mb-[6px]") Đánh giá chi tiết từ AI:
                        p(id="aiModAssessment" class="text-[14px] text-gray-700 leading-relaxed bg-gray-50 p-[12px] rounded-[6px] border border-gray-200")

    script.
        document.addEventListener("DOMContentLoaded", () => {
            if (window.initAiJobModeration) window.initAiJobModeration();
        });
