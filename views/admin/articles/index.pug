extends ../../layouts/admin.pug

block title
    title #{title || "Quản lý Cẩm Nang IT | Admin"}

block main
    div(class="space-y-[24px]")
        //- Tiêu đề & Nút thao tác
        div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-[16px]")
            div
                h1(class="text-[24px] font-[700] text-gray-900") Cẩm Nang IT & Quản Trị Bài Viết
                p(class="text-[14px] text-gray-500 mt-[4px]") Quản lý bài viết cẩm nang nghề nghiệp cho Ứng viên & Nhà tuyển dụng, tích hợp Trợ lý AI sáng tạo & trích xuất nguồn.
            div(class="flex items-center gap-[10px]")
                a(href=`/${adminPath}/articles/create` class="bg-[#0088FF] hover:bg-[#0077EE] text-white px-[18px] py-[10px] rounded-[8px] font-[600] text-[14px] flex items-center gap-[8px] shadow-sm transition")
                    <i class="fa-solid fa-plus"></i>
                    span Thêm Cẩm Nang Mới

        //- Bộ lọc & Tìm kiếm
        div(class="bg-white p-[18px] rounded-[10px] shadow-xs border border-gray-200")
            form(method="GET" action=`/${adminPath}/articles` class="grid grid-cols-1 md:grid-cols-4 gap-[14px]")
                //- Tìm kiếm từ khóa
                div
                    label(class="block text-[12px] font-[600] text-gray-600 mb-[4px]") Từ khóa tìm kiếm
                    div(class="relative")
                        input(type="text" name="search" value=filters.search placeholder="Tiêu đề, tóm tắt, tag, nguồn..." class="w-full pl-[36px] pr-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                        <i class="fa-solid fa-magnifying-glass absolute left-[12px] top-[11px] text-gray-400 text-[13px]"></i>

                //- Lọc Chuyên mục
                div
                    label(class="block text-[12px] font-[600] text-gray-600 mb-[4px]") Chuyên mục
                    select(name="category" class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[14px] bg-white focus:outline-none focus:border-[#0088FF]")
                        option(value="") -- Tất cả chuyên mục --
                        each catVal, catKey in categories
                            option(value=catVal selected=(filters.category === catVal)) #{categoryLabels[catVal]}

                //- Lọc Đối tượng
                div
                    label(class="block text-[12px] font-[600] text-gray-600 mb-[4px]") Đối tượng độc giả
                    select(name="audience" class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[14px] bg-white focus:outline-none focus:border-[#0088FF]")
                        option(value="") -- Tất cả đối tượng --
                        each audVal, audKey in audiences
                            option(value=audVal selected=(filters.audience === audVal)) #{audienceLabels[audVal]}

                //- Trạng thái & Nút lọc
                div(class="flex items-end gap-[8px]")
                    div(class="flex-1")
                        label(class="block text-[12px] font-[600] text-gray-600 mb-[4px]") Xuất bản
                        select(name="isPublished" class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[14px] bg-white focus:outline-none focus:border-[#0088FF]")
                            option(value="") -- Tất cả --
                            option(value="true" selected=(filters.isPublished === 'true')) Đã xuất bản
                            option(value="false" selected=(filters.isPublished === 'false')) Đang ẩn
                    button(type="submit" class="bg-gray-800 hover:bg-black text-white px-[16px] py-[8px] rounded-[6px] font-[600] text-[14px] flex items-center gap-[6px] transition")
                        <i class="fa-solid fa-filter"></i>
                        span Lọc
                    if filters.search || filters.category || filters.audience || filters.isPublished
                        a(href=`/${adminPath}/articles` class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-[12px] py-[8px] rounded-[6px] font-[500] text-[14px] transition flex items-center justify-center")
                            <i class="fa-solid fa-rotate-left"></i>

        //- Danh sách bài viết dạng bảng
        div(class="bg-white rounded-[10px] shadow-xs border border-gray-200 overflow-hidden")
            div(class="overflow-x-auto")
                table(class="w-full text-left border-collapse")
                    thead(class="bg-gray-50 border-b border-gray-200 text-[12px] uppercase tracking-wider text-gray-600 font-[700]")
                        tr
                            th(class="px-[16px] py-[12px]") Bài viết / Tiêu đề
                            th(class="px-[16px] py-[12px]") Chuyên mục
                            th(class="px-[16px] py-[12px]") Đối tượng
                            th(class="px-[16px] py-[12px]") Bản quyền / Nguồn
                            th(class="px-[16px] py-[12px]") Lượt xem
                            th(class="px-[16px] py-[12px] text-center") Xuất bản
                            th(class="px-[16px] py-[12px] text-right") Thao tác
                    tbody(class="divide-y divide-gray-100 text-[13px] text-gray-700")
                        if articles && articles.length > 0
                            each art in articles
                                tr(class="hover:bg-blue-50/30 transition")
                                    //- Cột Tiêu đề & Thumbnail
                                    td(class="px-[16px] py-[14px] max-w-[340px]")
                                        div(class="flex items-start gap-[12px]")
                                            img(src=art.thumbnail alt=art.title class="w-[50px] h-[50px] rounded-[6px] object-cover shrink-0 border border-gray-200")
                                            div(class="min-w-0")
                                                a(href=`/blog/${art.slug}` target="_blank" class="font-[600] text-gray-900 hover:text-[#0088FF] line-clamp-2 leading-snug transition") #{art.title}
                                                p(class="text-[12px] text-gray-400 mt-[2px]") Slug: #{art.slug}
                                                if art.tags && art.tags.length > 0
                                                    div(class="flex flex-wrap gap-[4px] mt-[4px]")
                                                        each tag in art.tags.slice(0, 2)
                                                            span(class="text-[10px] bg-gray-100 text-gray-500 px-[6px] py-[1px] rounded") ##{tag}

                                    //- Cột Chuyên mục
                                    td(class="px-[16px] py-[14px] whitespace-nowrap")
                                        span(class="inline-block px-[10px] py-[3px] rounded-full text-[11px] font-[600] bg-blue-50 text-blue-700 border border-blue-100")
                                            | #{categoryLabels[art.category] || art.category}

                                    //- Cột Đối tượng
                                    td(class="px-[16px] py-[14px] whitespace-nowrap")
                                        if art.targetAudience === 'candidate'
                                            span(class="inline-flex items-center gap-[4px] px-[8px] py-[2px] rounded text-[11px] font-[600] bg-emerald-50 text-emerald-700 border border-emerald-200")
                                                <i class="fa-solid fa-code text-[10px]"></i> Ứng viên IT
                                        else if art.targetAudience === 'employer'
                                            span(class="inline-flex items-center gap-[4px] px-[8px] py-[2px] rounded text-[11px] font-[600] bg-amber-50 text-amber-700 border border-amber-200")
                                                <i class="fa-solid fa-building text-[10px]"></i> Nhà tuyển dụng
                                        else
                                            span(class="inline-flex items-center gap-[4px] px-[8px] py-[2px] rounded text-[11px] font-[500] bg-purple-50 text-purple-700 border border-purple-200")
                                                <i class="fa-solid fa-users text-[10px]"></i> Tất cả

                                    //- Cột Nguồn gốc
                                    td(class="px-[16px] py-[14px] whitespace-nowrap")
                                        if art.isOriginal
                                            span(class="text-gray-500 flex items-center gap-[4px]")
                                                <i class="fa-solid fa-pen-nib text-blue-500"></i> Bài viết gốc
                                        else
                                            div
                                                span(class="inline-flex items-center gap-[4px] font-[600] text-indigo-700 bg-indigo-50 px-[8px] py-[2px] rounded text-[11px]")
                                                    <i class="fa-solid fa-link text-[10px]"></i> #{art.sourceName || "Trích nguồn"}
                                                if art.sourceUrl
                                                    div(class="mt-[2px]")
                                                        a(href=art.sourceUrl target="_blank" rel="noopener noreferrer" class="text-[11px] text-[#0088FF] hover:underline flex items-center gap-[2px]")
                                                            span Link gốc
                                                            <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>

                                    //- Cột Lượt xem
                                    td(class="px-[16px] py-[14px] whitespace-nowrap text-gray-600 font-[500]")
                                        <i class="fa-regular fa-eye mr-[4px] text-gray-400"></i> #{art.views || 0}

                                    //- Cột Trạng thái xuất bản
                                    td(class="px-[16px] py-[14px] whitespace-nowrap text-center")
                                        form(action=`/${adminPath}/articles/${art._id}/toggle-publish` method="POST" class="inline-block")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            button(type="submit" class="cursor-pointer transition hover:opacity-80" title="Nhấn để đổi trạng thái")
                                                if art.isPublished
                                                    span(class="inline-flex items-center gap-[4px] px-[10px] py-[3px] rounded-full text-[11px] font-[700] bg-emerald-100 text-emerald-800")
                                                        <i class="fa-solid fa-circle-check text-[11px]"></i> Đã xuất bản
                                                else
                                                    span(class="inline-flex items-center gap-[4px] px-[10px] py-[3px] rounded-full text-[11px] font-[700] bg-gray-200 text-gray-700")
                                                        <i class="fa-solid fa-eye-slash text-[11px]"></i> Đang ẩn

                                    //- Cột Thao tác
                                    td(class="px-[16px] py-[14px] whitespace-nowrap text-right space-x-[6px]")
                                        a(href=`/blog/${art.slug}` target="_blank" class="p-[6px] text-gray-500 hover:text-[#0088FF] rounded transition" title="Xem bài viết trên web")
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                        a(href=`/${adminPath}/articles/${art._id}/edit` class="p-[6px] text-blue-600 hover:text-blue-800 rounded transition" title="Chỉnh sửa")
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        form(action=`/${adminPath}/articles/${art._id}/delete` method="POST" class="inline-block" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            button(type="submit" class="p-[6px] text-red-500 hover:text-red-700 rounded transition cursor-pointer" title="Xóa bài viết")
                                                <i class="fa-solid fa-trash-can"></i>
                        else
                            tr
                                td(colspan="7" class="text-center py-[40px] text-gray-400")
                                    <i class="fa-solid fa-newspaper text-[32px] mb-[10px] block text-gray-300"></i>
                                    span Không tìm thấy cẩm nang IT nào phù hợp với bộ lọc.

        //- Phân trang
        if pagination && pagination.totalPages > 1
            div(class="flex justify-between items-center text-[13px] text-gray-600 pt-[10px]")
                div Hiển thị trang #{pagination.currentPage} / #{pagination.totalPages} (Tổng số #{total} bài viết)
                div(class="flex items-center gap-[6px]")
                    if pagination.hasPrev
                        a(href=`/${adminPath}/articles?page=${pagination.prevPage}${filters.search ? '&search=' + encodeURIComponent(filters.search) : ''}${filters.category ? '&category=' + filters.category : ''}${filters.audience ? '&audience=' + filters.audience : ''}${filters.isPublished ? '&isPublished=' + filters.isPublished : ''}` class="px-[12px] py-[6px] rounded bg-white border border-gray-300 hover:bg-gray-100 transition") Trước
                    each pageNum in Array.from({length: pagination.totalPages}, (_, i) => i + 1)
                        if pageNum === pagination.currentPage
                            span(class="px-[12px] py-[6px] rounded bg-[#0088FF] text-white font-[700]") #{pageNum}
                        else if pageNum === 1 || pageNum === pagination.totalPages || Math.abs(pageNum - pagination.currentPage) <= 1
                            a(href=`/${adminPath}/articles?page=${pageNum}${filters.search ? '&search=' + encodeURIComponent(filters.search) : ''}${filters.category ? '&category=' + filters.category : ''}${filters.audience ? '&audience=' + filters.audience : ''}${filters.isPublished ? '&isPublished=' + filters.isPublished : ''}` class="px-[12px] py-[6px] rounded bg-white border border-gray-300 hover:bg-gray-100 transition") #{pageNum}
                    if pagination.hasNext
                        a(href=`/${adminPath}/articles?page=${pagination.nextPage}${filters.search ? '&search=' + encodeURIComponent(filters.search) : ''}${filters.category ? '&category=' + filters.category : ''}${filters.audience ? '&audience=' + filters.audience : ''}${filters.isPublished ? '&isPublished=' + filters.isPublished : ''}` class="px-[12px] py-[6px] rounded bg-white border border-gray-300 hover:bg-gray-100 transition") Sau
