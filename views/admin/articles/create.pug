extends ../../layouts/admin.pug

block title
    title #{title || "Thêm Cẩm Nang IT Mới | Admin"}

block main
    div(class="max-w-[1000px] mx-auto space-y-[24px]")
        //- Tiêu đề & Breadcrumb
        div(class="flex items-center justify-between")
            div
                div(class="flex items-center gap-[8px] text-[13px] text-gray-500 mb-[4px]")
                    a(href=`/${adminPath}/articles` class="hover:text-[#0088FF]") Cẩm Nang IT
                    span /
                    span(class="text-gray-800 font-[500]") Thêm bài viết mới
                h1(class="text-[24px] font-[700] text-gray-900") Thêm Cẩm Nang IT Mới
            a(href=`/${adminPath}/articles` class="text-gray-600 hover:text-gray-800 px-[14px] py-[8px] rounded-[6px] border border-gray-300 font-[500] text-[13px] transition")
                <i class="fa-solid fa-arrow-left mr-[6px]"></i> Quay lại danh sách

        //- ========================================================
        //- KHỐI TRỢ LÝ AI: SÁNG TẠO & TRÍCH XUẤT NGUỒN NGOÀI
        //- ========================================================
        div(class="bg-gradient-to-r from-blue-50/90 via-indigo-50/80 to-purple-50/90 rounded-[12px] p-[20px] border border-blue-200/80 shadow-xs")
            div(class="flex items-center justify-between mb-[16px]")
                div(class="flex items-center gap-[10px]")
                    div(class="w-[36px] h-[36px] rounded-lg bg-[#000065] text-white flex items-center justify-center")
                        <i class="fa-solid fa-wand-magic-sparkles text-[#0088FF]"></i>
                    div
                        h3(class="font-[700] text-[16px] text-[#000065]") Trợ Lý AI Gemini Hỗ Trợ Biên Tập Cẩm Nang
                        p(class="text-[12px] text-gray-600") Tự động sinh nội dung chuyên sâu hoặc trích xuất, biên tập từ nguồn internet chỉ với 1 cú click.

                //- Nút chuyển chế độ AI
                div(class="flex items-center bg-white/80 p-[4px] rounded-[8px] border border-blue-200 text-[12px] font-[600]")
                    button(type="button" id="tabAiCreateBtn" class="px-[12px] py-[5px] rounded-[6px] bg-[#0088FF] text-white transition cursor-pointer")
                        <i class="fa-solid fa-pen-nib mr-[4px]"></i> AI Viết Mới
                    button(type="button" id="tabAiCurateBtn" class="px-[12px] py-[5px] rounded-[6px] text-gray-600 hover:text-gray-900 transition cursor-pointer")
                        <i class="fa-solid fa-globe mr-[4px]"></i> AI Biên Tập Nguồn Ngoài

            //- Khung 1: AI Viết bài mới theo chủ đề
            div(id="panelAiCreate" class="space-y-[12px]")
                div(class="grid grid-cols-1 md:grid-cols-3 gap-[10px]")
                    div(class="md:col-span-2")
                        label(class="block text-[12px] font-[600] text-gray-700 mb-[4px]") Ý tưởng / Chủ đề bài viết cần viết
                        input(type="text" id="aiTopicInput" placeholder="Ví dụ: Bí quyết vượt qua vòng phỏng vấn Live Coding Golang Senior..." class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white focus:outline-none focus:border-[#0088FF]")
                    div
                        label(class="block text-[12px] font-[600] text-gray-700 mb-[4px]") Đối tượng độc giả
                        select(id="aiAudienceSelect" class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white focus:outline-none focus:border-[#0088FF]")
                            each audVal, audKey in audiences
                                option(value=audVal) #{audienceLabels[audVal]}
                div(class="flex items-center justify-between pt-[4px]")
                    p(class="text-[12px] text-gray-500 italic") AI sẽ tự động sinh Tiêu đề, Slug, Đoạn tóm tắt, Nội dung HTML chuẩn SEO, Tags và Thời gian đọc.
                    button(type="button" id="btnExecuteAiCreate" class="bg-[#000065] hover:bg-[#000085] text-white px-[16px] py-[8px] rounded-[6px] font-[600] text-[13px] flex items-center gap-[6px] transition cursor-pointer shrink-0 shadow-xs")
                        <i class="fa-solid fa-bolt text-yellow-400"></i>
                        span Tự Động Viết Bằng AI

            //- Khung 2: AI Biên tập từ nguồn ngoài (Content Curation)
            div(id="panelAiCurate" class="space-y-[12px] hidden")
                div(class="grid grid-cols-1 md:grid-cols-3 gap-[10px]")
                    div(class="md:col-span-2")
                        label(class="block text-[12px] font-[600] text-gray-700 mb-[4px]") Link bài viết gốc trên mạng (URL)
                        input(type="url" id="aiSourceUrlInput" placeholder="https://medium.com/... hoặc https://viblo.asia/..." class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white focus:outline-none focus:border-[#0088FF]")
                    div
                        label(class="block text-[12px] font-[600] text-gray-700 mb-[4px]") Đối tượng độc giả
                        select(id="aiCurateAudienceSelect" class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white focus:outline-none focus:border-[#0088FF]")
                            each audVal, audKey in audiences
                                option(value=audVal) #{audienceLabels[audVal]}

                div
                    label(class="block text-[12px] font-[600] text-gray-700 mb-[4px]") Hoặc dán nội dung thô / đoạn trích từ bài viết (tùy chọn)
                    textarea(id="aiRawContentInput" rows="3" placeholder="Dán văn bản bài viết gốc vào đây nếu link yêu cầu đăng nhập..." class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white focus:outline-none focus:border-[#0088FF]")

                div(class="flex items-center justify-between pt-[4px]")
                    p(class="text-[12px] text-gray-500 italic") AI sẽ trích xuất tên nguồn, tổng hợp lại bài viết mạch lạc tiếng Việt và tự động điền thông tin trích nguồn.
                    button(type="button" id="btnExecuteAiCurate" class="bg-indigo-700 hover:bg-indigo-800 text-white px-[16px] py-[8px] rounded-[6px] font-[600] text-[13px] flex items-center gap-[6px] transition cursor-pointer shrink-0 shadow-xs")
                        <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
                        span AI Trích Xuất & Biên Tập Lại

            //- Thông báo trạng thái đang chạy AI
            div(id="aiStatusAlert" class="hidden mt-[12px] p-[12px] bg-blue-100/90 text-blue-900 border border-blue-300 rounded-[6px] text-[13px] items-center gap-[8px]")
                <i class="fa-solid fa-circle-notch fa-spin text-[16px] text-[#0088FF]"></i>
                span(id="aiStatusText") Đang gọi Trợ lý Gemini AI soạn thảo nội dung... Vui lòng đợi trong giây lát!

        //- ========================================================
        //- FORM CHI TIẾT BÀI VIẾT CẨM NANG IT
        //- ========================================================
        div(class="bg-white rounded-[12px] p-[24px] sm:p-[32px] shadow-xs border border-gray-200")
            form(action=`/${adminPath}/articles/create` method="POST" id="articleForm" class="space-y-[20px]")
                input(type="hidden" name="_csrf" value=csrfToken)

                //- Tiêu đề & Slug
                div(class="grid grid-cols-1 md:grid-cols-3 gap-[16px]")
                    div(class="md:col-span-2")
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Tiêu đề cẩm nang <span class="text-red-500">*</span>
                        input(type="text" name="title" id="formTitle" required placeholder="Nhập tiêu đề cẩm nang..." class="w-full px-[14px] py-[10px] border border-gray-300 rounded-[8px] text-[15px] focus:outline-none focus:border-[#0088FF] font-[600]")
                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Đường dẫn tĩnh (Slug)
                        input(type="text" name="slug" id="formSlug" placeholder="tieu-de-cam-nang-it" class="w-full px-[14px] py-[10px] border border-gray-300 rounded-[8px] text-[14px] bg-gray-50 focus:outline-none focus:border-[#0088FF]")

                //- Chuyên mục & Đối tượng & Thời gian đọc
                div(class="grid grid-cols-1 md:grid-cols-3 gap-[16px]")
                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Chuyên mục <span class="text-red-500">*</span>
                        select(name="category" id="formCategory" class="w-full px-[12px] py-[10px] border border-gray-300 rounded-[8px] text-[14px] bg-white focus:outline-none focus:border-[#0088FF]")
                            each catVal, catKey in categories
                                option(value=catVal) #{categoryLabels[catVal]}
                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Đối tượng độc giả <span class="text-red-500">*</span>
                        select(name="targetAudience" id="formTargetAudience" class="w-full px-[12px] py-[10px] border border-gray-300 rounded-[8px] text-[14px] bg-white focus:outline-none focus:border-[#0088FF]")
                            each audVal, audKey in audiences
                                option(value=audVal) #{audienceLabels[audVal]}
                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Thời gian đọc (Phút)
                        input(type="number" name="readingTime" id="formReadingTime" value="5" min="1" max="60" class="w-full px-[12px] py-[10px] border border-gray-300 rounded-[8px] text-[14px] focus:outline-none focus:border-[#0088FF]")

                //- Thumbnail & Tags
                div(class="grid grid-cols-1 md:grid-cols-2 gap-[16px]")
                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Ảnh đại diện (Thumbnail URL)
                        input(type="text" name="thumbnail" id="formThumbnail" value="/assets/images/demo/demo1.png" class="w-full px-[14px] py-[10px] border border-gray-300 rounded-[8px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Tags từ khóa (Cách nhau bằng dấu phẩy)
                        input(type="text" name="tags" id="formTags" placeholder="ReactJS, NodeJS, Interview, Career" class="w-full px-[14px] py-[10px] border border-gray-300 rounded-[8px] text-[14px] focus:outline-none focus:border-[#0088FF]")

                //- ====================================================
                //- KHU VỰC THÔNG TIN NGUỒN GỐC (CONTENT CURATION)
                //- ====================================================
                div(class="p-[16px] rounded-[8px] border border-gray-200 bg-gray-50/60 space-y-[12px]")
                    div(class="flex items-center justify-between")
                        label(class="text-[13px] font-[700] text-gray-800 flex items-center gap-[6px]")
                            <i class="fa-solid fa-link text-[#0088FF]"></i>
                            span Thông tin bản quyền & Trích nguồn bài viết
                        div(class="flex items-center gap-[14px] text-[13px]")
                            label(class="flex items-center gap-[6px] cursor-pointer")
                                input(type="radio" name="isOriginal" id="radioOriginalTrue" value="true" checked class="text-[#0088FF]")
                                span Bài viết tự biên soạn (Gốc)
                            label(class="flex items-center gap-[6px] cursor-pointer")
                                input(type="radio" name="isOriginal" id="radioOriginalFalse" value="false" class="text-[#0088FF]")
                                span(class="font-[600] text-indigo-700") Trích nguồn từ internet

                    div(id="sourceFieldsGroup" class="grid grid-cols-1 md:grid-cols-3 gap-[12px] pt-[8px] border-t border-gray-200 hidden")
                        div
                            label(class="block text-[12px] font-[600] text-gray-600 mb-[4px]") Tên nguồn (Ví dụ: Medium, Viblo, TechCrunch)
                            input(type="text" name="sourceName" id="formSourceName" placeholder="Viblo / Medium..." class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white")
                        div
                            label(class="block text-[12px] font-[600] text-gray-600 mb-[4px]") Link bài viết gốc (URL)
                            input(type="url" name="sourceUrl" id="formSourceUrl" placeholder="https://..." class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white")
                        div
                            label(class="block text-[12px] font-[600] text-gray-600 mb-[4px]") Tác giả gốc (Nếu có)
                            input(type="text" name="originalAuthor" id="formOriginalAuthor" placeholder="Tên tác giả gốc..." class="w-full px-[12px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] bg-white")

                //- Tóm tắt (Summary)
                div
                    label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Tóm tắt bài viết (Lead summary) <span class="text-red-500">*</span>
                    textarea(name="summary" id="formSummary" required rows="3" placeholder="Đoạn văn ngắn 2-3 câu giới thiệu tổng quan cẩm nang..." class="w-full px-[14px] py-[10px] border border-gray-300 rounded-[8px] text-[14px] focus:outline-none focus:border-[#0088FF]")

                //- Nội dung chi tiết (HTML)
                div
                    div(class="flex items-center justify-between mb-[6px]")
                        label(class="text-[13px] font-[600] text-gray-700") Nội dung cẩm nang (Định dạng HTML) <span class="text-red-500">*</span>
                        span(class="text-[12px] text-gray-400") Hỗ trợ thẻ &lt;h2&gt;, &lt;h3&gt;, &lt;p&gt;, &lt;ul&gt;, &lt;li&gt;, &lt;code&gt;, &lt;blockquote&gt;
                    textarea(name="content" id="formContent" required rows="14" placeholder="<h2>1. Tiêu đề mục</h2><p>Nội dung bài viết...</p>" class="w-full p-[14px] font-mono text-[13px] border border-gray-300 rounded-[8px] focus:outline-none focus:border-[#0088FF] leading-relaxed")

                //- Trạng thái xuất bản
                div(class="flex items-center gap-[10px] pt-[8px]")
                    input(type="checkbox" name="isPublished" id="formIsPublished" checked class="w-[18px] h-[18px] text-[#0088FF] rounded cursor-pointer")
                    label(for="formIsPublished" class="text-[14px] font-[600] text-gray-800 cursor-pointer")
                        | Xuất bản cẩm nang ngay sau khi lưu

                //- Nút bấm Submit
                div(class="flex items-center justify-end gap-[12px] pt-[16px] border-t border-gray-200")
                    a(href=`/${adminPath}/articles` class="px-[20px] py-[10px] rounded-[8px] border border-gray-300 text-gray-700 font-[600] text-[14px] hover:bg-gray-100 transition") Hủy bỏ
                    button(type="submit" class="bg-[#0088FF] hover:bg-[#0077EE] text-white px-[24px] py-[10px] rounded-[8px] font-[700] text-[14px] shadow-sm transition flex items-center gap-[8px]")
                        <i class="fa-solid fa-floppy-disk"></i>
                        span Lưu Cẩm Nang

    script.
        document.addEventListener("DOMContentLoaded", function () {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content");

            // Chuyển đổi Tab AI
            const tabAiCreateBtn = document.getElementById("tabAiCreateBtn");
            const tabAiCurateBtn = document.getElementById("tabAiCurateBtn");
            const panelAiCreate = document.getElementById("panelAiCreate");
            const panelAiCurate = document.getElementById("panelAiCurate");
            const aiStatusAlert = document.getElementById("aiStatusAlert");
            const aiStatusText = document.getElementById("aiStatusText");

            tabAiCreateBtn.addEventListener("click", function () {
                tabAiCreateBtn.className = "px-[12px] py-[5px] rounded-[6px] bg-[#0088FF] text-white transition cursor-pointer";
                tabAiCurateBtn.className = "px-[12px] py-[5px] rounded-[6px] text-gray-600 hover:text-gray-900 transition cursor-pointer";
                panelAiCreate.classList.remove("hidden");
                panelAiCurate.classList.add("hidden");
            });

            tabAiCurateBtn.addEventListener("click", function () {
                tabAiCurateBtn.className = "px-[12px] py-[5px] rounded-[6px] bg-indigo-700 text-white transition cursor-pointer";
                tabAiCreateBtn.className = "px-[12px] py-[5px] rounded-[6px] text-gray-600 hover:text-gray-900 transition cursor-pointer";
                panelAiCurate.classList.remove("hidden");
                panelAiCreate.classList.add("hidden");
            });

            // Toggle hiển thị khu vực trích nguồn
            const radioOriginalTrue = document.getElementById("radioOriginalTrue");
            const radioOriginalFalse = document.getElementById("radioOriginalFalse");
            const sourceFieldsGroup = document.getElementById("sourceFieldsGroup");

            function toggleSourceFields() {
                if (radioOriginalFalse.checked) {
                    sourceFieldsGroup.classList.remove("hidden");
                } else {
                    sourceFieldsGroup.classList.add("hidden");
                }
            }

            radioOriginalTrue.addEventListener("change", toggleSourceFields);
            radioOriginalFalse.addEventListener("change", toggleSourceFields);

            // Điền dữ liệu vào form
            function populateForm(data) {
                if (data.title) document.getElementById("formTitle").value = data.title;
                if (data.slug) document.getElementById("formSlug").value = data.slug;
                if (data.category) document.getElementById("formCategory").value = data.category;
                if (data.targetAudience) document.getElementById("formTargetAudience").value = data.targetAudience;
                if (data.summary) document.getElementById("formSummary").value = data.summary;
                if (data.content) document.getElementById("formContent").value = data.content;
                if (data.readingTime) document.getElementById("formReadingTime").value = data.readingTime;
                if (data.tags && Array.isArray(data.tags)) {
                    document.getElementById("formTags").value = data.tags.join(", ");
                }

                if (data.isOriginal === false) {
                    radioOriginalFalse.checked = true;
                    toggleSourceFields();
                    if (data.sourceName) document.getElementById("formSourceName").value = data.sourceName;
                    if (data.sourceUrl) document.getElementById("formSourceUrl").value = data.sourceUrl;
                    if (data.originalAuthor) document.getElementById("formOriginalAuthor").value = data.originalAuthor;
                } else {
                    radioOriginalTrue.checked = true;
                    toggleSourceFields();
                }

                // Cuộn xuống form
                document.getElementById("formTitle").scrollIntoView({ behavior: "smooth" });
            }

            // Gọi AI Viết mới
            const btnExecuteAiCreate = document.getElementById("btnExecuteAiCreate");
            btnExecuteAiCreate.addEventListener("click", async function () {
                const topic = document.getElementById("aiTopicInput").value.trim();
                const targetAudience = document.getElementById("aiAudienceSelect").value;

                if (!topic) {
                    alert("Vui lòng nhập chủ đề / ý tưởng bài viết để AI soạn thảo.");
                    document.getElementById("aiTopicInput").focus();
                    return;
                }

                btnExecuteAiCreate.disabled = true;
                btnExecuteAiCreate.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang viết bài...';
                aiStatusAlert.classList.remove("hidden");
                aiStatusAlert.classList.add("flex");
                aiStatusText.textContent = "🤖 AI Gemini đang nghiên cứu chủ đề và soạn thảo cẩm nang IT... Vui lòng đợi trong giây lát!";

                try {
                    const res = await fetch(`/${adminPath}/articles/ai-generate`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "x-csrf-token": csrfToken,
                        },
                        body: JSON.stringify({ topic, targetAudience }),
                    });
                    const resData = await res.json();
                    if (resData.success && resData.data) {
                        populateForm(resData.data);
                        aiStatusText.textContent = "✅ Đã soạn thảo cẩm nang IT thành công! Vui lòng rà soát lại và bấm Lưu.";
                    } else {
                        alert(resData.message || "Lỗi khi gọi AI");
                        aiStatusAlert.classList.add("hidden");
                    }
                } catch (err) {
                    alert("Lỗi kết nối AI: " + err.message);
                    aiStatusAlert.classList.add("hidden");
                } finally {
                    btnExecuteAiCreate.disabled = false;
                    btnExecuteAiCreate.innerHTML = '<i class="fa-solid fa-bolt text-yellow-400"></i> Tự Động Viết Bằng AI';
                }
            });

            // Gọi AI Biên tập nguồn ngoài
            const btnExecuteAiCurate = document.getElementById("btnExecuteAiCurate");
            btnExecuteAiCurate.addEventListener("click", async function () {
                const sourceUrl = document.getElementById("aiSourceUrlInput").value.trim();
                const rawContent = document.getElementById("aiRawContentInput").value.trim();
                const targetAudience = document.getElementById("aiCurateAudienceSelect").value;

                if (!sourceUrl && !rawContent) {
                    alert("Vui lòng nhập link bài viết gốc hoặc dán nội dung thô cần biên tập.");
                    document.getElementById("aiSourceUrlInput").focus();
                    return;
                }

                btnExecuteAiCurate.disabled = true;
                btnExecuteAiCurate.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang trích xuất & biên tập...';
                aiStatusAlert.classList.remove("hidden");
                aiStatusAlert.classList.add("flex");
                aiStatusText.textContent = "🌐 AI Gemini đang phân tích nguồn bài viết và biên tập lại thành cẩm nang chuẩn mực...";

                try {
                    const res = await fetch(`/${adminPath}/articles/ai-curate`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "x-csrf-token": csrfToken,
                        },
                        body: JSON.stringify({ sourceUrl, rawContent, targetAudience }),
                    });
                    const resData = await res.json();
                    if (resData.success && resData.data) {
                        populateForm(resData.data);
                        aiStatusText.textContent = "✅ Đã trích xuất nguồn và biên tập thành công! Vui lòng rà soát lại và bấm Lưu.";
                    } else {
                        alert(resData.message || "Lỗi khi gọi AI trích nguồn");
                        aiStatusAlert.classList.add("hidden");
                    }
                } catch (err) {
                    alert("Lỗi kết nối AI: " + err.message);
                    aiStatusAlert.classList.add("hidden");
                } finally {
                    btnExecuteAiCurate.disabled = false;
                    btnExecuteAiCurate.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i> AI Trích Xuất & Biên Tập Lại';
                }
            });
        });
