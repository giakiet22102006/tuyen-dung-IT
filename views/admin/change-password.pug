extends ../layouts/admin.pug

block title
    title #{title || "Đổi mật khẩu Quản trị viên - VN.ITJobs Admin"}

block main
    div(class="max-w-[560px] mx-auto space-y-[24px]")
        div
            h1(class="font-[700] text-[24px] text-[#111827]") Đổi mật khẩu Quản trị viên
            p(class="text-[14px] text-[#6B7280] mt-[4px]") Cập nhật mật khẩu bảo mật cho tài khoản quản trị của bạn. Các phiên đăng nhập cũ trên thiết bị khác sẽ tự động bị hủy.

        div(class="bg-white p-[24px] sm:p-[30px] rounded-[12px] border border-[#E5E7EB] shadow-xs")
            form(action=`/${adminPath}/change-password` method="POST" class="space-y-[18px]")
                input(type="hidden" name="_csrf" value=csrfToken)

                div
                    label(for="currentPassword" class="block text-[14px] font-[600] text-[#374151] mb-[6px]") Mật khẩu hiện tại *
                    input(type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại..." class="w-full border border-[#D1D5DB] rounded-[8px] px-[14px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                    if errors && errors.currentPassword
                        p(class="text-[13px] text-[#DC2626] mt-[5px] font-[500]") #{errors.currentPassword}

                div
                    label(for="newPassword" class="block text-[14px] font-[600] text-[#374151] mb-[6px]") Mật khẩu mới * (Tối thiểu 8 ký tự, gồm chữ và số)
                    input(type="password" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password" placeholder="Nhập mật khẩu mới..." class="w-full border border-[#D1D5DB] rounded-[8px] px-[14px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                    if errors && errors.newPassword
                        p(class="text-[13px] text-[#DC2626] mt-[5px] font-[500]") #{errors.newPassword}

                div
                    label(for="confirmPassword" class="block text-[14px] font-[600] text-[#374151] mb-[6px]") Xác nhận mật khẩu mới *
                    input(type="password" id="confirmPassword" name="confirmPassword" required minlength="8" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới..." class="w-full border border-[#D1D5DB] rounded-[8px] px-[14px] py-[10px] text-[14px] focus:outline-none focus:border-[#0088FF]")
                    if errors && errors.confirmPassword
                        p(class="text-[13px] text-[#DC2626] mt-[5px] font-[500]") #{errors.confirmPassword}

                div(class="pt-[8px] flex items-center justify-end gap-[10px]")
                    a(href=`/${adminPath}` class="px-[16px] py-[10px] rounded-[8px] border border-[#D1D5DB] text-[#374151] text-[14px] font-[500] hover:bg-gray-50 transition") Hủy bỏ
                    button(type="submit" class="px-[22px] py-[10px] rounded-[8px] bg-[#000065] hover:bg-[#000080] text-white text-[14px] font-[600] transition cursor-pointer flex items-center gap-[8px]")
                        <i class="fa-solid fa-key text-[13px]"></i>
                        span Lưu mật khẩu mới
