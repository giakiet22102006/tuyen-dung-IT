extends ../layouts/default.pug

block title 
    title #{title || "Chi tiết CV (Nhà tuyển dụng)"}

block main
    //- Chi tiết CV
    div(class="py-[35px] sm:py-[60px]")
        .contain 
            div(class="")
                if flash && flash.success
                    div(class="mb-[20px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mb-[20px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}

                //- Thông tin CV
                div(class="border border-[#DEDEDE] rounded-[8px] p-[16px] sm:p-[20px] bg-white")
                    div(class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-[20px] gap-[10px]")
                        h1(class="font-[700] text-[18px] sm:text-[20px]") Thông tin CV
                        a(href="/employer/cvs" class="font-[500] text-[14px] text-[#0088FF] hover:underline") <i class="fa-solid fa-arrow-left mr-[4px]"></i> Quay lại danh sách

                    div(class="font-[400] text-[15px] sm:text-[16px]") Họ tên: <span class="font-[600]">#{application.fullName}</span> 
                    div(class="font-[400] text-[15px] sm:text-[16px] mt-[10px]") Email: <span class="font-[600]">#{application.email}</span> 
                    div(class="font-[400] text-[15px] sm:text-[16px] mt-[10px]") Số điện thoại: <span class="font-[600]">#{application.phone}</span> 
                    
                    div(class="font-[400] text-[15px] sm:text-[16px] mt-[10px]") Trạng thái hồ sơ: 
                        if application.status === 'pending'
                            span(class="font-[600] text-[#FFB200] ml-[6px]") <i class="fa-solid fa-clock mr-[2px]"></i> Chưa duyệt
                        else if application.status === 'approved'
                            span(class="font-[600] text-[#2E7D32] ml-[6px]") <i class="fa-solid fa-circle-check mr-[2px]"></i> Đã duyệt phù hợp
                        else if application.status === 'rejected'
                            span(class="font-[600] text-[#C62828] ml-[6px]") <i class="fa-solid fa-circle-xmark mr-[2px]"></i> Đã từ chối

                    //- Scorecard / Đánh giá ứng viên (1-5 sao)
                    div(class="flex items-center gap-[10px] mt-[12px] flex-wrap")
                        span(class="font-[400] text-[15px] sm:text-[16px] text-gray-700") Đánh giá nội bộ:
                        div(id="starRatingContainer" class="flex items-center gap-[4px] cursor-pointer text-[18px]" data-application-id=application._id data-current-rating=(application.rating || 0))
                            each star in [1, 2, 3, 4, 5]
                                <i class="fa-solid fa-star star-btn #{ (application.rating || 0) >= star ? 'text-amber-400' : 'text-gray-300' } hover:text-amber-400 transition-colors" data-value=star></i>
                        span(id="ratingText" class="text-[13px] font-[600] text-gray-500") #{application.rating ? (application.rating + '/5 sao') : 'Chưa chấm điểm'}

                    div(class="flex flex-wrap items-center gap-[10px] mt-[16px]")
                        form(action="/employer/cvs/" + application._id + "/status" method="POST" class="inline")
                            input(type="hidden" name="_csrf" value=csrfToken)
                            input(type="hidden" name="status" value="approved")
                            button(type="submit" class="bg-[#9FDB7C] hover:bg-[#8ccb6a] rounded-[6px] py-[8px] px-[20px] cursor-pointer font-[600] text-[13px] text-black shadow-xs") Duyệt phù hợp

                        button(type="button" id="btnOpenScheduleModal" class="inline-flex items-center gap-[6px] bg-[#2563EB] hover:bg-[#1D4ED8] text-white rounded-[6px] py-[8px] px-[18px] cursor-pointer font-[600] text-[13px] shadow-xs transition-colors")
                            <i class="fa-solid fa-calendar-plus text-[13px]"></i>
                            span Lên Lịch Phỏng Vấn (Google Calendar)

                        button(type="button" id="btnOpenInviteModal" class="inline-flex items-center gap-[6px] bg-[#000071] hover:bg-[#000055] text-white rounded-[6px] py-[8px] px-[18px] cursor-pointer font-[600] text-[13px] shadow-xs transition-colors")
                            <i class="fa-solid fa-envelope-open-text text-[13px]"></i>
                            span Gửi Thư Mời (Email)

                        button(type="button" id="btnOpenRejectModal" class="bg-[#FF5100] hover:bg-[#e64900] rounded-[6px] py-[8px] px-[20px] cursor-pointer font-[600] text-[13px] text-white shadow-xs inline-flex items-center gap-[6px]")
                            <i class="fa-solid fa-ban text-[12px]"></i>
                            span Từ chối hồ sơ

                    if application.status === 'rejected'
                        div(class="mt-[14px] p-[16px] bg-red-50/90 border border-red-200 rounded-[8px] flex items-start gap-[12px]")
                            div(class="text-red-600 text-[20px] mt-[2px]")
                                <i class="fa-solid fa-circle-xmark"></i>
                            div(class="flex-1 text-[13px] text-red-900")
                                div(class="font-[700] text-[15px] flex items-center justify-between flex-wrap gap-[6px]")
                                    span Đã từ chối hồ sơ ứng tuyển này
                                    if application.rejectedAt || application.reviewedAt
                                        span(class="text-[12px] font-[400] text-gray-500") Thời gian: #{formatDateTime(application.rejectedAt || application.reviewedAt)}
                                if application.rejectionReason
                                    div(class="mt-[6px] text-red-950 font-[600]") Lý do từ chối: <span class="font-[500] text-gray-800">#{application.rejectionReason}</span>
                                if application.rejectionNote
                                    div(class="mt-[8px] p-[10px] bg-white rounded-[6px] border border-red-100 text-gray-700 leading-relaxed whitespace-pre-line text-[13px]")
                                        div(class="text-[11px] font-[700] text-gray-400 uppercase tracking-wide mb-[4px]") Lời nhắn gửi ứng viên:
                                        span #{application.rejectionNote}
                                button(type="button" id="btnOpenRejectModalAgain" class="mt-[8px] text-[#0088FF] hover:underline font-[600] inline-block cursor-pointer") Cập nhật lại lý do từ chối →

                    if application.interviewInvitation && application.interviewInvitation.sentAt
                        div(class="mt-[14px] p-[14px] bg-emerald-50 border border-emerald-200 rounded-[8px] flex items-start gap-[12px]")
                            div(class="text-emerald-600 text-[18px] mt-[2px]")
                                <i class="fa-solid fa-circle-check"></i>
                            div(class="flex-1 text-[13px] text-emerald-900")
                                div(class="font-[700]") Đã gửi thư mời phỏng vấn đến ứng viên (#{application.email})
                                div(class="mt-[2px] text-emerald-700") Tiêu đề: <span class="font-[600]">#{application.interviewInvitation.subject}</span>
                                if application.interviewInvitation.interviewDate
                                    div(class="text-emerald-700") Thời gian hẹn: <span class="font-[600]">#{application.interviewInvitation.interviewDate}</span>
                                if application.interviewInvitation.location
                                    div(class="text-emerald-700") Hình thức / Địa điểm: <span class="font-[600]">#{application.interviewInvitation.location}</span>
                                button(type="button" id="btnOpenInviteModalAgain" class="mt-[6px] text-[#0088FF] hover:underline font-[600] inline-block cursor-pointer") Gửi lại / Cập nhật thư mời khác →

                    if application.interviewSchedule && application.interviewSchedule.scheduledAt
                        div(class="mt-[14px] p-[16px] bg-purple-50 border border-purple-200 rounded-[10px] flex items-start gap-[12px]")
                            div(class="text-purple-600 text-[20px] mt-[1px]")
                                <i class="fa-solid fa-calendar-check"></i>
                            div(class="flex-1 text-[13px] text-purple-900")
                                div(class="font-[700] text-[15px] flex items-center justify-between flex-wrap gap-[6px]")
                                    span Lịch Phỏng Vấn Chính Thức (Đồng bộ iCalendar .ics)
                                    if application.interviewSchedule.status === 'confirmed'
                                        span(class="bg-emerald-100 text-emerald-800 text-[11px] font-[700] px-[8px] py-[2px] rounded-full border border-emerald-300") ✓ Ứng viên đã xác nhận tham gia
                                    else if application.interviewSchedule.status === 'rescheduled'
                                        span(class="bg-amber-100 text-amber-800 text-[11px] font-[700] px-[8px] py-[2px] rounded-full border border-amber-300") ⚠️ Ứng viên đề xuất đổi lịch
                                    else
                                        span(class="bg-purple-100 text-purple-800 text-[11px] font-[700] px-[8px] py-[2px] rounded-full border border-purple-300") Đang chờ ứng viên xác nhận
                                
                                div(class="mt-[6px] space-y-[4px] text-gray-700")
                                    div ⏱️ <strong>Thời gian:</strong> #{formatDateTime(application.interviewSchedule.scheduledAt)} (#{application.interviewSchedule.durationMinutes} phút)
                                    div 📍 <strong>Hình thức:</strong> #{application.interviewSchedule.locationType === 'online' ? 'Trực tuyến (Online Meeting)' : 'Trực tiếp tại văn phòng'}
                                    if application.interviewSchedule.meetingLink
                                        div 🔗 <strong>Link phòng họp:</strong> <a href=application.interviewSchedule.meetingLink target="_blank" class="text-[#0088FF] underline font-[600]">#{application.interviewSchedule.meetingLink}</a>
                                    if application.interviewSchedule.locationAddress
                                        div 🏢 <strong>Địa chỉ:</strong> #{application.interviewSchedule.locationAddress}
                                    if application.interviewSchedule.interviewers
                                        div 👥 <strong>Người phỏng vấn:</strong> #{application.interviewSchedule.interviewers}
                                    if application.interviewSchedule.candidateResponse && application.interviewSchedule.candidateResponse.note
                                        div(class="mt-[8px] p-[8px] bg-white rounded border border-purple-200 text-purple-950")
                                            strong Phản hồi từ ứng viên: 
                                            | "#{application.interviewSchedule.candidateResponse.note}"
                                
                                button(type="button" onclick="document.getElementById('scheduleInterviewModal').classList.remove('hidden'); document.getElementById('scheduleInterviewModal').classList.add('flex');" class="mt-[8px] text-[#0088FF] hover:underline font-[600] inline-block cursor-pointer") Chỉnh sửa / Đổi lịch phỏng vấn khác →

                    //- Trợ lý AI Tuyển Dụng (CV Screening & Executive Summary)
                    div(class="mt-[24px] p-[20px] bg-gradient-to-r from-blue-50/70 via-indigo-50/50 to-white rounded-[10px] border border-blue-200")
                        div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-[12px] mb-[16px]")
                            div(class="flex items-center gap-[10px]")
                                div(class="w-[38px] h-[38px] rounded-full bg-[#0088FF] text-white flex items-center justify-center text-[18px]")
                                    <i class="fa-solid fa-brain"></i>
                                div
                                    h3(class="font-[700] text-[16px] text-gray-900") Trợ Lý AI: Sàng Lọc & Tóm Tắt CV Tự Động
                                    p(class="text-[12px] text-gray-500") Phân tích mức độ đáp ứng năng lực & tóm tắt nhanh cho nhà tuyển dụng
                            button(type="button" id="btnAiScreenCv" class="inline-flex items-center gap-[8px] bg-[#0088FF] hover:bg-[#0070D2] text-white font-[600] text-[14px] px-[16px] py-[10px] rounded-[6px] cursor-pointer shadow-xs transition-all shrink-0")
                                <i class="fa-solid fa-bolt"></i>
                                span ✨ Phân Tích Hồ Sơ Này

                        //- Trạng thái loading
                        div(id="aiScreenLoading" class="hidden py-[24px] text-center space-y-[10px]")
                            div(class="inline-block animate-spin text-[#0088FF] text-[28px]")
                                <i class="fa-solid fa-circle-notch"></i>
                            p(class="text-[14px] font-[500] text-gray-700") 🤖 AI đang đọc và phân tích file PDF của ứng viên...

                        //- Kết quả phân tích
                        div(id="aiScreenResultCard" class="hidden space-y-[16px] pt-[12px] border-t border-blue-200/80")
                            div(class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-[10px] bg-white p-[16px] rounded-[8px] border border-gray-200")
                                div
                                    div(class="flex items-center gap-[10px]")
                                        span(class="text-[13px] font-[700] text-gray-700") Đề xuất tuyển dụng:
                                        span(id="aiScreenRecommendation" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold")
                                    p(id="aiScreenSummary" class="text-[14px] text-gray-700 mt-[8px] leading-relaxed")
                                div(class="text-right shrink-0")
                                    span(id="aiScreenScore" class="text-3xl font-black text-emerald-600") 88%
                                    p(class="text-[11px] text-gray-500") Độ phù hợp

                            div(class="grid sm:grid-cols-2 grid-cols-1 gap-[14px]")
                                div(class="bg-white p-[14px] rounded-[8px] border border-gray-200")
                                    h4(class="text-[13px] font-[700] text-emerald-800 mb-[8px] flex items-center gap-[6px]")
                                        <i class="fa-solid fa-circle-check text-emerald-600"></i>
                                        span Điểm mạnh nổi bật (Strengths)
                                    ul(id="aiScreenStrengths" class="space-y-[6px]")
                                div(class="bg-white p-[14px] rounded-[8px] border border-gray-200")
                                    h4(class="text-[13px] font-[700] text-amber-800 mb-[8px] flex items-center gap-[6px]")
                                        <i class="fa-solid fa-circle-question text-amber-500"></i>
                                        span Điểm cần làm rõ khi phỏng vấn (Probes)
                                    ul(id="aiScreenConcerns" class="space-y-[6px]")

                    //- Ghi chú nội bộ dành riêng cho HR
                    div(class="mt-[20px] p-[18px] bg-gray-50/80 rounded-[10px] border border-gray-200")
                        div(class="flex items-center justify-between mb-[12px]")
                            div(class="font-[700] text-[15px] text-gray-900 flex items-center gap-[6px]")
                                <i class="fa-solid fa-lock text-amber-500"></i>
                                span Ghi Chú Tuyển Dụng Nội Bộ (Private Notes)
                            span(class="text-[11.5px] text-gray-400 font-[500]") Chỉ HR công ty thấy, ứng viên không thấy

                        //- Danh sách ghi chú đã lưu
                        if application.internalNotes && application.internalNotes.length > 0
                            div(class="space-y-[8px] mb-[14px]")
                                each note in application.internalNotes
                                    div(class="bg-white p-[12px] rounded-[8px] border border-gray-200 shadow-xs")
                                        div(class="flex items-center justify-between text-[11.5px] text-gray-400 mb-[4px]")
                                            span(class="font-[700] text-gray-700") #{note.author || 'HR Recruiter'}
                                            span #{formatDateTime(note.createdAt)}
                                        div(class="text-[13.5px] text-gray-800 leading-relaxed whitespace-pre-line") #{note.content}
                        else
                            div(class="text-[13px] text-gray-400 italic mb-[12px]") Chưa có ghi chú nội bộ nào cho ứng viên này.

                        //- Form thêm ghi chú
                        form(action=`/employer/cvs/${application._id}/notes` method="POST" class="flex gap-[10px] flex-col sm:flex-row items-stretch sm:items-end")
                            input(type="hidden" name="_csrf" value=csrfToken)
                            div(class="flex-1")
                                textarea(name="content" rows="2" required placeholder="Ghi chú đánh giá, mức deal lương kỳ vọng, nhận xét tech test..." class="w-full p-[10px] rounded-[6px] border border-gray-300 text-[13.5px] focus:outline-none focus:ring-2 focus:ring-[#0088FF] bg-white")
                            button(type="submit" class="bg-[#000065] hover:bg-[#000085] text-white px-[16px] py-[10px] rounded-[6px] font-[600] text-[13px] shrink-0 cursor-pointer transition") Lưu Ghi Chú

                    div(class="mt-[20px]")
                        div(class="font-[400] text-[16px] my-[10px] flex justify-between items-center")
                            span File CV:
                            a(href="/employer/cvs/" + application._id + "/pdf" target="_blank" class="text-[#0088FF] text-[14px] underline") Mở xem toàn màn hình <i class="fa-solid fa-arrow-up-right-from-square ml-[4px]"></i>
                        embed(src="/employer/cvs/" + application._id + "/pdf" type="application/pdf" class="bg-[#D9D9D9] w-full h-[736px] rounded-[4px]") 
                //- Hết Thông tin CV

                //- Thông tin công việc
                if application.jobId
                    div(class="border border-[#DEDEDE] rounded-[8px] p-[20px] mt-[20px]")
                        div(class="font-[700] text-[20px] mb-[20px]") Thông tin công việc
                        div(class="font-[400] text-[16px] mb-[10px]") Tên công việc: <span class="font-[600] text-[16px]">#{application.jobId.title}</span> 
                        div(class="font-[400] text-[16px] mb-[10px]") Mức lương: <span class="font-[600] text-[16px]">#{formatSalary(application.jobId.salaryMin, application.jobId.salaryMax)}</span> 
                        div(class="font-[400] text-[16px] mb-[10px]") Cấp bậc: <span class="font-[600] text-[16px]">#{labels.getPositionLabel(application.jobId.position)}</span> 
                        div(class="font-[400] text-[16px] mb-[10px]") Hình thức làm việc: <span class="font-[600] text-[16px]">#{labels.getWorkingFormLabel(application.jobId.workingForm)}</span> 
                        if application.jobId.skills && application.jobId.skills.length > 0
                            div(class="font-[400] text-[16px] mb-[10px]") Công nghệ: <span class="font-[600] text-[16px]">#{application.jobId.skills.map(s => s.name).join(', ')}</span> 
                        a(href="/jobs/" + application.jobId.slug target="_blank" class="font-[400] text-[14px] text-[#0088FF] underline") Xem chi tiết công việc 
                //- Hết Thông tin công việc

        //- ==========================================
        //- MODAL SOẠN THƯ MỜI PHỎNG VẤN
        //- ==========================================
        div(id="modalInterviewInvite" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px]")
            div(class="bg-white rounded-[12px] shadow-2xl max-w-[650px] w-full max-h-[92vh] flex flex-col overflow-hidden animate-fadeIn")
                div(class="p-[18px] border-b border-gray-200 flex items-center justify-between bg-gradient-to-r from-blue-50 to-indigo-50")
                    div(class="flex items-center gap-[10px]")
                        div(class="w-[36px] h-[36px] rounded-full bg-[#000071] text-white flex items-center justify-center text-[16px]")
                            <i class="fa-solid fa-envelope-open-text"></i>
                        div
                            h3(class="font-[700] text-[16px] text-gray-900") Soạn Thư Mời Phỏng Vấn (Gửi Gmail)
                            p(class="text-[12px] text-gray-500") Gửi trực tiếp đến hòm thư #{application.email}
                    button(type="button" id="btnCloseInviteModal" class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                        <i class="fa-solid fa-xmark"></i>

                form(action="/employer/cvs/" + application._id + "/invite" method="POST" id="formSendInterviewInvite" class="p-[20px] overflow-y-auto flex-1 space-y-[14px]")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    
                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Tiêu đề Email *
                        input(type="text" id="inviteSubject" name="subject" required value=(application.interviewInvitation && application.interviewInvitation.subject || `[VN.ITJobs] Thư Mời Phỏng Vấn Vị Trí ${application.jobId ? application.jobId.title : ""} - ${currentUser ? currentUser.companyName : ""}`) class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px]")

                    div(class="grid sm:grid-cols-2 grid-cols-1 gap-[12px]")
                        div
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Thời gian dự kiến
                            input(type="text" id="inviteDate" name="interviewDate" placeholder="VD: 09:30 Thứ Tư, 28/10/2026" value=(application.interviewInvitation && application.interviewInvitation.interviewDate || "") class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px]")
                        div
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Hình thức / Địa điểm
                            input(type="text" id="inviteLocation" name="location" placeholder="VD: Online qua Google Meet / Trực tiếp" value=(application.interviewInvitation && application.interviewInvitation.location || "") class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px]")

                    //- AI Quick Draft Bar
                    div(class="p-[12px] bg-purple-50 border border-purple-200 rounded-[8px] flex flex-col sm:flex-row sm:items-center justify-between gap-[10px]")
                        div(class="flex items-center gap-[8px]")
                            <i class="fa-solid fa-wand-magic-sparkles text-purple-600 text-[16px]"></i>
                            div
                                div(class="text-[13px] font-[700] text-purple-950") AI Hỗ Trợ Soạn Thảo Thư Mời
                                div(class="text-[11px] text-purple-700") Tự động sinh nội dung thư mời trang trọng, chuyên nghiệp
                        button(type="button" id="btnAiDraftInvite" class="inline-flex items-center justify-center gap-[6px] bg-purple-600 hover:bg-purple-700 text-white text-[12px] font-[700] px-[12px] py-[7px] rounded-[6px] cursor-pointer shrink-0 transition-colors shadow-xs")
                            span(id="aiDraftSpin" class="hidden") <i class="fa-solid fa-circle-notch animate-spin"></i>
                            span ✨ AI Soạn Thảo Nhanh

                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Nội dung thư mời *
                        textarea(id="inviteContent" name="content" rows="7" required placeholder="Nhập nội dung thư mời hoặc bấm nút 'AI Soạn Thảo Nhanh' ở trên..." class="w-full border border-gray-300 rounded-[6px] p-[12px] text-[13px] leading-relaxed")= (application.interviewInvitation && application.interviewInvitation.content || "")

                    div(class="text-[12px] text-gray-500 bg-gray-50 p-[10px] rounded-[6px] border border-gray-200")
                        div <strong>Lưu ý:</strong> Khi gửi, hệ thống sẽ gửi email trực tiếp tới <strong>#{application.email}</strong> với thông tin liên hệ và email phản hồi là tài khoản của bạn (<strong>#{currentUser ? currentUser.email : ""}</strong>).

                    div(class="pt-[10px] border-t border-gray-200 flex justify-end gap-[10px]")
                        button(type="button" id="btnCancelInviteModal" class="px-[16px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] font-[600] text-gray-700 hover:bg-gray-100 cursor-pointer") Hủy
                        button(type="submit" class="px-[20px] py-[8px] bg-[#0088FF] hover:bg-[#0070D2] rounded-[6px] text-[13px] font-[700] text-white cursor-pointer shadow-xs") <i class="fa-solid fa-paper-plane mr-[6px]"></i> Gửi Email Đến Ứng Viên

        //- ==========================================
        //- MODAL TỪ CHỐI HỒ SƠ ỨNG VIÊN
        //- ==========================================
        div(id="modalRejectCv" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px]")
            div(class="bg-white rounded-[12px] shadow-2xl max-w-[620px] w-full max-h-[92vh] flex flex-col overflow-hidden animate-fadeIn")
                div(class="p-[18px] border-b border-gray-200 flex items-center justify-between bg-gradient-to-r from-red-50 to-orange-50")
                    div(class="flex items-center gap-[10px]")
                        div(class="w-[36px] h-[36px] rounded-full bg-[#FF5100] text-white flex items-center justify-center text-[16px]")
                            <i class="fa-solid fa-user-xmark"></i>
                        div
                            h3(class="font-[700] text-[16px] text-gray-900") Từ Chối Hồ Sơ Ứng Tuyển
                            p(class="text-[12px] text-gray-500") Ứng viên: #{application.fullName} (#{application.email})
                    button(type="button" id="btnCloseRejectModal" class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                        <i class="fa-solid fa-xmark"></i>

                form(action="/employer/cvs/" + application._id + "/status" method="POST" id="formRejectCv" class="p-[20px] overflow-y-auto flex-1 space-y-[14px]")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    input(type="hidden" name="status" value="rejected")

                    div
                        label(class="block text-[13px] font-[700] text-gray-700 mb-[6px]") Gợi ý lý do từ chối nhanh:
                        div(class="flex flex-wrap gap-[6px]" id="rejectReasonChips")
                            button(type="button" data-reason="Chưa đáp ứng đủ số năm kinh nghiệm theo yêu cầu" class="chip-reason px-[10px] py-[5px] bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full text-[12px] cursor-pointer transition border border-gray-200") Chưa đủ năm kinh nghiệm
                            button(type="button" data-reason="Kỹ năng chuyên môn / Công nghệ chưa phù hợp với vị trí" class="chip-reason px-[10px] py-[5px] bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full text-[12px] cursor-pointer transition border border-gray-200") Kỹ năng chưa tương thích
                            button(type="button" data-reason="Đã tuyển đủ chỉ tiêu cho vị trí này trong đợt tuyển dụng" class="chip-reason px-[10px] py-[5px] bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full text-[12px] cursor-pointer transition border border-gray-200") Đã tuyển đủ chỉ tiêu
                            button(type="button" data-reason="Mức lương kỳ vọng hoặc hình thức làm việc chưa tương thích" class="chip-reason px-[10px] py-[5px] bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full text-[12px] cursor-pointer transition border border-gray-200") Lương / Thời gian
                            button(type="button" data-reason="Hồ sơ chưa đạt yêu cầu đánh giá đầu vào" class="chip-reason px-[10px] py-[5px] bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full text-[12px] cursor-pointer transition border border-gray-200") Chưa đạt bài test

                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Lý do từ chối chính *
                        input(type="text" id="rejectReason" name="rejectionReason" required value=(application.rejectionReason || "Chưa đáp ứng đủ số năm kinh nghiệm theo yêu cầu") placeholder="Nhập tóm tắt lý do từ chối..." class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px]")

                    div
                        div(class="flex items-center justify-between mb-[4px]")
                            label(class="block text-[13px] font-[600] text-gray-700") Lời nhắn gửi ứng viên (Tùy chọn)
                            button(type="button" id="btnAiDraftReject" class="inline-flex items-center gap-[4px] text-[12px] font-[600] text-[#0088FF] hover:underline cursor-pointer")
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                span ✨ AI Viết Lời Nhắn Lịch Sự
                                span(id="aiDraftRejectSpin" class="hidden animate-spin") <i class="fa-solid fa-spinner"></i>
                        textarea(id="rejectNote" name="rejectionNote" rows="5" placeholder="Soạn lời nhắn hoặc lý do chi tiết gửi ứng viên để giúp họ hiểu rõ và tiếp tục cải thiện..." class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[13px] leading-relaxed")= (application.rejectionNote || "")

                    div(class="p-[12px] bg-amber-50 border border-amber-200 rounded-[8px]")
                        label(class="flex items-center gap-[8px] cursor-pointer select-none text-[13px] text-amber-900 font-[500]")
                            input(type="checkbox" name="sendEmail" value="true" checked class="w-[16px] h-[16px] text-[#0088FF] rounded border-gray-300 cursor-pointer")
                            span Gửi email thông báo kết quả & lý do từ chối đến ứng viên (#{application.email})

                    div(class="pt-[10px] border-t border-gray-200 flex justify-end gap-[10px]")
                        button(type="button" id="btnCancelRejectModal" class="px-[16px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] font-[600] text-gray-700 hover:bg-gray-100 cursor-pointer") Hủy Bỏ
                        button(type="submit" class="px-[20px] py-[8px] bg-[#FF5100] hover:bg-[#e64900] rounded-[6px] text-[13px] font-[700] text-white cursor-pointer shadow-xs inline-flex items-center gap-[6px]")
                            <i class="fa-solid fa-circle-xmark"></i>
                            span Xác Nhận Từ Chối

        //- ==========================================
        //- MODAL LẬP LỊCH PHỎNG VẤN (GOOGLE CALENDAR SYNC .ICS)
        //- ==========================================
        div(id="scheduleInterviewModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px]")
            div(class="bg-white rounded-[14px] shadow-2xl max-w-[560px] w-full max-h-[92vh] flex flex-col overflow-hidden animate-fadeIn text-left")
                div(class="p-[18px] border-b border-gray-200 flex items-center justify-between bg-gradient-to-r from-blue-600 to-indigo-700 text-white")
                    div(class="flex items-center gap-[10px]")
                        div(class="w-[38px] h-[38px] rounded-full bg-white/20 flex items-center justify-center text-[18px]")
                            <i class="fa-solid fa-calendar-plus"></i>
                        div
                            h3(class="font-[700] text-[16px]") Lập Lịch Phỏng Vấn (Google Calendar .ics)
                            p(class="text-[12px] text-white/80") Tự động gửi file sự kiện đính kèm tới #{application.email}
                    button(type="button" id="btnCloseScheduleModal" class="text-white/80 hover:text-white text-[20px] p-[4px] cursor-pointer")
                        <i class="fa-solid fa-xmark"></i>

                form(action=`/employer/cvs/${application._id}/schedule` method="POST" id="formScheduleInterview" class="p-[20px] overflow-y-auto flex-1 space-y-[14px]")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    
                    div(class="grid sm:grid-cols-2 grid-cols-1 gap-[12px]")
                        div
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Ngày phỏng vấn *
                            input(type="date" name="scheduledDate" required id="schedDateInput" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px] focus:outline-none focus:ring-2 focus:ring-[#0088FF]")
                        div
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Giờ bắt đầu *
                            input(type="time" name="scheduledTime" required value="09:30" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px] focus:outline-none focus:ring-2 focus:ring-[#0088FF]")

                    div(class="grid sm:grid-cols-2 grid-cols-1 gap-[12px]")
                        div
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Thời lượng dự kiến
                            select(name="durationMinutes" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px] bg-white cursor-pointer")
                                option(value="30") 30 Phút
                                option(value="45") 45 Phút
                                option(value="60" selected) 60 Phút (1 Giờ)
                                option(value="90") 90 Phút
                        div
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Hình thức phỏng vấn
                            select(name="locationType" id="schedLocationType" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px] bg-white cursor-pointer")
                                option(value="online" selected) Trực tuyến (Online Meeting)
                                option(value="offline") Trực tiếp tại văn phòng

                    div(id="schedOnlineGroup")
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Link phòng họp (Google Meet / Zoom / Teams)
                        input(type="url" name="meetingLink" placeholder="https://meet.google.com/abc-defg-hij" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px] focus:outline-none focus:ring-2 focus:ring-[#0088FF]")

                    div(id="schedOfflineGroup" class="hidden")
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Địa chỉ văn phòng phỏng vấn
                        input(type="text" name="locationAddress" placeholder="Tầng 12, Tòa nhà Keangnam, Mễ Trì, Hà Nội" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px] focus:outline-none focus:ring-2 focus:ring-[#0088FF]")

                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Người / Hội đồng phỏng vấn
                        input(type="text" name="interviewers" placeholder="VD: Anh Tuấn (Tech Lead) & Chị Mai (HR)" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[14px] focus:outline-none focus:ring-2 focus:ring-[#0088FF]")

                    div
                        label(class="block text-[13px] font-[600] text-gray-700 mb-[4px]") Ghi chú chuẩn bị cho ứng viên
                        textarea(name="notes" rows="2" placeholder="VD: Vui lòng mang laptop và chuẩn bị sẵn sàng demo dự án nổi bật..." class="w-full border border-gray-300 rounded-[6px] p-[10px] text-[13px] focus:outline-none focus:ring-2 focus:ring-[#0088FF]")

                    div(class="p-[12px] bg-blue-50 border border-blue-200 rounded-[8px] text-[12px] text-blue-900 leading-relaxed")
                        <i class="fa-solid fa-circle-check text-blue-600 mr-[4px]"></i>
                        | Hệ thống sẽ tự động tạo file chuẩn <strong>.ics</strong> đính kèm email. Khi mở email, ứng viên và nhà tuyển dụng có thể bấm thêm trực tiếp vào Google Calendar hoặc Outlook.

                    div(class="pt-[10px] border-t border-gray-200 flex justify-end gap-[10px]")
                        button(type="button" id="btnCancelScheduleModal" class="px-[16px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] font-[600] text-gray-700 hover:bg-gray-100 cursor-pointer") Hủy
                        button(type="submit" class="px-[20px] py-[8px] bg-[#2563EB] hover:bg-[#1D4ED8] rounded-[6px] text-[13px] font-[700] text-white cursor-pointer shadow-xs inline-flex items-center gap-[6px]")
                            <i class="fa-solid fa-calendar-check"></i>
                            span Xác Nhận & Gửi Lịch

    script.
        (function() {
            function runInit() {
                if (window.initAiCvScreening) window.initAiCvScreening("#{application._id}");
                
                // 1. Quản lý Modal Lập Lịch Phỏng Vấn
                var modalSchedule = document.getElementById("scheduleInterviewModal");
                var btnOpenSchedule = document.getElementById("btnOpenScheduleModal");
                var btnCloseSchedule = document.getElementById("btnCloseScheduleModal");
                var btnCancelSchedule = document.getElementById("btnCancelScheduleModal");
                var schedLocationType = document.getElementById("schedLocationType");
                var schedOnlineGroup = document.getElementById("schedOnlineGroup");
                var schedOfflineGroup = document.getElementById("schedOfflineGroup");
                var schedDateInput = document.getElementById("schedDateInput");

                // Mặc định ngày mai
                if (schedDateInput && !schedDateInput.value) {
                    var tomorrow = new Date();
                    tomorrow.setDate(tomorrow.getDate() + 1);
                    schedDateInput.value = tomorrow.toISOString().split('T')[0];
                }

                function openScheduleModal() {
                    if (modalSchedule) {
                        modalSchedule.classList.remove("hidden");
                        modalSchedule.classList.add("flex");
                    }
                }
                function closeScheduleModal() {
                    if (modalSchedule) {
                        modalSchedule.classList.add("hidden");
                        modalSchedule.classList.remove("flex");
                    }
                }

                if (btnOpenSchedule) btnOpenSchedule.addEventListener("click", openScheduleModal);
                if (btnCloseSchedule) btnCloseSchedule.addEventListener("click", closeScheduleModal);
                if (btnCancelSchedule) btnCancelSchedule.addEventListener("click", closeScheduleModal);

                if (schedLocationType) {
                    schedLocationType.addEventListener("change", function() {
                        if (schedLocationType.value === "online") {
                            if (schedOnlineGroup) schedOnlineGroup.classList.remove("hidden");
                            if (schedOfflineGroup) schedOfflineGroup.classList.add("hidden");
                        } else {
                            if (schedOnlineGroup) schedOnlineGroup.classList.add("hidden");
                            if (schedOfflineGroup) schedOfflineGroup.classList.remove("hidden");
                        }
                    });
                }

                // 2. Chấm điểm sao đánh giá (Scorecard Rating)
                var starContainer = document.getElementById("starRatingContainer");
                var ratingText = document.getElementById("ratingText");
                if (starContainer) {
                    var stars = starContainer.querySelectorAll(".star-btn");
                    stars.forEach(function(s) {
                        s.addEventListener("click", async function() {
                            var val = parseInt(s.getAttribute("data-value"), 10);
                            var csrfMeta = document.querySelector('meta[name="csrf-token"]');
                            var csrfToken = csrfMeta ? csrfMeta.getAttribute("content") : "";

                            try {
                                var res = await fetch("/employer/cvs/#{application._id}/rating", {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                        "x-csrf-token": csrfToken
                                    },
                                    body: JSON.stringify({ rating: val })
                                });
                                var data = await res.json();
                                if (data.success) {
                                    stars.forEach(function(starEl) {
                                        var starVal = parseInt(starEl.getAttribute("data-value"), 10);
                                        if (starVal <= val) {
                                            starEl.classList.remove("text-gray-300");
                                            starEl.classList.add("text-amber-400");
                                        } else {
                                            starEl.classList.remove("text-amber-400");
                                            starEl.classList.add("text-gray-300");
                                        }
                                    });
                                    if (ratingText) ratingText.textContent = val + "/5 sao";
                                }
                            } catch(err) {
                                console.error(err);
                            }
                        });
                    });
                }
                
                // Quản lý Modal Thư Mời Phỏng Vấn
                var modal = document.getElementById("modalInterviewInvite");
                var btnOpen = document.getElementById("btnOpenInviteModal");
                var btnOpenAgain = document.getElementById("btnOpenInviteModalAgain");
                var btnClose = document.getElementById("btnCloseInviteModal");
                var btnCancel = document.getElementById("btnCancelInviteModal");
                var btnAiDraft = document.getElementById("btnAiDraftInvite");
                var aiSpin = document.getElementById("aiDraftSpin");
                var textareaContent = document.getElementById("inviteContent");
                var inputSubject = document.getElementById("inviteSubject");
                var inputDate = document.getElementById("inviteDate");
                var inputLocation = document.getElementById("inviteLocation");

                function openModal() {
                    if (modal) {
                        modal.classList.remove("hidden");
                        modal.classList.add("flex");
                    }
                }

                function closeModal() {
                    if (modal) {
                        modal.classList.add("hidden");
                        modal.classList.remove("flex");
                    }
                }

                if (btnOpen) btnOpen.addEventListener("click", openModal);
                if (btnOpenAgain) btnOpenAgain.addEventListener("click", openModal);
                if (btnClose) btnClose.addEventListener("click", closeModal);
                if (btnCancel) btnCancel.addEventListener("click", closeModal);

                if (btnAiDraft) {
                    btnAiDraft.addEventListener("click", async function() {
                        btnAiDraft.disabled = true;
                        if (aiSpin) aiSpin.classList.remove("hidden");

                        try {
                            var csrfMeta = document.querySelector('meta[name="csrf-token"]');
                            var csrfToken = csrfMeta ? csrfMeta.getAttribute("content") : "";
                            var res = await fetch("/employer/cvs/#{application._id}/ai-draft-invite", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    "x-csrf-token": csrfToken
                                },
                                body: JSON.stringify({
                                    interviewDate: inputDate ? inputDate.value : "",
                                    location: inputLocation ? inputLocation.value : ""
                                })
                            });
                            var data = await res.json();
                            if (data.success) {
                                if (data.subject && inputSubject) inputSubject.value = data.subject;
                                if (data.content && textareaContent) textareaContent.value = data.content;
                            } else {
                                alert(data.message || "Không thể tạo thư mời bằng AI");
                            }
                        } catch(e) {
                            console.error(e);
                            alert("Có lỗi xảy ra khi tạo thư mời bằng AI");
                        } finally {
                            btnAiDraft.disabled = false;
                            if (aiSpin) aiSpin.classList.add("hidden");
                        }
                    });
                }

                // Quản lý Modal Từ Chối CV
                var modalReject = document.getElementById("modalRejectCv");
                var btnOpenReject = document.getElementById("btnOpenRejectModal");
                var btnOpenRejectAgain = document.getElementById("btnOpenRejectModalAgain");
                var btnCloseReject = document.getElementById("btnCloseRejectModal");
                var btnCancelReject = document.getElementById("btnCancelRejectModal");
                var rejectReasonInput = document.getElementById("rejectReason");
                var rejectNoteTextarea = document.getElementById("rejectNote");
                var btnAiDraftReject = document.getElementById("btnAiDraftReject");
                var aiDraftRejectSpin = document.getElementById("aiDraftRejectSpin");
                var chipButtons = document.querySelectorAll("#rejectReasonChips .chip-reason");

                function openRejectModal() {
                    if (modalReject) {
                        modalReject.classList.remove("hidden");
                        modalReject.classList.add("flex");
                    }
                }

                function closeRejectModal() {
                    if (modalReject) {
                        modalReject.classList.add("hidden");
                        modalReject.classList.remove("flex");
                    }
                }

                if (btnOpenReject) btnOpenReject.addEventListener("click", openRejectModal);
                if (btnOpenRejectAgain) btnOpenRejectAgain.addEventListener("click", openRejectModal);
                if (btnCloseReject) btnCloseReject.addEventListener("click", closeRejectModal);
                if (btnCancelReject) btnCancelReject.addEventListener("click", closeRejectModal);

                // Click chọn chip lý do nhanh
                chipButtons.forEach(function(chip) {
                    chip.addEventListener("click", function() {
                        var val = chip.getAttribute("data-reason");
                        if (rejectReasonInput) rejectReasonInput.value = val;
                        // Đổi style active chip
                        chipButtons.forEach(function(c) {
                            c.classList.remove("bg-[#FF5100]", "text-white", "border-[#FF5100]");
                            c.classList.add("bg-gray-100", "text-gray-700", "border-gray-200");
                        });
                        chip.classList.remove("bg-gray-100", "text-gray-700", "border-gray-200");
                        chip.classList.add("bg-[#FF5100]", "text-white", "border-[#FF5100]");
                    });
                });

                // AI soạn lời nhắn từ chối lịch sự
                if (btnAiDraftReject) {
                    btnAiDraftReject.addEventListener("click", async function() {
                        btnAiDraftReject.disabled = true;
                        if (aiDraftRejectSpin) aiDraftRejectSpin.classList.remove("hidden");

                        try {
                            var csrfMeta = document.querySelector('meta[name="csrf-token"]');
                            var csrfToken = csrfMeta ? csrfMeta.getAttribute("content") : "";
                            var currentReason = rejectReasonInput ? rejectReasonInput.value : "";
                            var currentNote = rejectNoteTextarea ? rejectNoteTextarea.value : "";

                            var res = await fetch("/employer/cvs/#{application._id}/ai-draft-rejection", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    "x-csrf-token": csrfToken
                                },
                                body: JSON.stringify({
                                    reasonType: currentReason,
                                    customNote: currentNote
                                })
                            });
                            var data = await res.json();
                            if (data.success) {
                                if (data.reason && rejectReasonInput) rejectReasonInput.value = data.reason;
                                if (data.content && rejectNoteTextarea) rejectNoteTextarea.value = data.content;
                            } else {
                                alert(data.message || "Không thể tạo lời nhắn từ chối");
                            }
                        } catch(e) {
                            console.error(e);
                            alert("Có lỗi xảy ra khi tạo lời nhắn bằng AI");
                        } finally {
                            btnAiDraftReject.disabled = false;
                            if (aiDraftRejectSpin) aiDraftRejectSpin.classList.add("hidden");
                        }
                    });
                }
            }
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", runInit);
            } else {
                runInit();
            }
        })();
    //- Hết Chi tiết CV
