extends ../layouts/default.pug

block title 
    title #{title || "Quản lý CV đã gửi (Ứng viên)"}

block main
    //- Quản lý CV đã gửi
    div(class="py-[35px] sm:py-[60px]") 
        .contain 
            div(class="")
                h1(class="font-[700] text-[20px] sm:text-[28px] text-[#121212] mb-[20px]") Quản lý CV đã gửi

                if flash && flash.success
                    div(class="mb-[20px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mb-[20px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}

                div(class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-[20px]")
                    if applications && applications.length > 0
                        each app in applications
                            div(class="card-item p-[16px] sm:p-[20px] hover:shadow-md transition-shadow")
                                img(src="/assets/images/bg-card.png" class="inner-bg")
                                if app.jobId
                                    a(href="/jobs/" + app.jobId.slug class="font-[700] text-[17px] sm:text-[18px] text-[#121212] text-center line-clamp-[2] hover:text-[#0088FF]") #{app.jobId.title}
                                else
                                    div(class="font-[700] text-[17px] sm:text-[18px] text-[#121212] text-center line-clamp-[2]") Công việc đã ngừng hiển thị

                                div(class="mt-[10px] font-[400] text-[13px] sm:text-[14px] text-center truncate") Công ty: <span class="font-[700]">#{app.employerId ? app.employerId.companyName : "Công ty ẩn"}</span>
                                div(class="font-[600] text-[15px] sm:text-[16px] text-[#0088FF] text-center mt-[6px]") #{app.jobId ? formatSalary(app.jobId.salaryMin, app.jobId.salaryMax) : "Thương lượng"}
                                div(class="font-[400] text-[13px] sm:text-[14px] text-[#121212] text-center mt-[6px]") 
                                    <i class="fa-solid fa-user-tie text-[14px] mr-[4px]"></i> #{app.jobId ? labels.getPositionLabel(app.jobId.position) : "Khác"}
                                div(class="font-[400] text-[13px] sm:text-[14px] text-[#121212] text-center mt-[6px]") 
                                    <i class="fa-solid fa-briefcase text-[14px] mr-[4px]"></i> #{app.jobId ? labels.getWorkingFormLabel(app.jobId.workingForm) : "Khác"}
                                
                                div(class="font-[500] text-[13px] text-center mt-[6px]")
                                    if app.status === 'pending'
                                        span(class="text-[#FFB200]") <i class="fa-solid fa-clock mr-[4px]"></i> Chưa duyệt
                                    else if app.status === 'approved'
                                        span(class="text-[#2E7D32]") <i class="fa-solid fa-circle-check mr-[4px]"></i> Phù hợp
                                    else if app.status === 'rejected'
                                        span(class="text-[#C62828]") <i class="fa-solid fa-circle-xmark mr-[4px]"></i> Đã từ chối

                                if app.status === 'rejected'
                                    div(class="mt-[10px] p-[10px] bg-red-50/90 border border-red-200 rounded-[8px] text-left space-y-[4px]")
                                        div(class="text-[12px] font-[700] text-red-800 flex items-center justify-between")
                                            span(class="inline-flex items-center gap-[4px]")
                                                <i class="fa-solid fa-circle-xmark text-red-600"></i> Phản hồi từ Nhà tuyển dụng:
                                            if app.rejectedAt || app.reviewedAt
                                                span(class="text-[11px] font-[400] text-gray-500") #{formatDate(app.rejectedAt || app.reviewedAt)}
                                        div(class="text-[12px] text-red-950 font-[600]") Lý do: <span class="font-[500] text-gray-800">#{app.rejectionReason || "Chưa phù hợp với yêu cầu vị trí tại thời điểm này"}</span>
                                        if app.rejectionNote
                                            div(class="text-[12px] text-gray-700 bg-white/80 p-[8px] rounded-[4px] border border-red-100 leading-relaxed italic whitespace-pre-line mt-[4px]") "#{app.rejectionNote}"
                                            if app.rejectionNote.length > 80
                                                button(type="button" onclick=`var m=document.getElementById('modalRejection_${app._id}'); if(m){m.classList.remove('hidden');m.classList.add('flex');}` class="mt-[4px] text-[11px] text-[#0088FF] hover:underline font-[600] cursor-pointer inline-flex items-center gap-[4px]")
                                                    span Xem toàn bộ phản hồi
                                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>

                                if app.interviewSchedule && app.interviewSchedule.scheduledAt
                                    div(class="mt-[10px] p-[10px] bg-purple-50 border border-purple-200 rounded-[8px] text-left text-[12.5px] space-y-[4px]")
                                        div(class="font-[700] text-purple-900 flex items-center justify-between")
                                            span(class="flex items-center gap-[4px]")
                                                <i class="fa-solid fa-calendar-check text-purple-600"></i> Lịch Phỏng Vấn:
                                            if app.interviewSchedule.status === 'confirmed'
                                                span(class="text-[10px] bg-emerald-100 text-emerald-800 font-[700] px-[6px] py-[1px] rounded-full") ✓ Đã xác nhận
                                            else if app.interviewSchedule.status === 'rescheduled'
                                                span(class="text-[10px] bg-amber-100 text-amber-800 font-[700] px-[6px] py-[1px] rounded-full") Đã xin dời lịch
                                            else
                                                span(class="text-[10px] bg-purple-200 text-purple-800 font-[700] px-[6px] py-[1px] rounded-full") Cần xác nhận
                                        
                                        div(class="text-gray-700") ⏱️ <strong>Thời gian:</strong> #{formatDateTime(app.interviewSchedule.scheduledAt)} (#{app.interviewSchedule.durationMinutes}p)
                                        div(class="text-gray-700 truncate") 📍 <strong>Hình thức:</strong> #{app.interviewSchedule.locationType === 'online' ? 'Trực tuyến (Online)' : (app.interviewSchedule.locationAddress || 'Văn phòng')}
                                        if app.interviewSchedule.meetingLink
                                            div(class="text-gray-700 truncate") 🔗 <strong>Link họp:</strong> <a href=app.interviewSchedule.meetingLink target="_blank" class="text-[#0088FF] underline font-[600]">Mở phòng họp</a>

                                        if app.interviewSchedule.status === 'pending'
                                            div(class="flex items-center gap-[6px] pt-[6px] border-t border-purple-200/80")
                                                form(action=`/candidate/applied-jobs/${app._id}/respond-interview` method="POST" class="flex-1")
                                                    input(type="hidden" name="_csrf" value=csrfToken)
                                                    input(type="hidden" name="responseStatus" value="confirmed")
                                                    button(type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-[700] text-[11px] py-[5px] rounded-[6px] shadow-xs cursor-pointer transition") ✓ Xác Nhận Đi Phỏng Vấn
                                                button(type="button" onclick=`var m=document.getElementById('modalResched_${app._id}'); if(m){m.classList.remove('hidden');m.classList.add('flex');}` class="px-[8px] py-[5px] bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-[600] text-[11px] rounded-[6px] cursor-pointer") Xin đổi giờ

                                if app.interviewInvitation && app.interviewInvitation.sentAt
                                    div(class="mt-[10px] p-[8px] bg-emerald-50 border border-emerald-200 rounded-[6px] text-center")
                                        div(class="text-[12px] font-[700] text-emerald-800 flex items-center justify-center gap-[4px]")
                                            <i class="fa-solid fa-envelope-circle-check"></i> Đã nhận thư mời phỏng vấn!
                                        button(type="button" onclick=`var m=document.getElementById('modalInvite_${app._id}'); if(m){m.classList.remove('hidden');m.classList.add('flex');}` class="mt-[4px] text-[12px] text-[#0088FF] hover:underline font-[600] cursor-pointer inline-flex items-center gap-[4px]")
                                            span Xem thư mời & Trả lời
                                            <i class="fa-solid fa-arrow-right text-[10px]"></i>

                                if app.interviewSchedule && app.interviewSchedule.scheduledAt
                                    div(id=`modalResched_${app._id}` class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px] text-left")
                                        div(class="bg-white rounded-[12px] shadow-2xl max-w-[480px] w-full p-[20px]")
                                            h3(class="font-[700] text-[16px] text-gray-900 mb-[4px]") Đề Xuất Dời Lịch Phỏng Vấn
                                            p(class="text-[12px] text-gray-500 mb-[14px]") Gửi tin nhắn đến #{app.employerId ? app.employerId.companyName : "Nhà tuyển dụng"} để thỏa thuận thời gian phù hợp hơn.
                                            form(action=`/candidate/applied-jobs/${app._id}/respond-interview` method="POST" class="space-y-[12px]")
                                                input(type="hidden" name="_csrf" value=csrfToken)
                                                input(type="hidden" name="responseStatus" value="rescheduled")
                                                div
                                                    label(class="block text-[12px] font-[600] text-gray-700 mb-[4px]") Khung giờ / Ngày bạn có thể tham gia
                                                    textarea(name="note" required rows="3" placeholder="VD: Em xin phép dời sang chiều Thứ Năm lúc 14:00 do trùng lịch học/làm việc..." class="w-full p-[10px] rounded-[6px] border border-gray-300 text-[13px] focus:outline-none focus:ring-2 focus:ring-[#0088FF]")
                                                div(class="flex justify-end gap-[8px]")
                                                    button(type="button" onclick=`document.getElementById('modalResched_${app._id}').classList.add('hidden'); document.getElementById('modalResched_${app._id}').classList.remove('flex');` class="px-[14px] py-[6px] border border-gray-300 rounded-[6px] text-[12px] font-[600] text-gray-600 hover:bg-gray-100") Hủy
                                                    button(type="submit" class="px-[16px] py-[6px] bg-[#0088FF] hover:bg-[#0070d6] text-white rounded-[6px] text-[12px] font-[700]") Gửi Đề Xuất
            
                                div(class="flex justify-center gap-[10px] mt-[14px]")
                                    a(href="/candidate/applied-jobs/" + app._id + "/pdf" target="_blank" class="bg-[#0088FF] hover:bg-[#0070d6] rounded-[6px] py-[8px] px-[20px] cursor-pointer font-[500] text-[13px] text-white flex items-center shadow-xs") Xem CV
                                    if app.status === 'pending'
                                        form(action="/candidate/applied-jobs/" + app._id + "/delete" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn rút hồ sơ ứng tuyển này không?');" class="inline")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            button(type="submit" class="bg-[#FF0000] hover:bg-[#d60000] rounded-[6px] py-[8px] px-[16px] cursor-pointer font-[500] text-[13px] text-white shadow-xs") Rút hồ sơ
                                    else
                                        button(disabled title="Hồ sơ đã được nhà tuyển dụng xem xét, không thể rút" class="bg-[#E0E0E0] rounded-[6px] py-[8px] px-[16px] cursor-not-allowed font-[500] text-[13px] text-[#888888]") Rút hồ sơ

                                if app.status === 'rejected'
                                    //- MODAL XEM PHẢN HỒI TỪ CHỐI DÀNH CHO ỨNG VIÊN
                                    div(id=`modalRejection_${app._id}` class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px] text-left")
                                        div(class="bg-white rounded-[12px] shadow-2xl max-w-[550px] w-full max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn")
                                            div(class="p-[18px] border-b border-gray-200 flex items-center justify-between bg-gradient-to-r from-red-50 to-orange-50")
                                                div(class="flex items-center gap-[10px]")
                                                    div(class="w-[36px] h-[36px] rounded-full bg-red-600 text-white flex items-center justify-center text-[16px]")
                                                        <i class="fa-solid fa-envelope-open-text"></i>
                                                    div
                                                        h3(class="font-[700] text-[16px] text-gray-900") Thông Báo Kết Quả Ứng Tuyển
                                                        p(class="text-[12px] text-gray-500") Từ: #{app.employerId ? app.employerId.companyName : "Nhà tuyển dụng"}
                                                button(type="button" onclick=`var m=document.getElementById('modalRejection_${app._id}'); if(m){m.classList.add('hidden');m.classList.remove('flex');}` class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                                                    <i class="fa-solid fa-xmark"></i>

                                            div(class="p-[20px] overflow-y-auto flex-1 space-y-[14px]")
                                                div(class="bg-red-50 border border-red-200 rounded-[8px] p-[14px]")
                                                    div(class="text-[14px] font-[700] text-red-900 mb-[4px]") Kết Quả: Chưa Phù Hợp Đợt Này
                                                    div(class="text-[12px] text-red-700") Vị trí: <span class="font-[600]">#{app.jobId ? app.jobId.title : ""}</span>
                                                    if app.rejectedAt || app.reviewedAt
                                                        div(class="text-[11px] text-gray-500 mt-[2px]") Ngày thông báo: #{formatDateTime(app.rejectedAt || app.reviewedAt)}

                                                div(class="p-[12px] bg-gray-50 rounded-[6px] border border-gray-200")
                                                    span(class="font-[600] text-gray-700 block text-[13px] mb-[2px]") Lý do từ chối:
                                                    span(class="font-[700] text-red-700 text-[14px]") #{app.rejectionReason || "Chưa phù hợp với yêu cầu vị trí tại thời điểm này"}

                                                if app.rejectionNote
                                                    div(class="border border-gray-200 rounded-[8px] p-[14px] bg-white")
                                                        h4(class="text-[12px] font-[700] text-gray-500 uppercase tracking-wide mb-[6px]") Lời nhắn từ Nhà tuyển dụng:
                                                        div(class="text-[13px] text-gray-800 whitespace-pre-line leading-relaxed")= app.rejectionNote

                                                div(class="p-[12px] bg-blue-50/60 border border-blue-200 rounded-[8px] text-[13px] text-blue-900")
                                                    <i class="fa-solid fa-lightbulb text-[#0088FF] mr-[4px]"></i> Đừng nản lòng nhé! Hãy tiếp tục trau dồi kinh nghiệm và khám phá các vị trí IT tiềm năng khác trên VN.ITJobs.

                                            div(class="p-[14px] border-t border-gray-200 flex flex-wrap justify-end gap-[10px] bg-gray-50")
                                                button(type="button" onclick=`var m=document.getElementById('modalRejection_${app._id}'); if(m){m.classList.add('hidden');m.classList.remove('flex');}` class="px-[16px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] font-[600] text-gray-700 hover:bg-gray-100 cursor-pointer") Đóng
                                                a(href="/search" class="px-[18px] py-[8px] bg-[#0088FF] hover:bg-[#0070D2] rounded-[6px] text-[13px] font-[700] text-white inline-flex items-center gap-[6px] shadow-xs")
                                                    <i class="fa-solid fa-magnifying-glass"></i> Tìm Việc Làm Khác

                                if app.interviewInvitation && app.interviewInvitation.sentAt
                                    //- MODAL XEM THƯ MỜI PHỎNG VẤN DÀNH CHO ỨNG VIÊN
                                    div(id=`modalInvite_${app._id}` class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px] text-left")
                                        div(class="bg-white rounded-[12px] shadow-2xl max-w-[600px] w-full max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn")
                                            div(class="p-[18px] border-b border-gray-200 flex items-center justify-between bg-gradient-to-r from-emerald-50 to-teal-50")
                                                div(class="flex items-center gap-[10px]")
                                                    div(class="w-[36px] h-[36px] rounded-full bg-emerald-600 text-white flex items-center justify-center text-[16px]")
                                                        <i class="fa-solid fa-envelope-open-text"></i>
                                                    div
                                                        h3(class="font-[700] text-[16px] text-gray-900") Thư Mời Phỏng Vấn
                                                        p(class="text-[12px] text-gray-500") Từ: #{app.employerId ? app.employerId.companyName : "Nhà tuyển dụng"}
                                                button(type="button" onclick=`var m=document.getElementById('modalInvite_${app._id}'); if(m){m.classList.add('hidden');m.classList.remove('flex');}` class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                                                    <i class="fa-solid fa-xmark"></i>

                                            div(class="p-[20px] overflow-y-auto flex-1 space-y-[14px]")
                                                div(class="bg-emerald-50/70 border border-emerald-200 rounded-[8px] p-[14px]")
                                                    div(class="text-[14px] font-[700] text-emerald-900 mb-[4px]") #{app.interviewInvitation.subject || "Thư mời tham gia phỏng vấn"}
                                                    div(class="text-[12px] text-emerald-700") Vị trí: <span class="font-[600]">#{app.jobId ? app.jobId.title : ""}</span>

                                                div(class="grid sm:grid-cols-2 grid-cols-1 gap-[10px] text-[13px]")
                                                    div(class="p-[10px] bg-gray-50 rounded-[6px] border border-gray-200")
                                                        span(class="font-[600] text-gray-600 block") ⏱️ Thời gian dự kiến:
                                                        span(class="font-[700] text-gray-900") #{app.interviewInvitation.interviewDate || "Trao đổi linh hoạt"}
                                                    div(class="p-[10px] bg-gray-50 rounded-[6px] border border-gray-200")
                                                        span(class="font-[600] text-gray-600 block") 📍 Hình thức / Địa điểm:
                                                        span(class="font-[700] text-gray-900") #{app.interviewInvitation.location || "Trao đổi trực tiếp"}

                                                div(class="border border-gray-200 rounded-[8px] p-[14px] bg-white")
                                                    h4(class="text-[12px] font-[700] text-gray-500 uppercase tracking-wide mb-[8px]") Lời nhắn từ Nhà tuyển dụng:
                                                    div(class="text-[14px] text-gray-800 whitespace-pre-line leading-relaxed")= app.interviewInvitation.content

                                                div(class="p-[12px] bg-blue-50/60 border border-blue-200 rounded-[8px] text-[13px] space-y-[4px]")
                                                    div(class="font-[700] text-blue-900") 📞 Kênh liên hệ trực tiếp:
                                                    if app.interviewInvitation.employerEmail || (app.employerId && app.employerId.email)
                                                        div(class="text-blue-800") Email: <a href="mailto:" + (app.interviewInvitation.employerEmail || app.employerId.email) class="font-[600] underline">#{app.interviewInvitation.employerEmail || app.employerId.email}</a>
                                                    if app.interviewInvitation.employerPhone || (app.employerId && app.employerId.phone)
                                                        div(class="text-blue-800") Điện thoại / Zalo: <a href="tel:" + (app.interviewInvitation.employerPhone || app.employerId.phone) class="font-[600] underline">#{app.interviewInvitation.employerPhone || app.employerId.phone}</a>

                                            div(class="p-[14px] border-t border-gray-200 flex flex-wrap justify-end gap-[10px] bg-gray-50")
                                                button(type="button" onclick=`var m=document.getElementById('modalInvite_${app._id}'); if(m){m.classList.add('hidden');m.classList.remove('flex');}` class="px-[16px] py-[8px] border border-gray-300 rounded-[6px] text-[13px] font-[600] text-gray-700 hover:bg-gray-100 cursor-pointer") Đóng
                                                if app.interviewInvitation.employerEmail || (app.employerId && app.employerId.email)
                                                    a(href="mailto:" + (app.interviewInvitation.employerEmail || app.employerId.email) + "?subject=Re: " + encodeURIComponent(app.interviewInvitation.subject || "Phản hồi thư mời phỏng vấn") class="px-[18px] py-[8px] bg-[#0088FF] hover:bg-[#0070D2] rounded-[6px] text-[13px] font-[700] text-white inline-flex items-center gap-[6px] shadow-xs")
                                                        <i class="fa-solid fa-reply"></i> Trả Lời Qua Email
                    else
                        div(class="col-span-full py-[40px] text-center text-[#717171] text-[16px]") Bạn chưa gửi hồ sơ ứng tuyển nào. Hãy tìm kiếm việc làm phù hợp và ứng tuyển ngay nhé!

                if pagination && pagination.totalPages > 1
                    div(class="mt-[30px]")
                        select(class="pagination-select border border-[#DEDEDE] rounded-[8px] py-[12px] px-[18px] font-[400] text-[16px] text-[#414042] cursor-pointer")
                            - for (let i = 1; i <= pagination.totalPages; i++)
                                option(value=i selected=(pagination.currentPage === i)) Trang #{i}
    //- Hết Quản lý CV đã gửi
