extends ../layouts/default.pug

block title 
    title Đăng nhập (Nhà tuyển dụng)

block main
    //- Đăng nhập
    div(class="py-[30px] sm:py-[60px]")
        .contain 
            div(class="border border-[#DEDEDE] rounded-[8px] py-[30px] sm:py-[50px] px-[16px] sm:px-[30px] max-w-[602px] w-full mx-auto bg-white shadow-xs")
                h1(class="font-[700] text-[20px] sm:text-[22px] text-center") Đăng nhập (Nhà tuyển dụng)

                if flash && flash.success
                    div(class="mt-[15px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}
                if errors && errors.general
                    div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{errors.general}
                if unverifiedEmail
                    div(class="mt-[15px] p-[12px] bg-[#FFFBEB] border border-[#FDE68A] text-[#B45309] rounded-[4px] text-[14px]")
                        | Tài khoản của bạn chưa xác thực email. 
                        a(href="/employer/verify-registration?email=" + encodeURIComponent(unverifiedEmail) class="text-[#0088FF] font-[600] underline ml-[4px]") Bấm vào đây để xác thực ngay

                form(action="/employer/login" method="POST" class="mt-[20px]") 
                    input(type="hidden" name="_csrf" value=csrfToken)
                    if next
                        input(type="hidden" name="next" value=next)

                    div(class="")
                        label(for="email" class="font-[500] text-[14px]") Email *  
                        input(type="email" id="email" name="email" value=(old && old.email ? old.email : "") required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.email
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.email}

                    div(class="")
                        div(class="flex justify-between items-center")
                            label(for="password" class="font-[500] text-[14px]") Mật khẩu *
                            a(href="/employer/forgot-password" class="text-[#0088FF] text-[13px] hover:underline") Quên mật khẩu?
                        input(type="password" id="password" name="password" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.password
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.password}

                    div(class="") 
                        button(type="submit" class="bg-[#0088FF] py-[14px] rounded-[4px] font-[700] text-[16px] text-white text-center w-full cursor-pointer") Đăng nhập

                //- Đăng nhập với Google
                div(class="my-[20px] flex items-center gap-[10px]")
                    div(class="flex-1 h-[1px] bg-[#E5E7EB]")
                    span(class="text-[13px] text-[#6B7280] font-[500]") hoặc
                    div(class="flex-1 h-[1px] bg-[#E5E7EB]")

                a(href="/employer/auth/google" + (next ? "?next=" + encodeURIComponent(next) : "") class="flex items-center justify-center gap-[10px] w-full py-[12px] px-[20px] border border-[#D1D5DB] hover:bg-gray-50 rounded-[4px] font-[600] text-[14px] text-[#374151] transition-colors")
                    svg(class="w-[18px] h-[18px]" viewBox="0 0 24 24")
                        path(fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z")
                        path(fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z")
                        path(fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z")
                        path(fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z")
                    span Tiếp tục với Google

                div(class="mt-[15px] text-center font-[400] text-[14px] text-[#414042]") Chưa có tài khoản Nhà tuyển dụng? 
                    a(href="/employer/signup" class="text-[#0088FF] font-[600] ml-[4px]") Đăng ký công ty ngay
    //- Hết Đăng nhập
