extends ../layouts/default.pug

block title 
    title #{title}

block main
    div(class="py-[60px]")
        .contain 
            div(class="border border-[#DEDEDE] rounded-[8px] py-[50px] px-[20px] max-w-[602px] mx-auto")
                div(class="text-center text-[40px] text-[#2E7D32] mb-[10px]")
                    i(class="fa-solid fa-shield-halved")
                h1(class="font-[700] text-[20px] text-center") Đặt lại mật khẩu mới
                p(class="text-center text-[14px] text-[#71717A] mt-[8px]") Tạo mật khẩu mới an toàn cho tài khoản 
                    span(class="font-[600] text-[#121212]") #{email}

                if flash && flash.success
                    div(class="mt-[15px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}
                if errors && errors.newPassword
                    div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{errors.newPassword}

                form(action=`/${userRole}/reset-password` method="POST" class="mt-[20px]") 
                    input(type="hidden" name="_csrf" value=csrfToken)
                    input(type="hidden" name="email" value=email)
                    input(type="hidden" name="token" value=token)

                    div(class="mb-[15px]")
                        label(for="newPassword" class="font-[500] text-[14px]") Mật khẩu mới * (Tối thiểu 8 ký tự, gồm cả chữ và số)
                        div(class="relative mt-[5px]")
                            input(type="password" id="newPassword" name="newPassword" required minlength="8" class="border border-[#DEDEDE] rounded-[4px] py-[11px] pl-[16px] pr-[44px] block w-full focus:outline-none focus:border-[#0088FF] transition-colors") 
                            button(type="button" class="btn-toggle-password absolute right-[12px] top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 p-[4px] cursor-pointer transition-colors" data-target="newPassword" title="Ẩn/Hiện mật khẩu" aria-label="Ẩn/Hiện mật khẩu")
                                <i class="fa-regular fa-eye-slash text-[16px]"></i>

                    div(class="mb-[20px]")
                        label(for="confirmPassword" class="font-[500] text-[14px]") Xác nhận mật khẩu mới *
                        div(class="relative mt-[5px]")
                            input(type="password" id="confirmPassword" name="confirmPassword" required minlength="8" class="border border-[#DEDEDE] rounded-[4px] py-[11px] pl-[16px] pr-[44px] block w-full focus:outline-none focus:border-[#0088FF] transition-colors") 
                            button(type="button" class="btn-toggle-password absolute right-[12px] top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 p-[4px] cursor-pointer transition-colors" data-target="confirmPassword" title="Ẩn/Hiện mật khẩu" aria-label="Ẩn/Hiện mật khẩu")
                                <i class="fa-regular fa-eye-slash text-[16px]"></i> 

                    div(class="") 
                        button(type="submit" class="bg-[#0088FF] hover:bg-[#0070D2] transition py-[14px] rounded-[4px] font-[700] text-[16px] text-white text-center w-full cursor-pointer") Lưu mật khẩu mới & Đăng nhập
