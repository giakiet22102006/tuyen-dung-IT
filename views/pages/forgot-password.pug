extends ../layouts/default.pug

block title 
    title #{title}

block main
    div(class="py-[60px]")
        .contain 
            div(class="border border-[#DEDEDE] rounded-[8px] py-[50px] px-[20px] max-w-[602px] mx-auto")
                h1(class="font-[700] text-[20px] text-center") #{title}
                p(class="text-center text-[14px] text-[#71717A] mt-[8px]") Nhập email tài khoản của bạn để nhận mã xác thực OTP qua thư điện tử.

                if flash && flash.success
                    div(class="mt-[15px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}
                if errors && errors.email
                    div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{errors.email}

                form(action=`/${userRole}/forgot-password` method="POST" class="mt-[20px]") 
                    input(type="hidden" name="_csrf" value=csrfToken)

                    div(class="")
                        label(for="email" class="font-[500] text-[14px]") Địa chỉ Email đã đăng ký *  
                        input(type="email" id="email" name="email" value=(old && old.email ? old.email : "") placeholder="example@gmail.com" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full focus:outline-none focus:border-[#0088FF]") 

                    div(class="") 
                        button(type="submit" class="bg-[#0088FF] hover:bg-[#0070D2] transition py-[14px] rounded-[4px] font-[700] text-[16px] text-white text-center w-full cursor-pointer") Nhận mã OTP qua Email

                div(class="mt-[20px] text-center font-[400] text-[14px] text-[#414042]") 
                    a(href=`/${userRole}/login` class="text-[#0088FF] hover:underline font-[500]") <i class="fa-solid fa-arrow-left mr-[4px]"></i> Quay lại trang Đăng nhập
