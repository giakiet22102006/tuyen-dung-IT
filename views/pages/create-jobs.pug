extends ../layouts/default.pug

block title 
    title Thêm mới công việc (Nhà tuyển dụng)

block main
    //- Thêm mới công việc
    div(class="py-[60px]")
        .contain
            if flash && flash.error
                div(class="mb-[20px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}
            if flash && flash.success
                div(class="mb-[20px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}

            div(class="border border-[#DEDEDE] rounded-[8px] p-[20px]")    
                div(class="flex flex-col sm:flex-row justify-between mb-[20px] gap-[20px]")
                    h1(class="font-[700] text-[20px]") Thêm mới công việc
                    a(href="/employer/jobs" class="font-[400] text-[14px] text-[#0088FF] underline") Quay lại danh sách 

                form(action="/employer/jobs/create" method="POST" enctype="multipart/form-data" class="mt-[20px]")
                    input(type="hidden" name="_csrf" value=csrfToken)

                    div(class="mb-[15px]")
                        label(for="title" class="font-[500] text-[14px] mb-[5px]") Tên công việc *
                        input(type="text" id="title" name="title" value=(old && old.title || "") required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full") 
                        if errors && errors.title
                            div(class="text-[#FF0000] text-[13px] mt-[4px]") #{errors.title}

                    div(class="grid sm:grid-cols-2 grid-cols-1 sm:gap-[20px] gap-[15px] mb-[15px]")
                        div(class="")
                            label(for="salaryMin" class="font-[500] text-[14px] mb-[5px]") Mức lương tối thiểu ($)
                            input(type="number" min="0" id="salaryMin" name="salaryMin" value=(old && old.salaryMin !== undefined ? old.salaryMin : "") placeholder="Ví dụ: 1000" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full")  
                        div(class="")
                            label(for="salaryMax" class="font-[500] text-[14px] mb-[5px]") Mức lương tối đa ($) <span class="text-gray-500 font-normal text-[12px]">(Để trống nếu thỏa thuận theo năng lực)</span>
                            input(type="number" min="0" id="salaryMax" name="salaryMax" value=(old && old.salaryMax !== undefined ? old.salaryMax : "") placeholder="Để trống nếu thỏa thuận theo năng lực" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full") 
                            if errors && errors.salaryMax
                                div(class="text-[#FF0000] text-[13px] mt-[4px]") #{errors.salaryMax}

                    div(class="grid sm:grid-cols-2 grid-cols-1 sm:gap-[20px] gap-[15px] mb-[15px]")
                        div(class="")
                            label(for="position" class="font-[500] text-[14px] mb-[5px]") Cấp bậc *
                            select(id="position" name="position" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full cursor-pointer")
                                if positions && positions.length > 0
                                    each pos in positions
                                        option(value=pos.value selected=(old && old.position === pos.value)) #{pos.label}
                                else
                                    option(value="intern") Intern 
                                    option(value="middle") Middle
                            if errors && errors.position
                                div(class="text-[#FF0000] text-[13px] mt-[4px]") #{errors.position}
                        div(class="")
                            label(for="workingForm" class="font-[500] text-[14px] mb-[5px]") Hình thức làm việc *
                            select(id="workingForm" name="workingForm" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full cursor-pointer")
                                if workingForms && workingForms.length > 0
                                    each wf in workingForms
                                        option(value=wf.value selected=(old && old.workingForm === wf.value)) #{wf.label}
                                else
                                    option(value="office") Tại văn phòng 
                                    option(value="remote") Từ xa
                            if errors && errors.workingForm
                                div(class="text-[#FF0000] text-[13px] mt-[4px]") #{errors.workingForm}

                    div(class="mb-[15px]")
                        label(for="skills" class="font-[500] text-[14px] mb-[5px]") Các công nghệ (phân cách bởi dấu phẩy)
                        input(type="text" id="skills" name="skills" value=(old && old.skills || "") placeholder="Ví dụ: ReactJS, NodeJS, MongoDB" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full")

                    div(class="mb-[18px]")
                        label(class="font-[600] text-[14px] text-gray-800 mb-[8px] block") <i class="fa-solid fa-gift text-emerald-600 mr-[4px]"></i> Đãi ngộ & Phúc lợi nổi bật (Chuẩn ITviec)
                        div(class="grid sm:grid-cols-2 grid-cols-1 gap-[10px] p-[14px] bg-emerald-50/50 border border-emerald-200 rounded-[8px]")
                            if benefitsList && benefitsList.length > 0
                                each ben in benefitsList
                                    label(class="flex items-center gap-[8px] text-[13px] text-gray-700 cursor-pointer select-none hover:text-emerald-800")
                                        input(type="checkbox" name="benefits" value=ben.value checked=(old && old.benefits && (Array.isArray(old.benefits) ? old.benefits.includes(ben.value) : old.benefits === ben.value)) class="w-[16px] h-[16px] text-[#0088FF] rounded border-gray-300 cursor-pointer")
                                        span(class="inline-flex items-center gap-[6px]")
                                            <i class="#{ben.icon} text-emerald-600 text-[13px]"></i>
                                            span #{ben.label}

                    div(class="mb-[15px]")
                        label(for="images" class="font-[500] text-[14px] mb-[5px]") Danh sách ảnh (tối đa 5 ảnh, định dạng PNG, JPG, WebP)
                        input(type="file" id="images" name="images" multiple accept="image/*" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full")

                    div(class="mb-[15px]")
                        div(class="flex items-center justify-between mb-[6px]")
                            label(for="description" class="font-[500] text-[14px]") Mô tả chi tiết
                            button(type="button" id="btnAiGenerateJd" class="inline-flex items-center gap-[6px] px-[14px] py-[6px] rounded-[4px] bg-[#0088FF] hover:bg-[#0070D2] text-white text-[13px] font-[600] cursor-pointer shadow-xs transition-all")
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                span ✨ AI Viết Mô Tả Việc Làm Tự Động
                        textarea(id="description" name="description" placeholder="Nhập tên việc làm & kỹ năng bên trên, sau đó bấm nút 'AI Viết Mô Tả Việc Làm Tự Động' để tạo bản thảo chuyên nghiệp..." class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] block w-full min-h-[350px]")= (old && old.description || "")
  
                    div(class="")
                        button(type="submit" class="bg-[#0088FF] rounded-[4px] py-[14px] px-[20px] font-[700] text-[16px] text-white cursor-pointer") Tạo mới

    script.
        (function() {
            function runInit() {
                if (window.initAiJdGenerator) window.initAiJdGenerator();
            }
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", runInit);
            } else {
                runInit();
            }
        })();
    //- Hết Thêm mới công việc
