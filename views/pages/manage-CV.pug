extends ../layouts/default.pug

block title 
    title #{title || "Quản lý CV (Nhà tuyển dụng)"}

block main
    //- Quản lý CV
    div(class="py-[60px]") 
        .contain 
            div(class="")
                h1(class="font-[700] text-[28px] text-[#121212] mb-[20px]") Quản lý CV

                if flash && flash.success
                    div(class="mb-[20px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mb-[20px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}

                div(class="grid xl:grid-cols-3 lg:grid-cols-2 grid-cols-1 gap-[20px]")
                    if applications && applications.length > 0
                        each app in applications
                            div(class="card-item p-[20px]")
                                img(src="/assets/images/bg-card.png" class="inner-bg")
                                div(class="font-[700] text-[18px] text-[#121212] text-center line-clamp-[2]") #{app.jobId ? app.jobId.title : "Việc làm không còn tồn tại"}
                                div(class="mt-[12px] font-[400] text-[14px] text-center") Ứng viên: <span class="font-[700] text-[14px]">#{app.fullName}</span>
                                div(class="mt-[6px] font-[400] text-[14px] text-[#121212] text-center") <i class="fa-solid fa-envelope mr-[3px]"></i> #{app.email}
                                div(class="mt-[7px] font-[400] text-[14px] text-[#121212] text-center") <i class="fa-solid fa-phone mr-[3px]"></i> #{app.phone}
                                div(class="font-[600] text-[16px] text-[#0088FF] text-center mt-[12px]") #{app.jobId ? formatSalary(app.jobId.salaryMin, app.jobId.salaryMax) : "Thương lượng"}
                                div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") 
                                    <i class="fa-solid fa-user-tie text-[16px] mr-[1px]"></i> #{app.jobId ? labels.getPositionLabel(app.jobId.position) : "Khác"}
                                div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") 
                                    <i class="fa-solid fa-briefcase text-[16px] mr-[1px]"></i> #{app.jobId ? labels.getWorkingFormLabel(app.jobId.workingForm) : "Khác"}

                                if !app.viewed
                                    div(class="font-[400] text-[14px] text-[#FF0000] text-center mt-[6px]") <i class="fa-solid fa-eye text-[16px] mr-[1px]"></i> Chưa xem
                                else
                                    div(class="font-[400] text-[14px] text-[#2E7D32] text-center mt-[6px]") <i class="fa-solid fa-eye text-[16px] mr-[1px]"></i> Đã xem

                                if app.status === 'pending'
                                    div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") <i class="fa-solid fa-circle-check text-[16px] mr-[1px] text-[#FFB200]"></i> Chưa duyệt
                                else if app.status === 'approved'
                                    div(class="font-[400] text-[14px] text-[#2E7D32] text-center mt-[6px]") <i class="fa-solid fa-circle-check text-[16px] mr-[1px]"></i> Đã duyệt phù hợp
                                else if app.status === 'rejected'
                                    div(class="font-[400] text-[14px] text-[#C62828] text-center mt-[6px]") <i class="fa-solid fa-circle-xmark text-[16px] mr-[1px]"></i> Đã từ chối
                                
                                div(class="flex flex-wrap justify-center gap-[8px] mt-[12px]")
                                    a(href="/employer/cvs/" + app._id class="bg-[#0088FF] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-white flex items-center") Xem
                                    
                                    form(action="/employer/cvs/" + app._id + "/status" method="POST" class="inline")
                                        input(type="hidden" name="_csrf" value=csrfToken)
                                        input(type="hidden" name="status" value="approved")
                                        button(type="submit" class="bg-[#9FDB7C] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-black") Duyệt

                                    form(action="/employer/cvs/" + app._id + "/status" method="POST" class="inline")
                                        input(type="hidden" name="_csrf" value=csrfToken)
                                        input(type="hidden" name="status" value="rejected")
                                        button(type="submit" class="bg-[#FF5100] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-white") Từ chối

                                    form(action="/employer/cvs/" + app._id + "/delete" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa hồ sơ CV này không?');" class="inline")
                                        input(type="hidden" name="_csrf" value=csrfToken)
                                        button(type="submit" class="bg-[#FF0000] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-white") Xóa
                    else
                        div(class="col-span-full py-[40px] text-center text-[#717171] text-[16px]") Hiện tại chưa có ứng viên nào nộp hồ sơ ứng tuyển.

                if pagination && pagination.totalPages > 1
                    div(class="mt-[30px]")
                        select(class="pagination-select border border-[#DEDEDE] rounded-[8px] py-[12px] px-[18px] font-[400] text-[16px] text-[#414042] cursor-pointer")
                            - for (let i = 1; i <= pagination.totalPages; i++)
                                option(value=i selected=(pagination.currentPage === i)) Trang #{i}
    //- Hết Quản lý CV
