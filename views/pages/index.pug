extends ../layouts/default.pug
include ../mixins/company-card.pug

block title 
    title #{title || "Trang chủ - VN.ITJobs"}

block main
    //- Section 1
    include ../partials/section1.pug
    //- End Section 1

    //- Section 2
    div(class="py-[60px]")
        .contain
            h2(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] text-center mb-[30px]") Nhà tuyển dụng hàng đầu
            div(class="grid lg:grid-cols-3 grid-cols-2 sm:gap-x-[20px] gap-y-[20px] gap-x-[10px]")
                if topEmployers && topEmployers.length > 0
                    each emp in topEmployers
                        +companyCard(emp)
                else
                    div(class="col-span-full text-center text-[#717171] py-[30px]") Chưa có nhà tuyển dụng nào.
    //- End Section 2
