extends ../layouts/default.pug

block title 
    title #{title || "Hồ sơ IT Profile Trực Tuyến - VN.ITJobs"}

block main
    div(class="py-[35px] sm:py-[60px]")
        .contain 
            div(class="max-w-[900px] mx-auto")
                div(class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-[24px] gap-[12px]")
                    div
                        h1(class="font-[700] text-[22px] sm:text-[28px] text-[#121212] flex items-center gap-[10px]")
                            <i class="fa-solid fa-file-code text-[#0088FF]"></i>
                            span Hồ sơ IT Profile Trực Tuyến
                        p(class="text-[13px] sm:text-[14px] text-gray-500 mt-[2px]") Xây dựng hồ sơ công nghệ chuẩn ITviec - Ứng tuyển nhanh 1-Click không cần upload lại PDF

                    div(class="flex flex-wrap items-center gap-[10px]")
                        a(href="/candidate/it-profile/pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-[6px] px-[14px] py-[8px] bg-emerald-600 hover:bg-emerald-700 text-white text-[13px] font-[700] rounded-[6px] shadow-xs transition")
                            <i class="fa-solid fa-file-pdf"></i>
                            span Xem trước / Tải PDF CV
                        a(href="/candidate/profile" class="text-[13px] font-[600] text-[#0088FF] hover:underline") <i class="fa-solid fa-user mr-[4px]"></i> Thông tin tài khoản

                form(action="/candidate/it-profile" method="POST" id="formItProfile" class="space-y-[24px]")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    
                    //- Hidden JSON fields for dynamic items
                    input(type="hidden" id="workExperienceJson" name="workExperience" value=JSON.stringify(profile.workExperience || []))
                    input(type="hidden" id="projectsJson" name="projects" value=JSON.stringify(profile.projects || []))
                    input(type="hidden" id="educationJson" name="education" value=JSON.stringify(profile.education || []))
                    input(type="hidden" id="certificatesJson" name="certificates" value=JSON.stringify(profile.certificates || []))

                    //- 0. Cài đặt Bật/Tắt Tìm Việc & Quyền riêng tư Headhunting
                    - const isOpenWork = profile.openToWork !== false
                    - const cityOptions = (cities && cities.length > 0) ? cities : (labels && labels.CITIES ? labels.CITIES : [])
                    div(class="bg-gradient-to-r from-emerald-50 via-teal-50 to-white rounded-[10px] border border-emerald-200 p-[18px] sm:p-[22px] shadow-2xs")
                        div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-[16px]")
                            div(class="flex items-start gap-[12px]")
                                div(class="w-[42px] h-[42px] rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[18px] shrink-0 mt-[2px]")
                                    <i class="fa-solid fa-users-viewfinder"></i>
                                div
                                    div(class="flex items-center gap-[8px]")
                                        h2(class="font-[700] text-[16px] text-gray-900") Trạng thái Sẵn sàng nhận việc (Open to Work)
                                        span(class="text-[11px] font-[700] uppercase tracking-wider bg-emerald-200/60 text-emerald-800 px-[6px] py-[1px] rounded") Hot
                                    p(class="text-[13px] text-gray-600 mt-[2px]") Khi bật, hồ sơ của bạn sẽ hiển thị trong Kho ứng viên (Talent Pool) để các Nhà tuyển dụng hàng đầu chủ động săn đón và gửi lời mời phỏng vấn.
                            
                            label(for="openToWork" class="relative inline-flex items-center cursor-pointer shrink-0")
                                input(type="checkbox" id="openToWork" name="openToWork" value="true" checked=isOpenWork class="sr-only peer")
                                div(class="w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600")
                                span(id="openToWorkLabel" class=`ml-3 text-[13px] font-[700] ${isOpenWork ? 'text-emerald-900' : 'text-gray-500'}`) #{isOpenWork ? 'Đang mở cơ hội' : 'Đang ẩn hồ sơ'}

                        div(class="grid grid-cols-1 sm:grid-cols-3 gap-[14px] mt-[16px] pt-[14px] border-t border-emerald-200/60")
                            div
                                label(for="expectedSalary" class="block text-[12.5px] font-[600] text-gray-700 mb-[4px]") Mức lương kỳ vọng (USD / tháng — $)
                                input(type="number" id="expectedSalary" name="expectedSalary" min="0" step="50" value=(profile.expectedSalary || "") placeholder="VD: 1500 ($/tháng)" class="w-full bg-white border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[13.5px] focus:outline-none focus:ring-2 focus:ring-emerald-500")
                            div
                                label(for="preferredCity" class="block text-[12.5px] font-[600] text-gray-700 mb-[4px]") Khu vực làm việc mong muốn
                                select(id="preferredCity" name="preferredCity" class="w-full bg-white border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[13.5px] cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500")
                                    each c in cityOptions
                                        option(value=c.value selected=((profile.preferredCity || "ha-noi") === c.value)) #{c.label}
                            div
                                label(for="hideFromCurrentCompany" class="block text-[12.5px] font-[600] text-gray-700 mb-[4px]") Ẩn hồ sơ với công ty hiện tại
                                input(type="text" id="hideFromCurrentCompany" name="hideFromCurrentCompany" value=(profile.hideFromCurrentCompany || "") placeholder="VD: FPT, Viettel..." class="w-full bg-white border border-gray-300 rounded-[6px] px-[12px] py-[8px] text-[13.5px] focus:outline-none focus:ring-2 focus:ring-emerald-500")

                    //- 1. Thông tin chuyên môn cốt lõi
                    div(class="bg-white rounded-[10px] border border-gray-200 p-[20px] sm:p-[24px] shadow-2xs")
                        h2(class="font-[700] text-[16px] sm:text-[18px] text-gray-900 pb-[12px] mb-[18px] border-b border-gray-100 flex items-center gap-[8px]")
                            <i class="fa-solid fa-briefcase text-[#0088FF]"></i>
                            span 1. Định hướng & Chức danh IT
                        
                        div(class="grid grid-cols-1 md:grid-cols-12 gap-[16px] mb-[18px]")
                            div(class="md:col-span-6 flex flex-col justify-end")
                                label(class="block text-[13px] font-[600] text-gray-700 mb-[6px] truncate")
                                    | Chức danh chuyên môn 
                                    span(class="text-red-500 font-bold") *
                                    span(class="text-[12px] font-normal text-gray-400 ml-[4px]") (VD: Fullstack Developer)
                                input(type="text" name="title" required value=(profile.title || "") placeholder="VD: Senior Frontend Developer" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[10px] text-[14px] focus:border-[#0088FF] focus:outline-none transition")
                            
                            div(class="md:col-span-3 flex flex-col justify-end")
                                label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Cấp bậc
                                select(name="level" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[10px] text-[14px] bg-white cursor-pointer focus:border-[#0088FF] focus:outline-none transition")
                                    if positions && positions.length > 0
                                        each p in positions
                                            option(value=p.value selected=(profile.level === p.value)) #{p.label}
                                    else
                                        option(value="junior") Junior
                                        option(value="middle") Middle
                                        option(value="senior") Senior
                            
                            div(class="md:col-span-3 flex flex-col justify-end")
                                label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Số năm kinh nghiệm
                                input(type="number" name="yearsOfExperience" min="0" max="40" value=(profile.yearsOfExperience || 0) class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[10px] text-[14px] focus:border-[#0088FF] focus:outline-none transition")

                        div(class="mb-[16px]")
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Kỹ năng công nghệ cốt lõi (phân cách bằng dấu phẩy) *
                            input(type="text" name="skills" required value=(profile.skills ? profile.skills.join(', ') : "") placeholder="ReactJS, NodeJS, TypeScript, MongoDB, Docker, AWS..." class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[10px] text-[14px] focus:border-[#0088FF] focus:outline-none")
                            p(class="text-[12px] text-gray-400 mt-[4px]") Kỹ năng này sẽ được AI sử dụng để so khớp độ phù hợp khi bạn ứng tuyển việc làm.

                        div
                            label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") Tóm tắt bản thân & Mục tiêu nghề nghiệp (Bio)
                            textarea(name="bio" rows="4" placeholder="Giới thiệu ngắn gọn về kinh nghiệm, thế mạnh kỹ thuật và định hướng phát triển của bạn..." class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[10px] text-[14px] focus:border-[#0088FF] focus:outline-none leading-relaxed")= (profile.bio || "")

                    //- 2. Kênh chuyên môn (GitHub, LinkedIn, Portfolio)
                    div(class="bg-white rounded-[10px] border border-gray-200 p-[20px] sm:p-[24px] shadow-2xs")
                        h2(class="font-[700] text-[16px] sm:text-[18px] text-gray-900 pb-[12px] mb-[18px] border-b border-gray-100 flex items-center gap-[8px]")
                            <i class="fa-solid fa-link text-[#0088FF]"></i>
                            span 2. Liên kết Portfolio & Mã nguồn (Dân IT nên có)
                        
                        div(class="grid sm:grid-cols-3 grid-cols-1 gap-[16px]")
                            div
                                label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") <i class="fa-brands fa-github text-[15px] mr-[4px]"></i> GitHub URL
                                input(type="url" name="githubUrl" value=(profile.githubUrl || "") placeholder="https://github.com/username" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[9px] text-[13px]")
                            div
                                label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") <i class="fa-brands fa-linkedin text-[15px] text-[#0077B5] mr-[4px]"></i> LinkedIn URL
                                input(type="url" name="linkedinUrl" value=(profile.linkedinUrl || "") placeholder="https://linkedin.com/in/username" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[9px] text-[13px]")
                            div
                                label(class="block text-[13px] font-[600] text-gray-700 mb-[6px]") <i class="fa-solid fa-globe text-[15px] text-emerald-600 mr-[4px]"></i> Portfolio / Blog cá nhân
                                input(type="url" name="portfolioUrl" value=(profile.portfolioUrl || "") placeholder="https://myportfolio.dev" class="w-full border border-gray-300 rounded-[6px] px-[12px] py-[9px] text-[13px]")

                    //- 3. Kinh nghiệm làm việc
                    div(class="bg-white rounded-[10px] border border-gray-200 p-[20px] sm:p-[24px] shadow-2xs")
                        div(class="flex items-center justify-between pb-[12px] mb-[18px] border-b border-gray-100")
                            h2(class="font-[700] text-[16px] sm:text-[18px] text-gray-900 flex items-center gap-[8px]")
                                <i class="fa-solid fa-building text-[#0088FF]"></i>
                                span 3. Kinh nghiệm làm việc (Work Experience)
                            button(type="button" id="btnAddWork" class="inline-flex items-center gap-[6px] px-[12px] py-[6px] bg-blue-50 text-[#0088FF] hover:bg-blue-100 text-[12px] font-[700] rounded-[6px] cursor-pointer transition-colors")
                                <i class="fa-solid fa-plus"></i> Thêm kinh nghiệm

                        div(id="workListContainer" class="space-y-[16px]")
                            //- Dynamically populated by JS

                    //- 4. Dự án tiêu biểu
                    div(class="bg-white rounded-[10px] border border-gray-200 p-[20px] sm:p-[24px] shadow-2xs")
                        div(class="flex items-center justify-between pb-[12px] mb-[18px] border-b border-gray-100")
                            h2(class="font-[700] text-[16px] sm:text-[18px] text-gray-900 flex items-center gap-[8px]")
                                <i class="fa-solid fa-laptop-code text-[#0088FF]"></i>
                                span 4. Dự án thực chiến (Projects)
                            button(type="button" id="btnAddProject" class="inline-flex items-center gap-[6px] px-[12px] py-[6px] bg-blue-50 text-[#0088FF] hover:bg-blue-100 text-[12px] font-[700] rounded-[6px] cursor-pointer transition-colors")
                                <i class="fa-solid fa-plus"></i> Thêm dự án

                        div(id="projectListContainer" class="space-y-[16px]")
                            //- Dynamically populated by JS

                    //- 5. Học vấn & Chứng chỉ
                    div(class="bg-white rounded-[10px] border border-gray-200 p-[20px] sm:p-[24px] shadow-2xs")
                        div(class="flex items-center justify-between pb-[12px] mb-[18px] border-b border-gray-100")
                            h2(class="font-[700] text-[16px] sm:text-[18px] text-gray-900 flex items-center gap-[8px]")
                                <i class="fa-solid fa-graduation-cap text-[#0088FF]"></i>
                                span 5. Học vấn & Chứng chỉ IT
                            button(type="button" id="btnAddEdu" class="inline-flex items-center gap-[6px] px-[12px] py-[6px] bg-blue-50 text-[#0088FF] hover:bg-blue-100 text-[12px] font-[700] rounded-[6px] cursor-pointer transition-colors")
                                <i class="fa-solid fa-plus"></i> Thêm học vấn

                        div(id="eduListContainer" class="space-y-[12px]")
                            //- Dynamically populated by JS

                        div(class="mt-[22px] pt-[18px] border-t border-gray-100")
                            div(class="flex items-center justify-between mb-[12px]")
                                h3(class="font-[700] text-[14.5px] text-gray-800 flex items-center gap-[6px]")
                                    <i class="fa-solid fa-certificate text-amber-500"></i>
                                    span Chứng chỉ chuyên môn (Certifications)
                                button(type="button" id="btnAddCert" class="inline-flex items-center gap-[6px] px-[12px] py-[6px] bg-amber-50 text-amber-700 hover:bg-amber-100 text-[12px] font-[700] rounded-[6px] cursor-pointer transition-colors")
                                    <i class="fa-solid fa-plus"></i> Thêm chứng chỉ

                            div(id="certificatesList" class="space-y-[12px]")
                                //- Dynamically populated by JS

                    //- Nút Lưu & Xem PDF
                    div(class="flex flex-wrap items-center justify-end gap-[12px] pt-[10px]")
                        a(href="/candidate/profile" class="px-[20px] py-[12px] border border-gray-300 text-gray-700 font-[600] rounded-[6px] hover:bg-gray-50 text-[14px]") Hủy bỏ
                        a(href="/candidate/it-profile/pdf" target="_blank" rel="noopener noreferrer" class="px-[20px] py-[12px] border border-emerald-600 text-emerald-700 hover:bg-emerald-50 font-[700] rounded-[6px] text-[14px] inline-flex items-center gap-[8px]")
                            <i class="fa-solid fa-file-pdf"></i>
                            span Xem trước / Tải PDF CV
                        button(type="submit" class="bg-[#0088FF] hover:bg-[#0070d6] text-white px-[28px] py-[12px] font-[700] rounded-[6px] text-[15px] shadow-sm cursor-pointer inline-flex items-center gap-[8px]")
                            <i class="fa-solid fa-floppy-disk"></i>
                            span Lưu Hồ Sơ IT Profile

    script.
        (function() {
            var openToWorkCheckbox = document.getElementById("openToWork");
            var openToWorkLabel = document.getElementById("openToWorkLabel");
            function syncOpenToWorkLabel() {
                if (!openToWorkCheckbox || !openToWorkLabel) return;
                if (openToWorkCheckbox.checked) {
                    openToWorkLabel.textContent = "Đang mở cơ hội";
                    openToWorkLabel.classList.remove("text-gray-500");
                    openToWorkLabel.classList.add("text-emerald-900");
                } else {
                    openToWorkLabel.textContent = "Đang ẩn hồ sơ";
                    openToWorkLabel.classList.remove("text-emerald-900");
                    openToWorkLabel.classList.add("text-gray-500");
                }
            }
            if (openToWorkCheckbox) {
                openToWorkCheckbox.addEventListener("change", syncOpenToWorkLabel);
                syncOpenToWorkLabel();
            }

            var workData = [];
            var projectData = [];
            var eduData = [];
            var certData = [];

            try {
                workData = JSON.parse(document.getElementById("workExperienceJson").value || "[]");
            } catch(e) {}
            try {
                projectData = JSON.parse(document.getElementById("projectsJson").value || "[]");
            } catch(e) {}
            try {
                eduData = JSON.parse(document.getElementById("educationJson").value || "[]");
            } catch(e) {}
            try {
                certData = JSON.parse(document.getElementById("certificatesJson").value || "[]");
            } catch(e) {}

            var workContainer = document.getElementById("workListContainer");
            var projectContainer = document.getElementById("projectListContainer");
            var eduContainer = document.getElementById("eduListContainer");
            var certContainer = document.getElementById("certificatesList");

            function esc(str) {
                if (str === null || str === undefined) return "";
                return String(str)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;");
            }

            function renderWorks() {
                if (!workContainer) return;
                workContainer.innerHTML = "";
                if (workData.length === 0) {
                    workContainer.innerHTML = "<div class='text-[13px] text-gray-400 italic py-[10px]'>Chưa có thông tin kinh nghiệm làm việc. Bấm '+ Thêm kinh nghiệm' để bổ sung.</div>";
                    return;
                }
                workData.forEach(function(w, idx) {
                    var card = document.createElement("div");
                    card.className = "work-card p-[14px] bg-gray-50 border border-gray-200 rounded-[8px] space-y-[10px] relative";
                    card.innerHTML = `
                        <button type="button" class="btn-del-work absolute top-[10px] right-[10px] text-red-500 hover:text-red-700 text-[14px] cursor-pointer p-[4px]" data-idx="${idx}" title="Xóa">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                        <div class="grid sm:grid-cols-2 grid-cols-1 gap-[10px]">
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Tên Công ty</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-work-company" value="${esc(w.company || '')}" placeholder="FPT Software, VNG, VNPT...">
                            </div>
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Vị trí / Chức danh</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-work-pos" value="${esc(w.position || '')}" placeholder="Frontend Developer, QA...">
                            </div>
                        </div>
                        <div class="grid sm:grid-cols-3 grid-cols-1 gap-[10px]">
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Bắt đầu</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-work-start" value="${esc(w.startDate || '')}" placeholder="06/2023">
                            </div>
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Kết thúc</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-work-end" value="${esc(w.endDate || '')}" placeholder="Hiện tại hoặc 08/2025">
                            </div>
                            <div class="flex items-center pt-[18px]">
                                <label class="flex items-center gap-[6px] text-[12px] text-gray-700 cursor-pointer select-none">
                                    <input type="checkbox" class="inp-work-curr cursor-pointer" ${w.isCurrent ? 'checked' : ''}> Đang làm việc tại đây
                                </label>
                            </div>
                        </div>
                        <div>
                            <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Mô tả công việc & Thành tích</label>
                            <textarea class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-work-desc" rows="2" placeholder="Xây dựng giao diện Web App, tối ưu hiệu năng Lighthouse, tham gia sprint Scrum...">${esc(w.description || '')}</textarea>
                        </div>
                    `;
                    workContainer.appendChild(card);
                });

                bindWorkEvents();
            }

            function bindWorkEvents() {
                workContainer.querySelectorAll(".btn-del-work").forEach(function(btn) {
                    btn.addEventListener("click", function() {
                        var idx = parseInt(btn.getAttribute("data-idx"), 10);
                        syncWorksFromDOM();
                        workData.splice(idx, 1);
                        renderWorks();
                    });
                });
            }

            function syncWorksFromDOM() {
                var cards = workContainer.querySelectorAll(".work-card");
                workData = [];
                cards.forEach(function(card) {
                    workData.push({
                        company: card.querySelector(".inp-work-company").value.trim(),
                        position: card.querySelector(".inp-work-pos").value.trim(),
                        startDate: card.querySelector(".inp-work-start").value.trim(),
                        endDate: card.querySelector(".inp-work-end").value.trim(),
                        isCurrent: card.querySelector(".inp-work-curr").checked,
                        description: card.querySelector(".inp-work-desc").value.trim()
                    });
                });
                document.getElementById("workExperienceJson").value = JSON.stringify(workData);
            }

            function renderProjects() {
                if (!projectContainer) return;
                projectContainer.innerHTML = "";
                if (projectData.length === 0) {
                    projectContainer.innerHTML = "<div class='text-[13px] text-gray-400 italic py-[10px]'>Chưa có dự án nào. Bấm '+ Thêm dự án' để khoe các sản phẩm bạn đã làm.</div>";
                    return;
                }
                projectData.forEach(function(p, idx) {
                    var card = document.createElement("div");
                    card.className = "project-card p-[14px] bg-gray-50 border border-gray-200 rounded-[8px] space-y-[10px] relative";
                    card.innerHTML = `
                        <button type="button" class="btn-del-project absolute top-[10px] right-[10px] text-red-500 hover:text-red-700 text-[14px] cursor-pointer p-[4px]" data-idx="${idx}" title="Xóa">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                        <div class="grid sm:grid-cols-2 grid-cols-1 gap-[10px]">
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Tên Dự án</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-proj-name" value="${esc(p.name || '')}" placeholder="E-commerce Web App, Chatbot AI...">
                            </div>
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Vai trò của bạn</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-proj-role" value="${esc(p.role || '')}" placeholder="Team Leader, Frontend Developer...">
                            </div>
                        </div>
                        <div class="grid sm:grid-cols-2 grid-cols-1 gap-[10px]">
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Tech Stack sử dụng</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-proj-stack" value="${esc(p.techStack || '')}" placeholder="React, Node.js, Tailwind, MongoDB...">
                            </div>
                            <div>
                                <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Link Demo / GitHub</label>
                                <input type="text" class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-proj-link" value="${esc(p.link || '')}" placeholder="https://github.com/my-repo">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[12px] font-[600] text-gray-600 mb-[2px]">Mô tả tóm tắt tính năng</label>
                            <textarea class="w-full border border-gray-300 rounded-[4px] px-[10px] py-[6px] text-[13px] bg-white inp-proj-desc" rows="2" placeholder="Hệ thống phục vụ 5.000 người dùng hàng ngày, tích hợp thanh toán VnPay...">${esc(p.description || '')}</textarea>
                        </div>
                    `;
                    projectContainer.appendChild(card);
                });

                bindProjectEvents();
            }

            function bindProjectEvents() {
                projectContainer.querySelectorAll(".btn-del-project").forEach(function(btn) {
                    btn.addEventListener("click", function() {
                        var idx = parseInt(btn.getAttribute("data-idx"), 10);
                        syncProjectsFromDOM();
                        projectData.splice(idx, 1);
                        renderProjects();
                    });
                });
            }

            function syncProjectsFromDOM() {
                var cards = projectContainer.querySelectorAll(".project-card");
                projectData = [];
                cards.forEach(function(card) {
                    projectData.push({
                        name: card.querySelector(".inp-proj-name").value.trim(),
                        role: card.querySelector(".inp-proj-role").value.trim(),
                        techStack: card.querySelector(".inp-proj-stack").value.trim(),
                        link: card.querySelector(".inp-proj-link").value.trim(),
                        description: card.querySelector(".inp-proj-desc").value.trim()
                    });
                });
                document.getElementById("projectsJson").value = JSON.stringify(projectData);
            }

            function renderEdu() {
                if (!eduContainer) return;
                eduContainer.innerHTML = "";
                if (eduData.length === 0) {
                    eduContainer.innerHTML = "<div class='text-[13px] text-gray-400 italic py-[10px]'>Chưa có thông tin học vấn. Bấm '+ Thêm học vấn' để bổ sung.</div>";
                    return;
                }
                eduData.forEach(function(e, idx) {
                    var card = document.createElement("div");
                    card.className = "edu-card p-[12px] bg-gray-50 border border-gray-200 rounded-[8px] flex items-center justify-between gap-[10px]";
                    card.innerHTML = `
                        <div class="grid sm:grid-cols-3 grid-cols-1 gap-[8px] flex-1">
                            <input type="text" class="border border-gray-300 rounded-[4px] px-[8px] py-[5px] text-[13px] bg-white inp-edu-school" value="${esc(e.school || '')}" placeholder="Trường ĐH / Học viện">
                            <input type="text" class="border border-gray-300 rounded-[4px] px-[8px] py-[5px] text-[13px] bg-white inp-edu-major" value="${esc(e.major || '')}" placeholder="Chuyên ngành (CNTT, HTTT...)">
                            <input type="text" class="border border-gray-300 rounded-[4px] px-[8px] py-[5px] text-[13px] bg-white inp-edu-year" value="${esc(e.gradYear || '')}" placeholder="Năm tốt nghiệp (VD: 2024)">
                        </div>
                        <button type="button" class="btn-del-edu text-red-500 hover:text-red-700 text-[14px] p-[4px] cursor-pointer" data-idx="${idx}" title="Xóa">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    `;
                    eduContainer.appendChild(card);
                });

                bindEduEvents();
            }

            function bindEduEvents() {
                eduContainer.querySelectorAll(".btn-del-edu").forEach(function(btn) {
                    btn.addEventListener("click", function() {
                        var idx = parseInt(btn.getAttribute("data-idx"), 10);
                        syncEduFromDOM();
                        eduData.splice(idx, 1);
                        renderEdu();
                    });
                });
            }

            function syncEduFromDOM() {
                var cards = eduContainer.querySelectorAll(".edu-card");
                eduData = [];
                cards.forEach(function(card) {
                    eduData.push({
                        school: card.querySelector(".inp-edu-school").value.trim(),
                        major: card.querySelector(".inp-edu-major").value.trim(),
                        gradYear: card.querySelector(".inp-edu-year").value.trim()
                    });
                });
                document.getElementById("educationJson").value = JSON.stringify(eduData);
            }

            function renderCerts() {
                if (!certContainer) return;
                certContainer.innerHTML = "";
                if (certData.length === 0) {
                    certContainer.innerHTML = "<div class='text-[13px] text-gray-400 italic py-[8px]'>Chưa có chứng chỉ nào. Bấm '+ Thêm chứng chỉ' để bổ sung (AWS, IELTS, CKA, TOEIC...).</div>";
                    return;
                }
                certData.forEach(function(c, idx) {
                    var card = document.createElement("div");
                    card.className = "cert-card p-[12px] bg-amber-50/40 border border-amber-200/70 rounded-[8px] flex items-center justify-between gap-[10px]";
                    card.innerHTML = `
                        <div class="grid sm:grid-cols-3 grid-cols-1 gap-[8px] flex-1">
                            <input type="text" class="border border-gray-300 rounded-[4px] px-[8px] py-[5px] text-[13px] bg-white inp-cert-name" value="${esc(c.name || '')}" placeholder="Tên chứng chỉ (VD: AWS Solutions Architect)">
                            <input type="text" class="border border-gray-300 rounded-[4px] px-[8px] py-[5px] text-[13px] bg-white inp-cert-org" value="${esc(c.organization || '')}" placeholder="Tổ chức cấp (VD: Amazon Web Services)">
                            <input type="text" class="border border-gray-300 rounded-[4px] px-[8px] py-[5px] text-[13px] bg-white inp-cert-year" value="${esc(c.year || '')}" placeholder="Năm cấp (VD: 2025)">
                        </div>
                        <button type="button" class="btn-del-cert text-red-500 hover:text-red-700 text-[14px] p-[4px] cursor-pointer" data-idx="${idx}" title="Xóa chứng chỉ">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    `;
                    certContainer.appendChild(card);
                });

                bindCertEvents();
            }

            function bindCertEvents() {
                certContainer.querySelectorAll(".btn-del-cert").forEach(function(btn) {
                    btn.addEventListener("click", function() {
                        var idx = parseInt(btn.getAttribute("data-idx"), 10);
                        syncCertsFromDOM();
                        certData.splice(idx, 1);
                        renderCerts();
                    });
                });
            }

            function syncCertsFromDOM() {
                var cards = certContainer.querySelectorAll(".cert-card");
                certData = [];
                cards.forEach(function(card) {
                    certData.push({
                        name: card.querySelector(".inp-cert-name").value.trim(),
                        organization: card.querySelector(".inp-cert-org").value.trim(),
                        year: card.querySelector(".inp-cert-year").value.trim()
                    });
                });
                document.getElementById("certificatesJson").value = JSON.stringify(certData);
            }

            // Sự kiện Add
            document.getElementById("btnAddWork").addEventListener("click", function() {
                syncWorksFromDOM();
                workData.push({ company: "", position: "", startDate: "", endDate: "", isCurrent: false, description: "" });
                renderWorks();
            });

            document.getElementById("btnAddProject").addEventListener("click", function() {
                syncProjectsFromDOM();
                projectData.push({ name: "", role: "", techStack: "", link: "", description: "" });
                renderProjects();
            });

            document.getElementById("btnAddEdu").addEventListener("click", function() {
                syncEduFromDOM();
                eduData.push({ school: "", major: "", gradYear: "" });
                renderEdu();
            });

            document.getElementById("btnAddCert").addEventListener("click", function() {
                syncCertsFromDOM();
                certData.push({ name: "", organization: "", year: "" });
                renderCerts();
            });

            // Khi submit form, đồng bộ dữ liệu vào hidden inputs
            document.getElementById("formItProfile").addEventListener("submit", function() {
                syncWorksFromDOM();
                syncProjectsFromDOM();
                syncEduFromDOM();
                syncCertsFromDOM();
            });

            // Khởi tạo hiển thị ban đầu
            renderWorks();
            renderProjects();
            renderEdu();
            renderCerts();
        })();
