extends ../layouts/default.pug

block title
    title #{title || (about && about.title ? about.title + " - VN.ITJobs" : "Về chúng tôi - VN.ITJobs | Nền tảng tuyển dụng IT hàng đầu Việt Nam")}

block main
    //- Hero Header
    div(class="bg-[#000065] py-[40px] sm:py-[60px] text-white text-center")
        .contain
            h1(class="font-[800] text-[26px] sm:text-[38px] mb-[12px] leading-tight")= (about && about.title) || "Về chúng tôi - VN.ITJobs"
            p(class="text-white/80 text-[15px] sm:text-[18px] max-w-[760px] mx-auto")= (about && about.subtitle) || "Sứ mệnh kết nối tinh hoa công nghệ Việt Nam với các cơ hội nghề nghiệp bứt phá toàn cầu."

    //- Content Section
    div(class="py-[40px] sm:py-[60px] bg-white")
        div(class="max-w-[900px] mx-auto px-4 sm:px-6 leading-relaxed text-[#2D3748] text-[15px] sm:text-[16px] space-y-[32px]")
            section
                h2(class="font-[700] text-[22px] sm:text-[26px] text-[#121212] mb-[14px]") 1. Giới thiệu tổng quan về VN.ITJobs
                p(class="mb-[12px]")
                    = (about && about.overviewParagraph1) || "Được thành lập từ năm 2024, VN.ITJobs tự hào là nền tảng tuyển dụng công nghệ thông tin chuyên biệt và tiên phong tại Việt Nam. Chúng tôi xây dựng một hệ sinh thái việc làm số minh bạch, nơi các kỹ sư phần mềm, kiến trúc sư hệ thống, chuyên gia AI, DevOps và an toàn thông tin có thể tiếp cận những cơ hội nghề nghiệp xứng tầm."
                if about && about.overviewParagraph2
                    p
                        = about.overviewParagraph2

            section
                h2(class="font-[700] text-[22px] sm:text-[26px] text-[#121212] mb-[14px]") 2. Tầm nhìn và Sứ mệnh cốt lõi
                p(class="mb-[12px]")
                    strong(class="font-[700] text-gray-900") Tầm nhìn: 
                    = (about && about.vision) || "Trở thành trung tâm kết nối nhân tài công nghệ số 1 Đông Nam Á, hỗ trợ chuyển đổi số quốc gia và nâng cao vị thế của kỹ sư lập trình Việt Nam trên bản đồ công nghệ thế giới."
                p
                    strong(class="font-[700] text-gray-900") Sứ mệnh: 
                    = (about && about.mission) || "Giúp mọi lập trình viên tìm được công việc mơ ước với mức đãi ngộ xứng đáng, đồng thời hỗ trợ các doanh nghiệp công nghệ chiêu mộ đúng người, đúng thời điểm nhờ công nghệ trí tuệ nhân tạo (AI Matching) tiên tiến."

            section
                h2(class="font-[700] text-[22px] sm:text-[26px] text-[#121212] mb-[14px]") 3. Các con số ấn tượng
                div(class="grid sm:grid-cols-3 grid-cols-1 gap-[16px] my-[20px]")
                    div(class="p-[20px] bg-[#F8FAFC] border border-gray-100 rounded-[12px] text-center shadow-xs")
                        div(class="font-[800] text-[32px] text-[#0088FF]")= (about && about.statsJobs) || "880+"
                        div(class="text-[14px] text-gray-600 mt-[4px]")= (about && about.statsJobsLabel) || "Việc làm IT mở hàng ngày"
                    div(class="p-[20px] bg-[#F8FAFC] border border-gray-100 rounded-[12px] text-center shadow-xs")
                        div(class="font-[800] text-[32px] text-[#2E7D32]")= (about && about.statsCompanies) || "1.200+"
                        div(class="text-[14px] text-gray-600 mt-[4px]")= (about && about.statsCompaniesLabel) || "Doanh nghiệp công nghệ đối tác"
                    div(class="p-[20px] bg-[#F8FAFC] border border-gray-100 rounded-[12px] text-center shadow-xs")
                        div(class="font-[800] text-[32px] text-[#E65100]")= (about && about.statsCandidates) || "150.000+"
                        div(class="text-[14px] text-gray-600 mt-[4px]")= (about && about.statsCandidatesLabel) || "Kỹ sư IT tin tưởng sử dụng"

            section
                h2(class="font-[700] text-[22px] sm:text-[26px] text-[#121212] mb-[14px]") 4. Thông tin pháp lý & Trụ sở hoạt động
                if about && about.companyName
                    p(class="mb-[8px]")
                        strong(class="font-[700] text-gray-900") Pháp nhân: 
                        = about.companyName
                if about && about.businessCode
                    p(class="mb-[8px]")
                        strong(class="font-[700] text-gray-900") Giấy chứng nhận ĐKDN: 
                        = about.businessCode
                if about && about.headOffice
                    p(class="mb-[8px]")
                        strong(class="font-[700] text-gray-900") Trụ sở chính: 
                        = about.headOffice
                if about && about.branchOffice
                    p(class="mb-[8px]")
                        strong(class="font-[700] text-gray-900") Văn phòng đại diện: 
                        = about.branchOffice
                p(class="mb-[8px]")
                    strong(class="font-[700] text-gray-900") Email hỗ trợ: 
                    span= (about && about.email) || "contact@vn-itjobs.com"
                    span(class="mx-[8px] text-gray-400") |
                    strong(class="font-[700] text-gray-900") Hotline: 
                    span= (about && about.hotline) || "+84-24-3768-9999"
