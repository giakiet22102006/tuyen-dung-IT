extends ../layouts/default.pug

block title 
    title #{title || "Đổi mật khẩu"}

block main
    //- Đổi mật khẩu
    div(class="py-[60px]")
        .contain 
            div(class="border border-[#DEDEDE] rounded-[8px] py-[50px] px-[20px] max-w-[602px] mx-auto")
                h1(class="font-[700] text-[20px] text-center mb-[10px]") #{title || "Đổi mật khẩu"}

                if flash && flash.success
                    div(class="mb-[15px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mb-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}

                - const formAction = userRole === 'employer' ? '/employer/change-password' : '/candidate/change-password'
                form(action=formAction method="POST" class="mt-[20px]") 
                    input(type="hidden" name="_csrf" value=csrfToken)

                    div(class="")
                        label(for="currentPassword" class="font-[500] text-[14px]") Mật khẩu hiện tại *
                        input(type="password" id="currentPassword" name="currentPassword" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.currentPassword
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.currentPassword}

                    div(class="")
                        label(for="newPassword" class="font-[500] text-[14px]") Mật khẩu mới (ít nhất 8 ký tự, có chữ và số) *
                        input(type="password" id="newPassword" name="newPassword" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.newPassword
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.newPassword}

                    div(class="")
                        label(for="confirmPassword" class="font-[500] text-[14px]") Xác nhận mật khẩu mới *
                        input(type="password" id="confirmPassword" name="confirmPassword" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.confirmPassword
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.confirmPassword}

                    div(class="") 
                        button(type="submit" class="bg-[#0088FF] py-[14px] rounded-[4px] font-[700] text-[16px] text-white text-center w-full cursor-pointer") Cập nhật mật khẩu
    //- Hết Đổi mật khẩu
