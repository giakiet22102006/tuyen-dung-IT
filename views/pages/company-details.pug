extends ../layouts/default.pug
include ../mixins/job-card.pug

block title 
    title #{title || (company ? company.companyName : "Chi tiết công ty")}

block main
    //- Chi tiết công ty
    div(class="pt-[20px] sm:pt-[30px] pb-[40px] sm:pb-[60px]") 
        .contain 
            //- Thông tin công ty
            div(class="p-[16px] sm:p-[20px] border border-[#DEDEDE] rounded-[8px] bg-white")
                div(class="flex flex-col sm:flex-row items-start sm:items-center gap-[16px] mb-[20px]")
                    img(src=(company.logo && company.logo.url) ? company.logo.url : "/assets/images/demo/demo4.png" alt=company.companyName class="w-[80px] h-[80px] sm:w-[100px] sm:h-[100px] object-contain rounded-[4px] border border-[#DEDEDE] p-[4px]")
                    div(class="flex-1 min-w-0")
                        div(class="flex flex-wrap items-center gap-[10px] mb-[6px] sm:mb-[10px]")
                            div(class="font-[700] text-[22px] sm:text-[28px] text-[#121212]") #{company.companyName}
                            if avgRating
                                div(class="inline-flex items-center gap-[6px] bg-amber-50 border border-amber-200 px-[10px] py-[3px] rounded-full")
                                    span(class="text-amber-500 text-[13px]") <i class="fa-solid fa-star"></i>
                                    span(class="font-[700] text-[13px] text-amber-900") #{avgRating} / 5.0
                                    span(class="text-[12px] text-amber-700") (#{totalReviews} đánh giá)

                            //- Nút Theo Dõi Công Ty
                            button(id="followCompanyBtn" type="button" class=`sm:ml-auto inline-flex items-center gap-[8px] px-[16px] py-[8px] rounded-[20px] font-[600] text-[13px] sm:text-[14px] transition cursor-pointer border shadow-xs ${isFollowed ? 'bg-red-50 border-red-300 text-red-600' : 'bg-white border-gray-300 text-gray-700 hover:border-red-400 hover:text-red-500'}` data-id=company._id data-is-followed=(isFollowed ? 'true' : 'false') data-logged-in=(currentUser && role === 'candidate' ? 'true' : 'false'))
                                i(id="followIcon" class=`fa-solid fa-heart ${isFollowed ? 'text-red-500' : 'text-gray-400'}`)
                                span(id="followBtnText") #{isFollowed ? 'Đang theo dõi' : 'Theo dõi'}
                                span(class="bg-gray-100 text-gray-600 text-[12px] font-bold px-[7px] py-[1px] rounded-full ml-[2px]" id="followersCountBadge") #{followersCount || 0}
                        div(class="flex flex-wrap items-center gap-x-5 gap-y-2 font-[400] text-[13px] sm:text-[14px] text-gray-700") 
                            div(class="inline-flex items-center gap-1.5")
                                i(class="fa-solid fa-location-dot text-[14px] text-[#0088FF]")
                                span #{company.address || labels.getCityLabel(company.city)}
                            if company.email
                                a(href="mailto:" + company.email class="inline-flex items-center gap-1.5 hover:text-[#0088FF] transition-colors")
                                    i(class="fa-solid fa-envelope text-[14px] text-[#0088FF]")
                                    span #{company.email}
                            if company.phone
                                a(href="tel:" + company.phone class="inline-flex items-center gap-1.5 hover:text-[#0088FF] transition-colors")
                                    i(class="fa-solid fa-phone text-[14px] text-[#0088FF]")
                                    span #{company.phone}
                            if company.website
                                a(href=company.website target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-[#0088FF] transition-colors")
                                    i(class="fa-solid fa-globe text-[14px] text-[#0088FF]")
                                    span #{company.website}
 
                div(class="grid grid-cols-1 sm:grid-cols-2 gap-x-[20px] gap-y-[8px] border-t border-gray-100 pt-[16px]")
                    div(class="flex justify-between sm:justify-start gap-[8px]")
                        span(class="font-[400] text-[13px] sm:text-[15px] text-[#A6A6A6]") Email liên hệ:
                        if company.email
                            a(href="mailto:" + company.email class="font-[500] text-[13px] sm:text-[15px] text-[#0088FF] hover:underline") #{company.email}
                        else
                            span(class="font-[500] text-[13px] sm:text-[15px] text-[#717171]") Đang cập nhật
                    div(class="flex justify-between sm:justify-start gap-[8px]")
                        span(class="font-[400] text-[13px] sm:text-[15px] text-[#A6A6A6]") Số điện thoại:
                        if company.phone
                            a(href="tel:" + company.phone class="font-[500] text-[13px] sm:text-[15px] text-[#121212] hover:text-[#0088FF]") #{company.phone}
                        else
                            span(class="font-[500] text-[13px] sm:text-[15px] text-[#717171]") Đang cập nhật
                    div(class="flex justify-between sm:justify-start gap-[8px]")
                        span(class="font-[400] text-[13px] sm:text-[15px] text-[#A6A6A6]") Mô hình công ty:
                        span(class="font-[500] text-[13px] sm:text-[15px] text-[#121212]") #{company.companyModel || "Sản phẩm & Dịch vụ"}
                    div(class="flex justify-between sm:justify-start gap-[8px]")
                        span(class="font-[400] text-[13px] sm:text-[15px] text-[#A6A6A6]") Quy mô công ty:
                        span(class="font-[500] text-[13px] sm:text-[15px] text-[#121212]") #{company.companySize || "100 - 500 nhân viên"}
                    div(class="flex justify-between sm:justify-start gap-[8px]")
                        span(class="font-[400] text-[13px] sm:text-[15px] text-[#A6A6A6]") Thời gian làm việc:
                        span(class="font-[500] text-[13px] sm:text-[15px] text-[#121212]") #{company.workingTime || "Thứ 2 - Thứ 6"}
                    div(class="flex justify-between sm:justify-start gap-[8px]")
                        span(class="font-[400] text-[13px] sm:text-[15px] text-[#A6A6A6]") Làm việc ngoài giờ:
                        span(class="font-[500] text-[13px] sm:text-[15px] text-[#121212]") #{company.overtime || "Không có OT"}
            //- Hết Thông tin công ty

            //- Mô tả chi tiết
            if company.description
                div(class="border border-[#DEDEDE] rounded-[8px] p-[20px] mt-[20px]") 
                    div(class="prose max-w-none text-[#121212]") !{company.description}
            //- Hết Mô tả chi tiết

            //- Công việc
            div(class="mt-[30px]")
                h1(class="font-[700] text-[28px] text-[#121212] mb-[20px]") Công ty có #{jobs ? jobs.length : 0} việc làm
                div(class="grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-[20px]") 
                    if jobs && jobs.length > 0
                        each job in jobs
                            +jobCard(job)
                    else
                        div(class="col-span-full py-[30px] text-center text-[#717171] text-[16px]") Hiện tại công ty chưa có vị trí tuyển dụng mới.
            //- Hết Công việc

            //- ==========================================
            //- ĐÁNH GIÁ & NHẬN XÉT CÔNG TY
            //- ==========================================
            div(id="review-section" class="mt-[40px] pt-[30px] border-t border-gray-200")
                div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-[16px] mb-[24px]")
                    div
                        h2(class="font-[700] text-[24px] sm:text-[28px] text-[#121212]") Đánh giá về #{company.companyName}
                        p(class="text-[14px] text-gray-500 mt-[2px]") Tổng hợp nhận xét khách quan từ ứng viên và đối tác doanh nghiệp
                    if currentUser
                        a(href="#formWriteReview" class="inline-flex items-center gap-[6px] bg-[#0088FF] hover:bg-[#0070d6] text-white text-[14px] font-[600] px-[18px] py-[10px] rounded-[6px] shadow-xs cursor-pointer self-start sm:self-auto transition-colors")
                            <i class="fa-solid fa-pen-to-square"></i> Viết đánh giá
                    else
                        a(href="/auth/candidate/login?redirect=/companies/" + company.slug class="inline-flex items-center gap-[6px] bg-gray-100 hover:bg-gray-200 text-gray-700 text-[13px] font-[600] px-[16px] py-[8px] rounded-[6px] self-start sm:self-auto transition-colors")
                            <i class="fa-solid fa-right-to-bracket"></i> Đăng nhập để đánh giá

                //- Khối thống kê tổng quan đánh giá
                div(class="grid grid-cols-1 md:grid-cols-3 gap-[20px] p-[20px] bg-gray-50 rounded-[10px] border border-gray-200 mb-[30px]")
                    //- Điểm trung bình
                    div(class="flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-gray-200 pb-[16px] md:pb-0")
                        div(class="text-[44px] font-[900] text-gray-900 leading-none") #{avgRating || "0.0"}
                        div(class="flex items-center gap-[4px] text-amber-400 text-[18px] my-[6px]")
                            - var rounded = Math.round(avgRating || 0)
                            - for (var i = 1; i <= 5; i++)
                                if i <= rounded
                                    <i class="fa-solid fa-star"></i>
                                else
                                    <i class="fa-regular fa-star text-gray-300"></i>
                        div(class="text-[13px] text-gray-500 font-[500]") #{totalReviews || 0} lượt đánh giá

                    //- Phân bổ số sao
                    div(class="md:col-span-2 flex flex-col justify-center space-y-[6px]")
                        each star in [5, 4, 3, 2, 1]
                            - var count = (ratingCounts && ratingCounts[star]) || 0
                            - var percent = totalReviews > 0 ? Math.round((count / totalReviews) * 100) : 0
                            div(class="flex items-center gap-[10px] text-[13px]")
                                span(class="w-[45px] text-gray-600 font-[500]") #{star} sao
                                div(class="flex-1 h-[8px] bg-gray-200 rounded-full overflow-hidden")
                                    div(class="h-full bg-amber-400 rounded-full" style=`width: ${percent}%`)
                                span(class="w-[40px] text-right text-gray-500 text-[12px]") #{count}

                //- Danh sách các đánh giá
                div(class="space-y-[16px] mb-[40px]")
                    if reviews && reviews.length > 0
                        each r in reviews
                            div(class="p-[18px] sm:p-[20px] border border-gray-200 rounded-[8px] bg-white shadow-xs")
                                div(class="flex flex-wrap items-center justify-between gap-[10px] mb-[10px]")
                                    div(class="flex items-center gap-[10px]")
                                        div(class="w-[36px] h-[36px] rounded-full bg-blue-100 text-[#0088FF] font-[700] text-[14px] flex items-center justify-center")
                                            | #{r.authorName ? r.authorName.charAt(0).toUpperCase() : "U"}
                                        div
                                            div(class="font-[700] text-[15px] text-gray-900") #{r.authorName}
                                            div(class="flex items-center gap-[8px] text-[12px] text-gray-500")
                                                span(class="inline-block px-[6px] py-[1px] rounded text-[11px] font-[600] " + (r.authorRole === 'employer' ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-[#0088FF]"))
                                                    | #{r.authorRole === 'employer' ? "Đối tác DN" : "Ứng viên"}
                                                span •
                                                span #{labels.formatDate ? labels.formatDate(r.createdAt) : new Date(r.createdAt).toLocaleDateString('vi-VN')}
                                    div(class="flex items-center gap-[2px] text-amber-400 text-[14px]")
                                        - for (var s = 1; s <= 5; s++)
                                            if s <= r.rating
                                                <i class="fa-solid fa-star"></i>
                                            else
                                                <i class="fa-regular fa-star text-gray-300"></i>

                                div(class="font-[700] text-[16px] text-[#121212] mb-[8px]") #{r.title}

                                if r.pros
                                    div(class="mt-[8px] text-[14px] text-gray-700")
                                        span(class="font-[600] text-emerald-700 mr-[6px] inline-flex items-center gap-[4px]")
                                            <i class="fa-solid fa-circle-plus text-emerald-600"></i> Ưu điểm:
                                        span #{r.pros}

                                if r.cons
                                    div(class="mt-[6px] text-[14px] text-gray-700")
                                        span(class="font-[600] text-amber-700 mr-[6px] inline-flex items-center gap-[4px]")
                                            <i class="fa-solid fa-circle-minus text-amber-600"></i> Cần cải thiện:
                                        span #{r.cons}
                    else
                        div(class="py-[30px] text-center text-gray-500 bg-white border border-dashed border-gray-300 rounded-[8px]")
                            <i class="fa-regular fa-comment-dots text-[36px] text-gray-300 mb-[8px] block"></i>
                            p(class="text-[15px] font-[500]") Chưa có đánh giá nào cho công ty này.
                            p(class="text-[13px] text-gray-400 mt-[2px]") Hãy chia sẻ trải nghiệm thực tế để giúp cộng đồng IT có cái nhìn đa chiều!

                //- Form gửi đánh giá công ty
                div(id="formWriteReview" class="p-[20px] sm:p-[24px] border border-blue-200 rounded-[10px] bg-gradient-to-br from-blue-50/40 via-white to-gray-50 shadow-xs")
                    h3(class="font-[700] text-[18px] text-gray-900 mb-[4px] flex items-center gap-[8px]")
                        <i class="fa-solid fa-star text-amber-400"></i> Viết đánh giá của bạn
                    p(class="text-[13px] text-gray-500 mb-[16px]") Đánh giá công tâm và mang tính xây dựng sẽ giúp nâng tầm chất lượng tuyển dụng IT

                    if currentUser
                        form(action="/companies/" + company.slug + "/reviews" method="POST" class="space-y-[14px]")
                            input(type="hidden" name="_csrf" value=csrfToken)

                            div
                                label(class="block text-[14px] font-[600] text-gray-700 mb-[6px]") Mức độ hài lòng chung *
                                div(class="flex items-center gap-[12px]")
                                    each star in [5, 4, 3, 2, 1]
                                        label(class="inline-flex items-center gap-[4px] cursor-pointer text-[13px] font-[500] text-gray-700 hover:text-amber-500")
                                            input(type="radio" name="rating" value=star required checked=(star === 5) class="w-[16px] h-[16px] text-[#0088FF] cursor-pointer")
                                            span #{star} <i class="fa-solid fa-star text-amber-400 text-[12px]"></i>

                            div
                                label(for="reviewTitle" class="block text-[14px] font-[600] text-gray-700 mb-[4px]") Tiêu đề đánh giá *
                                input(type="text" id="reviewTitle" name="title" required placeholder="Ví dụ: Môi trường làm việc năng động, đãi ngộ tốt..." class="w-full border border-gray-300 rounded-[6px] px-[14px] py-[10px] text-[14px] bg-white")

                            div(class="grid sm:grid-cols-2 grid-cols-1 gap-[14px]")
                                div
                                    label(for="reviewPros" class="block text-[14px] font-[600] text-gray-700 mb-[4px] flex items-center gap-[6px]")
                                        <i class="fa-solid fa-circle-plus text-emerald-600"></i> Ưu điểm nổi bật
                                    textarea(id="reviewPros" name="pros" rows="3" placeholder="Ví dụ: Đồng nghiệp thân thiện, sếp tâm lý, dự án công nghệ mới..." class="w-full border border-gray-300 rounded-[6px] p-[10px] text-[13px] bg-white")
                                div
                                    label(for="reviewCons" class="block text-[14px] font-[600] text-gray-700 mb-[4px] flex items-center gap-[6px]")
                                        <i class="fa-solid fa-circle-minus text-amber-600"></i> Điểm cần cải thiện
                                    textarea(id="reviewCons" name="cons" rows="3" placeholder="Ví dụ: Quy trình bàn giao dự án nên tinh gọn hơn..." class="w-full border border-gray-300 rounded-[6px] p-[10px] text-[13px] bg-white")

                            div(class="flex items-center justify-between pt-[6px]")
                                div(class="text-[12px] text-gray-500")
                                    | Đánh giá với tư cách: <strong class="text-gray-800">#{currentUser.fullName || currentUser.companyName}</strong> (#{role === 'employer' ? 'Đối tác doanh nghiệp' : 'Ứng viên'})
                                button(type="submit" class="bg-[#0088FF] hover:bg-[#0070D2] text-white font-[700] text-[14px] px-[20px] py-[10px] rounded-[6px] cursor-pointer shadow-xs transition-colors")
                                    <i class="fa-solid fa-paper-plane mr-[6px]"></i> Gửi Đánh Giá
                    else
                        div(class="p-[16px] bg-white rounded-[8px] border border-gray-200 text-center")
                            p(class="text-[14px] text-gray-700 mb-[12px]") Bạn cần đăng nhập tài khoản Ứng viên hoặc Doanh nghiệp để chia sẻ đánh giá.
                            div(class="flex justify-center gap-[12px]")
                                a(href="/auth/candidate/login?redirect=/companies/" + company.slug class="bg-[#0088FF] text-white px-[16px] py-[8px] rounded-[6px] text-[13px] font-[600]") Đăng nhập Ứng viên
                                a(href="/auth/employer/login?redirect=/companies/" + company.slug class="bg-[#000071] text-white px-[16px] py-[8px] rounded-[6px] text-[13px] font-[600]") Đăng nhập Doanh nghiệp

    //- Script xử lý Theo Dõi Công Ty
    script.
        document.addEventListener('DOMContentLoaded', () => {
            const followBtn = document.getElementById('followCompanyBtn');
            if (!followBtn) return;

            followBtn.addEventListener('click', async () => {
                const isLoggedIn = followBtn.getAttribute('data-logged-in') === 'true';
                if (!isLoggedIn) {
                    if (confirm('Vui lòng đăng nhập với tài khoản Ứng viên để theo dõi công ty này. Chuyển đến trang đăng nhập?')) {
                        window.location.href = '/candidate/login?redirect=' + encodeURIComponent(window.location.pathname);
                    }
                    return;
                }

                const companyId = followBtn.getAttribute('data-id');
                const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

                try {
                    followBtn.disabled = true;
                    const res = await fetch(`/companies/${companyId}/follow`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'x-csrf-token': csrfToken
                        }
                    });
                    const data = await res.json();
                    if (data.success) {
                        const icon = document.getElementById('followIcon');
                        const text = document.getElementById('followBtnText');
                        const badge = document.getElementById('followersCountBadge');

                        if (data.followed) {
                            followBtn.classList.remove('bg-white', 'border-gray-300', 'text-gray-700');
                            followBtn.classList.add('bg-red-50', 'border-red-300', 'text-red-600');
                            icon.classList.remove('text-gray-400');
                            icon.classList.add('text-red-500');
                            text.textContent = 'Đang theo dõi';
                        } else {
                            followBtn.classList.add('bg-white', 'border-gray-300', 'text-gray-700');
                            followBtn.classList.remove('bg-red-50', 'border-red-300', 'text-red-600');
                            icon.classList.add('text-gray-400');
                            icon.classList.remove('text-red-500');
                            text.textContent = 'Theo dõi';
                        }
                        if (badge && data.followersCount !== undefined) {
                            badge.textContent = data.followersCount;
                        }
                    } else {
                        alert(data.message || 'Lỗi thao tác');
                    }
                } catch (err) {
                    alert('Lỗi kết nối máy chủ');
                } finally {
                    followBtn.disabled = false;
                }
            });
        });

    //- Hết Chi tiết công ty
