extends ../layouts/default.pug

block title 
    title #{title || (job ? job.title : "Chi tiết công việc")}

block main
    //- Chi tiết công việc
    div(class="pt-[30px] pb-[60px]")
        .contain 
            div(class="grid lg:grid-cols-[770fr_395fr] grid-cols-1 gap-[20px]")
                div(class="") 
                    //- Thông tin công việc
                    div(class="border border-[#DEDEDE] rounded-[8px] p-[20px]") 
                        h1(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] mb-[10px]") #{job.title}
                        div(class="font-[400] text-[16px] text-[#414042] mb-[10px]") #{company ? company.companyName : (job.employerId ? job.employerId.companyName : "")}
                        div(class="font-[700] text-[20px] text-[#0088FF] mb-[20px]") #{formatSalary(job.salaryMin, job.salaryMax)}
                        a(href="#boxApply" class="bg-[#0088FF] rounded-[4px] p-[14px] font-[700] text-[16px] text-white block text-center cursor-pointer") Ứng tuyển

                        //- AI Career Assist Actions
                        div(class="grid grid-cols-1 sm:grid-cols-2 gap-[10px] mt-[12px]")
                            button(type="button" id="btnOpenAiCvMatch" class="flex items-center justify-center gap-[8px] bg-[#059669] hover:bg-[#047857] text-white font-[600] text-[14px] py-[12px] px-[16px] rounded-[4px] cursor-pointer transition-all")
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                span ✨ AI So Khớp Độ Phù Hợp CV
                            button(type="button" id="btnOpenAiInterview" class="flex items-center justify-center gap-[8px] bg-[#4F46E5] hover:bg-[#4338CA] text-white font-[600] text-[14px] py-[12px] px-[16px] rounded-[4px] cursor-pointer transition-all")
                                <i class="fa-solid fa-comments"></i>
                                span 💡 Luyện Phỏng Vấn Với AI

                        if job.images && job.images.length > 0
                            div(class="grid grid-cols-3 gap-[16px] mt-[20px]") 
                                each imgItem, idx in job.images.slice(0, 3)
                                    img(src=imgItem.url alt=(job.title + " - Ảnh " + (idx + 1)) class="rounded-[4px] w-full h-[140px] sm:h-[180px] object-cover")

                        div(class="mt-[20px]")
                            div(class="font-[400] text-[14px] text-[#121212]") 
                                <i class="fa-solid fa-user-tie text-[16px] mr-[8px]"></i> #{labels.getPositionLabel(job.position)}
                            div(class="font-[400] text-[14px] text-[#121212] mt-[6px]") 
                                <i class="fa-solid fa-briefcase text-[16px] mr-[8px]"></i> #{labels.getWorkingFormLabel(job.workingForm)}
                            div(class="font-[400] text-[14px] text-[#121212] mt-[6px]") 
                                <i class="fa-solid fa-location-dot text-[16px] mr-[8px]"></i> #{job.address || labels.getCityLabel(job.city)}
                        
                        if job.skills && job.skills.length > 0
                            div(class="flex flex-wrap gap-[8px] mt-[10px]")
                                each sk in job.skills
                                    div(class="border border-[#DEDEDE] rounded-[20px] py-[6px] px-[16px] font-[400] text-[12px] text-[#414042]") #{sk.name}
                    //- Hết Thông tin công việc

                    //- Mô tả chi tiết
                    if job.description
                        div(class="border border-[#DEDEDE] rounded-[8px] p-[20px] mt-[20px]")
                            div(class="prose max-w-none text-[#121212]") !{job.description}
                    //- Hết Mô tả chi tiết

                    //- Form ứng tuyển
                    div(id="boxApply" class="border border-[#DEDEDE] rounded-[8px] p-[20px] mt-[20px]")
                        h2(class="font-[700] text-[20px] text-black mb-[20px]") Ứng tuyển ngay

                        if flash && flash.error
                            div(class="mb-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}
                        if flash && flash.success
                            div(class="mb-[15px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[4px] text-[14px]") #{flash.success}

                        form(action="/jobs/" + job.slug + "/apply" method="POST" enctype="multipart/form-data" class="grid gap-[15px]")
                            input(type="hidden" name="_csrf" value=csrfToken)

                            div(class="")
                                label(for="applyFullName" class="font-[500] text-[14px]") Họ tên *
                                input(type="text" id="applyFullName" name="fullName" value=(currentUser ? currentUser.fullName : "") required class="border border-[#DEDEDE] rounded-[4px] px-[20px] py-[12px] font-[500] text-[14px] text-black block w-full mt-[5px]")

                            div(class="")
                                label(for="applyEmail" class="font-[500] text-[14px]") Email *
                                input(type="email" id="applyEmail" name="email" value=(currentUser ? currentUser.email : "") required class="border border-[#DEDEDE] rounded-[4px] px-[20px] py-[12px] font-[500] text-[14px] text-black block w-full mt-[5px]")

                            div(class="")
                                label(for="applyPhone" class="font-[500] text-[14px]") Số điện thoại *
                                input(type="text" id="applyPhone" name="phone" value=(currentUser ? currentUser.phone : "") required class="border border-[#DEDEDE] rounded-[4px] px-[20px] py-[12px] font-[500] text-[14px] text-black block w-full mt-[5px]")

                            div(class="")
                                label(for="applyCv" class="font-[500] text-[14px]") File CV dạng PDF (tối đa 5MB) *
                                input(type="file" id="applyCv" name="cv" accept="application/pdf" required class="border border-[#DEDEDE] rounded-[4px] px-[20px] py-[12px] font-[500] text-[14px] text-black block w-full mt-[5px]")

                            div(class="")
                                button(type="submit" class="bg-[#0088FF] p-[14px] rounded-[4px] w-full font-[700] text-[16px] text-white text-center cursor-pointer") Gửi CV ứng tuyển
                    //- Hết Form ứng tuyển

                div(class="") 
                    //- Thông tin công ty
                    if company
                        div(class="p-[20px] border border-[#DEDEDE] rounded-[8px]")
                            div(class="flex gap-[12px] mb-[20px]")
                                img(src=(company.logo && company.logo.url) ? company.logo.url : "/assets/images/demo/demo4.png" alt=company.companyName class="w-[100px] h-[100px] object-contain rounded-[4px] border border-[#DEDEDE]")
                                div(class="flex-1")
                                    div(class="font-[700] text-[18px] text-[#121212] mb-[10px]") #{company.companyName}
                                    a(href="/companies/" + company.slug class="font-[400] text-[16px] text-[#0088FF]") Xem công ty <i class="fa-solid fa-arrow-right-long ml-[4px]"></i>

                            div(class="")
                                div(class="flex justify-between mb-[10px]")
                                    div(class="font-[400] text-[16px] text-[#A6A6A6]") Mô hình công ty
                                    div(class="font-[400] text-[16px] text-[#121212]") #{company.companyModel || "Sản phẩm & Dịch vụ"}
                                div(class="flex justify-between mb-[10px]")
                                    div(class="font-[400] text-[16px] text-[#A6A6A6]") Quy mô công ty
                                    div(class="font-[400] text-[16px] text-[#121212]") #{company.companySize || "100 - 500 nhân viên"}
                                div(class="flex justify-between mb-[10px]")
                                    div(class="font-[400] text-[16px] text-[#A6A6A6]") Thời gian làm việc
                                    div(class="font-[400] text-[16px] text-[#121212]") #{company.workingTime || "Thứ 2 - Thứ 6"}
                                div(class="flex justify-between")
                                    div(class="font-[400] text-[16px] text-[#A6A6A6]") Làm việc ngoài giờ
                                    div(class="font-[400] text-[16px] text-[#121212]") #{company.overtime || "Không có OT"}
                    //- Hết Thông tin công ty

        //- ==========================================
        //- MODAL 1: AI SO KHỚP CV & KHOẢNG TRỐNG KỸ NĂNG
        //- ==========================================
        div(id="modalAiCvMatch" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px]")
            div(class="bg-white rounded-[12px] shadow-2xl max-w-[650px] w-full max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn")
                //- Modal Header
                div(class="p-[20px] border-b border-[#E5E7EB] flex items-center justify-between bg-gradient-to-r from-emerald-50 to-teal-50")
                    div(class="flex items-center gap-[10px]")
                        div(class="w-[36px] h-[36px] rounded-full bg-emerald-600 text-white flex items-center justify-center")
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        div
                            h3(class="font-[700] text-[17px] text-[#111827]") AI Phân Tích Độ Phù Hợp CV
                            p(class="text-[12px] text-[#6B7280]") So khớp kỹ năng, kinh nghiệm với yêu cầu của #{job.title}
                    button(type="button" id="btnCloseAiCvMatch" class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                        <i class="fa-solid fa-xmark"></i>

                //- Modal Body
                div(class="p-[24px] overflow-y-auto flex-1")
                    //- Form nộp CV để phân tích
                    form(id="formAiCvMatch" class="space-y-[16px]")
                        div
                            label(class="block font-[600] text-[14px] text-gray-800 mb-[6px]") Cách 1: Tải lên file CV PDF của bạn
                            input(type="file" id="aiCvFileInput" accept="application/pdf" class="border border-dashed border-[#D1D5DB] rounded-[8px] p-[16px] w-full text-[14px] text-gray-600 bg-gray-50 hover:bg-gray-100 cursor-pointer")
                        
                        div(class="text-center text-[12px] text-gray-400 font-[600]") — HOẶC —

                        div
                            label(class="block font-[600] text-[14px] text-gray-800 mb-[6px]") Cách 2: Dán văn bản tóm tắt CV / Kinh nghiệm
                            textarea(id="aiCvTextInput" rows="4" placeholder="Ví dụ: 3 năm kinh nghiệm lập trình NodeJS, ReactJS, MongoDB, RESTful API, Docker, AWS..." class="border border-[#D1D5DB] rounded-[8px] p-[12px] w-full text-[14px]")

                        button(type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-[700] py-[12px] px-[20px] rounded-[6px] text-[15px] cursor-pointer transition-colors shadow-sm")
                            <i class="fa-solid fa-bolt mr-[6px]"></i> Bắt đầu phân tích với AI

                    //- Trạng thái đang tải AI
                    div(id="aiCvMatchLoading" class="hidden py-[40px] text-center space-y-[12px]")
                        div(class="inline-block animate-spin text-emerald-600 text-[36px]")
                            <i class="fa-solid fa-circle-notch"></i>
                        p(class="font-[600] text-[16px] text-gray-800") 🤖 AI đang phân tích CV của bạn...
                        p(class="text-[13px] text-gray-500 max-w-[360px] mx-auto") Quá trình này so khớp toàn diện kỹ năng, kinh nghiệm và khoảng trống kiến thức so với yêu cầu tuyển dụng.

                    //- Kết quả phân tích AI
                    div(id="aiCvMatchResult" class="hidden space-y-[20px]")
                        div(class="bg-emerald-50/60 border border-emerald-200 rounded-[10px] p-[20px] flex items-center justify-between")
                            div
                                p(class="text-[13px] font-[600] text-emerald-800 uppercase tracking-wide") Điểm phù hợp ước tính
                                p(id="aiMatchSummary" class="text-[14px] text-gray-700 mt-[6px] leading-relaxed")
                            div(class="text-right shrink-0 ml-[16px]")
                                span(id="aiMatchScore" class="text-4xl font-black text-emerald-600") 85%
                                p(class="text-[11px] font-[500] text-gray-500 mt-[2px]") Phù hợp

                        div
                            h4(class="font-[700] text-[14px] text-gray-900 mb-[8px] flex items-center gap-[6px]")
                                <i class="fa-solid fa-circle-check text-emerald-600"></i>
                                span Kỹ năng bạn đã đáp ứng (Matched Skills)
                            div(id="aiMatchedSkills" class="flex flex-wrap gap-[6px]")

                        div
                            h4(class="font-[700] text-[14px] text-gray-900 mb-[8px] flex items-center gap-[6px]")
                                <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
                                span Kỹ năng nên bổ sung thêm (Skill Gaps)
                            div(id="aiMissingSkills" class="flex flex-wrap gap-[6px]")

                        div
                            h4(class="font-[700] text-[14px] text-gray-900 mb-[8px] flex items-center gap-[6px]")
                                <i class="fa-solid fa-lightbulb text-amber-500"></i>
                                span Lời khuyên tối ưu CV & Phỏng vấn
                            ul(id="aiMatchAdvice" class="space-y-[8px] bg-gray-50 p-[16px] rounded-[8px] border border-gray-200")

                        div(class="pt-[10px] flex justify-end")
                            button(type="button" id="btnResetAiCvMatch" class="text-[13px] text-gray-600 hover:text-gray-900 underline cursor-pointer") Phân tích lại với CV khác

        //- ==========================================
        //- MODAL 2: AI LUYỆN PHỎNG VẤN
        //- ==========================================
        div(id="modalAiInterview" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-[16px]")
            div(class="bg-white rounded-[12px] shadow-2xl max-w-[750px] w-full max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn")
                //- Modal Header
                div(class="p-[20px] border-b border-[#E5E7EB] flex items-center justify-between bg-gradient-to-r from-indigo-50 to-blue-50")
                    div(class="flex items-center gap-[10px]")
                        div(class="w-[36px] h-[36px] rounded-full bg-indigo-600 text-white flex items-center justify-center")
                            <i class="fa-solid fa-comments"></i>
                        div
                            h3(class="font-[700] text-[17px] text-[#111827]") Luyện Phỏng Vấn Với Trợ Lý AI
                            p(class="text-[12px] text-[#6B7280]") 7 câu hỏi phỏng vấn thực chiến chuyên sâu cho vị trí #{job.title}
                    button(type="button" id="btnCloseAiInterview" class="text-gray-400 hover:text-gray-600 text-[20px] p-[4px] cursor-pointer")
                        <i class="fa-solid fa-xmark"></i>

                //- Modal Body
                div(class="p-[24px] overflow-y-auto flex-1 space-y-[16px]")
                    div(id="aiInterviewLoading" class="py-[40px] text-center space-y-[12px]")
                        div(class="inline-block animate-spin text-indigo-600 text-[36px]")
                            <i class="fa-solid fa-circle-notch"></i>
                        p(class="font-[600] text-[16px] text-gray-800") 🤖 AI đang tạo bộ câu hỏi phỏng vấn cá nhân hóa...
                        p(class="text-[13px] text-gray-500 max-w-[360px] mx-auto") Phân tích chuyên môn kỹ thuật và tình huống phù hợp với cấp bậc #{labels.getPositionLabel(job.position)}.

                    div(id="aiInterviewQuestions" class="space-y-[16px]")

    script.
        (function() {
            function runInit() {
                if (window.initAiCvMatch) window.initAiCvMatch("#{job._id}");
                if (window.initAiInterviewPrep) window.initAiInterviewPrep("#{job._id}");
            }
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", runInit);
            } else {
                runInit();
            }
        })();
    //- Hết Chi tiết công việc
