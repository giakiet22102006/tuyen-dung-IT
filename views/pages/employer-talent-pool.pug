extends ../layouts/default.pug

block title 
    title #{title || "Săn Ứng Viên IT & Kho Hồ Sơ (Talent Pool) - VN.ITJobs"}

block main
    div(class="py-[30px] sm:py-[50px] bg-[#F8FAFC] min-h-screen")
        div(class="w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8")
            
            //- Breadcrumb & Header
            div(class="flex flex-col md:flex-row md:items-center justify-between gap-[16px] mb-[24px]")
                div
                    div(class="inline-flex items-center gap-[6px] text-[12px] font-[700] uppercase tracking-wider text-[#0088FF] mb-[4px]")
                        <i class="fa-solid fa-users-viewfinder"></i>
                        span Headhunting & Talent Pool
                    h1(class="font-[800] text-[22px] sm:text-[28px] text-[#000065] tracking-tight") Săn Ứng Viên IT Tiềm Năng
                    p(class="text-[14px] text-gray-500 mt-[2px]") Khám phá hồ sơ IT chất lượng cao, đang chủ động tìm kiếm cơ hội và sẵn sàng nhận lời mời phỏng vấn.

                div(class="flex items-center gap-[10px]")
                    a(href="/employer/pipeline" class="inline-flex items-center gap-[8px] bg-white border border-gray-200 hover:border-[#0088FF] text-gray-700 font-[600] text-[13.5px] px-[16px] py-[10px] rounded-[8px] shadow-xs transition-all")
                        <i class="fa-solid fa-table-columns text-[#0088FF]"></i>
                        span Hiring Pipeline
                    a(href="/employer/jobs/create" class="inline-flex items-center gap-[8px] bg-[#0088FF] hover:bg-[#0070d6] text-white font-[700] text-[13.5px] px-[18px] py-[10px] rounded-[8px] shadow-sm transition-all")
                        <i class="fa-solid fa-plus"></i>
                        span Đăng Tin Tuyển Mới

            //- Flash messages
            if flash && flash.success
                div(class="mb-[20px] p-[14px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[8px] text-[14px] font-[500] flex items-center gap-[8px]")
                    <i class="fa-solid fa-circle-check"></i>
                    span #{flash.success}
            if flash && flash.error
                div(class="mb-[20px] p-[14px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[8px] text-[14px] font-[500] flex items-center gap-[8px]")
                    <i class="fa-solid fa-circle-exclamation"></i>
                    span #{flash.error}

            //- Bộ lọc nâng cao (Search & Filter Bar)
            div(class="bg-white p-[18px] sm:p-[24px] rounded-[14px] border border-gray-200 shadow-xs mb-[28px]")
                form(action="/employer/candidates" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-[14px]")
                    div(class="lg:col-span-4")
                        label(class="block text-[12px] font-[700] uppercase tracking-wider text-gray-600 mb-[6px]") Từ khóa tìm kiếm
                        div(class="relative")
                            input(type="text" name="keyword" value=keyword placeholder="Tìm theo tên, chức danh (Frontend, DevOps...)" class="w-full h-[42px] px-[14px] pl-[38px] rounded-[8px] border border-gray-300 font-[500] text-[14px] text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0088FF]")
                            <i class="fa-solid fa-magnifying-glass absolute left-[12px] top-1/2 -translate-y-1/2 text-gray-400 text-[14px]"></i>

                    div(class="lg:col-span-2")
                        label(class="block text-[12px] font-[700] uppercase tracking-wider text-gray-600 mb-[6px]") Cấp bậc
                        select(name="level" class="w-full h-[42px] px-[12px] rounded-[8px] border border-gray-300 font-[500] text-[14px] text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0088FF] bg-white cursor-pointer")
                            option(value="") Tất cả cấp bậc
                            each pos in positions
                                option(value=pos.value selected=(selectedLevel === pos.value)) #{pos.label}

                    div(class="lg:col-span-2")
                        label(class="block text-[12px] font-[700] uppercase tracking-wider text-gray-600 mb-[6px]") Thành phố
                        select(name="city" class="w-full h-[42px] px-[12px] rounded-[8px] border border-gray-300 font-[500] text-[14px] text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0088FF] bg-white cursor-pointer")
                            option(value="") Tất cả thành phố
                            each c in cities
                                option(value=c.value selected=(selectedCity === c.value)) #{c.label}

                    div(class="lg:col-span-2")
                        label(class="block text-[12px] font-[700] uppercase tracking-wider text-gray-600 mb-[6px]") Kỹ năng cốt lõi
                        input(type="text" name="skill" value=selectedSkill placeholder="VD: ReactJS, NodeJS" class="w-full h-[42px] px-[12px] rounded-[8px] border border-gray-300 font-[500] text-[14px] text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0088FF]")

                    div(class="lg:col-span-2 flex items-end")
                        button(type="submit" class="w-full h-[42px] bg-[#000065] hover:bg-[#000085] text-white font-[700] text-[14px] rounded-[8px] flex items-center justify-center gap-[6px] transition-colors cursor-pointer shadow-sm")
                            <i class="fa-solid fa-filter"></i>
                            span Lọc Hồ Sơ

            //- Danh sách ứng viên (Candidate Cards Grid)
            div(class="flex items-center justify-between mb-[16px]")
                div(class="text-[14px] text-gray-600 font-[600]")
                    | Tìm thấy <span class="text-[#0088FF] font-[800]">#{pagination.totalItems}</span> ứng viên IT phù hợp tiêu chí
                div(class="flex items-center gap-[8px] text-[12px] text-gray-500")
                    <i class="fa-solid fa-bolt text-emerald-500"></i>
                    span Đang sẵn sàng nhận việc (Open to work)

            if candidates && candidates.length > 0
                div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]")
                    each cand in candidates
                        - const it = cand.itProfile || {}
                        div(class="bg-white rounded-[14px] border border-gray-200 hover:border-[#0088FF] hover:shadow-lg transition-all p-[20px] flex flex-col justify-between group")
                            div
                                div(class="flex items-start justify-between gap-[12px] mb-[14px]")
                                    div(class="flex items-center gap-[12px]")
                                        div(class="w-[50px] h-[50px] rounded-full overflow-hidden bg-gray-100 border border-gray-200 shrink-0 flex items-center justify-center")
                                            if cand.avatar && cand.avatar.url
                                                img(src=cand.avatar.url alt=cand.fullName class="w-full h-full object-cover")
                                            else
                                                div(class="w-full h-full bg-gradient-to-br from-[#0088FF] to-[#000065] text-white flex items-center justify-center font-[800] text-[18px]") #{cand.fullName.charAt(0).toUpperCase()}
                                        div
                                            h3(class="font-[800] text-[16px] text-gray-900 group-hover:text-[#0088FF] transition-colors line-clamp-1") #{cand.fullName}
                                            div(class="text-[13px] font-[600] text-[#0088FF] line-clamp-1") #{it.title || "Lập trình viên IT"}
                                            div(class="text-[11.5px] text-gray-500 flex items-center gap-[6px] mt-[1px]")
                                                span(class="font-[600] uppercase text-[#64748B]") #{it.level || 'junior'}
                                                span •
                                                span #{it.yearsOfExperience || 0} năm kinh nghiệm
                                    
                                    span(class="inline-flex items-center gap-[4px] px-[8px] py-[3px] rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-[700] shrink-0")
                                        <i class="fa-solid fa-circle text-[6px] text-emerald-500 animate-pulse"></i>
                                        span Sẵn sàng

                                if it.bio
                                    p(class="text-[13px] text-gray-600 line-clamp-2 mb-[14px] leading-relaxed italic bg-gray-50/70 p-[8px] rounded-[6px]") "#{it.bio}"

                                //- Kỹ năng chuyên môn
                                if it.skills && it.skills.length > 0
                                    div(class="mb-[16px]")
                                        div(class="text-[11px] font-[700] uppercase text-gray-400 tracking-wider mb-[6px]") Kỹ năng chính
                                        div(class="flex flex-wrap gap-[6px]")
                                            each sk in it.skills.slice(0, 5)
                                                span(class="bg-blue-50 text-[#0066CC] border border-blue-100 text-[11.5px] font-[600] px-[8px] py-[2px] rounded-[6px]") #{sk}
                                            if it.skills.length > 5
                                                span(class="bg-gray-100 text-gray-600 text-[11px] font-[600] px-[6px] py-[2px] rounded-[6px]") +#{it.skills.length - 5}

                            //- Footer Card: Nút mời ứng tuyển
                            div(class="pt-[14px] border-t border-gray-100 flex items-center justify-between gap-[8px]")
                                div(class="text-[12px] text-gray-500 flex items-center gap-[4px]")
                                    <i class="fa-solid fa-location-dot text-gray-400"></i>
                                    span #{labels.getCityLabel(it.preferredCity || 'ha-noi')}
                                
                                button(type="button" onclick=`openInviteModal('${cand._id}', '${cand.fullName}')` class="inline-flex items-center gap-[6px] bg-[#0088FF] hover:bg-[#0070d6] text-white font-[700] text-[13px] px-[14px] py-[8px] rounded-[8px] transition-all cursor-pointer shadow-xs")
                                    <i class="fa-solid fa-paper-plane text-[11px]"></i>
                                    span Mời Ứng Tuyển

                //- Phân trang
                if pagination.totalPages > 1
                    div(class="flex items-center justify-center gap-[6px] mt-[36px]")
                        if pagination.hasPrevPage
                            a(href=`/employer/candidates?page=${pagination.prevPage}&keyword=${keyword}&level=${selectedLevel}&city=${selectedCity}&skill=${selectedSkill}` class="px-[14px] py-[8px] rounded-[6px] border border-gray-200 bg-white hover:bg-gray-50 text-[13px] font-[600] text-gray-700") Trước
                        
                        each p in Array.from({length: pagination.totalPages}, (_, i) => i + 1)
                            if p === pagination.currentPage
                                span(class="px-[14px] py-[8px] rounded-[6px] bg-[#0088FF] text-white text-[13px] font-[700]") #{p}
                            else
                                a(href=`/employer/candidates?page=${p}&keyword=${keyword}&level=${selectedLevel}&city=${selectedCity}&skill=${selectedSkill}` class="px-[14px] py-[8px] rounded-[6px] border border-gray-200 bg-white hover:bg-gray-50 text-[13px] font-[600] text-gray-700") #{p}
                        
                        if pagination.hasNextPage
                            a(href=`/employer/candidates?page=${pagination.nextPage}&keyword=${keyword}&level=${selectedLevel}&city=${selectedCity}&skill=${selectedSkill}` class="px-[14px] py-[8px] rounded-[6px] border border-gray-200 bg-white hover:bg-gray-50 text-[13px] font-[600] text-gray-700") Sau
            else
                div(class="bg-white rounded-[14px] border border-gray-200 p-[48px] text-center max-w-[560px] mx-auto")
                    div(class="w-[64px] h-[64px] rounded-full bg-blue-50 text-[#0088FF] flex items-center justify-center text-[24px] mx-auto mb-[16px]")
                        <i class="fa-solid fa-user-slash"></i>
                    h3(class="font-[700] text-[18px] text-gray-900 mb-[6px]") Không tìm thấy ứng viên phù hợp
                    p(class="text-[14px] text-gray-500 mb-[20px]") Hãy thử nới lỏng các bộ lọc kỹ năng, cấp bậc hoặc tìm kiếm bằng từ khóa tổng quát hơn.
                    a(href="/employer/candidates" class="inline-flex items-center gap-[8px] bg-[#0088FF] text-white font-[600] text-[14px] px-[20px] py-[10px] rounded-[8px]")
                        <i class="fa-solid fa-arrows-rotate"></i>
                        span Đặt lại bộ lọc

    //- Modal Mời Ứng Tuyển (Invite Modal)
    div(id="inviteCandidateModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs items-center justify-center p-[16px]")
        div(class="bg-white rounded-[16px] shadow-2xl border border-gray-100 max-w-[520px] w-full overflow-hidden text-left animate-in fade-in zoom-in-95 duration-200")
            div(class="bg-[#000065] p-[18px] sm:p-[20px] text-white flex items-center justify-between")
                div(class="flex items-center gap-[10px]")
                    div(class="w-[36px] h-[36px] rounded-full bg-white/10 flex items-center justify-center text-[16px]")
                        <i class="fa-solid fa-envelope-open-text text-[#9FDB7C]"></i>
                    div
                        h3(class="font-[700] text-[16px]") Mời Ứng Viên Ứng Tuyển
                        p(id="modalCandidateName" class="text-[12px] text-white/80") Ứng viên: Lê Văn A
                button(type="button" onclick="closeInviteModal()" class="text-white/80 hover:text-white p-[6px] rounded cursor-pointer")
                    <i class="fa-solid fa-xmark text-[18px]"></i>

            form(id="inviteCandidateForm" method="POST" action="" class="p-[20px] sm:p-[24px] space-y-[16px]")
                input(type="hidden" name="_csrf" value=csrfToken)
                
                div
                    label(class="block text-[13px] font-[700] text-gray-700 mb-[6px]") Chọn vị trí đang tuyển dụng <span class="text-red-500">*</span>
                    if activeJobs && activeJobs.length > 0
                        select(name="jobId" required class="w-full h-[42px] px-[12px] rounded-[8px] border border-gray-300 font-[500] text-[14px] text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0088FF] bg-white cursor-pointer")
                            each j in activeJobs
                                option(value=j._id) #{j.title}
                    else
                        div(class="p-[12px] bg-amber-50 border border-amber-200 text-amber-800 rounded-[8px] text-[13px]")
                            | Hiện bạn chưa có tin tuyển dụng nào đang hiển thị. Hãy <a href="/employer/jobs/create" class="text-[#0088FF] underline font-[600]">đăng tin mới</a> trước khi mời ứng viên.

                div
                    label(class="block text-[13px] font-[700] text-gray-700 mb-[6px]") Lời nhắn gửi tới ứng viên
                    textarea(name="message" rows="4" placeholder="VD: Công ty chúng tôi rất ấn tượng với profile của bạn và nhận thấy bạn rất phù hợp với dự án Fintech sắp tới..." class="w-full p-[12px] rounded-[8px] border border-gray-300 font-[400] text-[14px] text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#0088FF]")
                
                div(class="flex items-center justify-end gap-[10px] pt-[10px] border-t border-gray-100")
                    button(type="button" onclick="closeInviteModal()" class="px-[18px] py-[10px] rounded-[8px] border border-gray-300 text-gray-700 font-[600] text-[13.5px] hover:bg-gray-50 transition cursor-pointer") Hủy
                    if activeJobs && activeJobs.length > 0
                        button(type="submit" class="px-[22px] py-[10px] rounded-[8px] bg-[#0088FF] hover:bg-[#0070d6] text-white font-[700] text-[13.5px] shadow-sm transition cursor-pointer flex items-center gap-[6px]")
                            <i class="fa-solid fa-paper-plane"></i>
                            span Gửi Lời Mời

    script.
        function openInviteModal(candidateId, candidateName) {
            const modal = document.getElementById('inviteCandidateModal');
            const form = document.getElementById('inviteCandidateForm');
            const nameEl = document.getElementById('modalCandidateName');
            if (modal && form) {
                form.action = `/employer/candidates/${candidateId}/invite`;
                if (nameEl) nameEl.textContent = `Ứng viên: ${candidateName}`;
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }
        function closeInviteModal() {
            const modal = document.getElementById('inviteCandidateModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }
