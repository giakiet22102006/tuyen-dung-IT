extends ../layouts/default.pug

block title 
    title #{title || "Việc làm đã lưu - VN.ITJobs"}

block main
    div(class="py-[35px] sm:py-[60px]") 
        .contain 
            div
                div(class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-[24px] gap-[12px]")
                    div
                        h1(class="font-[700] text-[20px] sm:text-[28px] text-[#121212]") Việc làm đã lưu
                        p(class="text-[13px] sm:text-[14px] text-gray-500 mt-[2px]") Danh sách các cơ hội nghề nghiệp bạn đang theo dõi và cân nhắc ứng tuyển

                    a(href="/search" class="inline-flex items-center gap-[6px] text-[13px] sm:text-[14px] font-[600] text-[#0088FF] hover:underline")
                        <i class="fa-solid fa-magnifying-glass"></i>
                        span Khám phá thêm việc làm

                if flash && flash.success
                    div(class="mb-[20px] p-[12px] bg-[#E8F5E9] border border-[#A5D6A7] text-[#2E7D32] rounded-[6px] text-[14px]") #{flash.success}
                if flash && flash.error
                    div(class="mb-[20px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[6px] text-[14px]") #{flash.error}

                if savedJobs && savedJobs.length > 0
                    div(class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-[20px]")
                        each item in savedJobs
                            - var job = item.job
                            if job
                                div(class="card-item p-[16px] sm:p-[20px] hover:shadow-md transition-shadow relative flex flex-col justify-between")
                                    img(src="/assets/images/bg-card.png" class="inner-bg")
                                    
                                    //- Nút bỏ lưu nhanh
                                    form(action="/candidate/saved-jobs/" + item._id + "/remove" method="POST" class="absolute top-[14px] right-[14px] z-10")
                                        input(type="hidden" name="_csrf" value=csrfToken)
                                        button(type="submit" title="Bỏ lưu công việc này" class="w-[32px] h-[32px] rounded-full bg-red-50 hover:bg-red-100 text-red-500 flex items-center justify-center cursor-pointer transition shadow-2xs")
                                            <i class="fa-solid fa-bookmark text-[14px]"></i>

                                    div
                                        div(class="inner-img w-[80px] sm:w-[96px] mx-auto mb-[12px]")
                                            img(src=(job.employerId && job.employerId.logo && job.employerId.logo.url) ? job.employerId.logo.url : "/assets/images/demo/image1.png" alt=(job.employerId ? job.employerId.companyName : "Company Logo") class="w-full h-auto object-contain rounded-[6px]")
                                        
                                        a(href="/jobs/" + job.slug class="font-[700] text-[17px] text-[#121212] text-center line-clamp-[2] hover:text-[#0088FF] block transition-colors") #{job.title}
                                        div(class="mt-[6px] font-[500] text-[13px] text-gray-600 text-center truncate") #{job.employerId ? job.employerId.companyName : "Công ty ẩn danh"}
                                        div(class="font-[700] text-[16px] text-[#0088FF] text-center mt-[6px]") #{formatSalary(job.salaryMin, job.salaryMax)}
                                        
                                        div(class="flex flex-wrap justify-center gap-x-[10px] gap-y-[4px] text-[12px] text-gray-500 mt-[8px]")
                                            span: <i class="fa-solid fa-user-tie mr-[4px]"></i> #{labels.getPositionLabel(job.position)}
                                            span: <i class="fa-solid fa-briefcase mr-[4px]"></i> #{labels.getWorkingFormLabel(job.workingForm)}
                                            span: <i class="fa-solid fa-location-dot mr-[4px]"></i> #{labels.getCityLabel(job.city)}

                                        if job.benefits && job.benefits.length > 0
                                            div(class="mt-[8px] flex justify-center items-center flex-wrap gap-[4px]")
                                                each b in job.benefits.slice(0, 2)
                                                    span(class="inline-flex items-center gap-[3px] text-[11px] font-[600] text-emerald-700 bg-emerald-50 border border-emerald-200 px-[8px] py-[2px] rounded-full")
                                                        <i class="fa-solid fa-check text-[10px]"></i> #{labels.getBenefitLabel(b)}
                                                if job.benefits.length > 2
                                                    span(class="text-[10px] text-gray-500 font-[500]") +#{job.benefits.length - 2} đãi ngộ

                                        if !item.isAvailable
                                            div(class="mt-[10px] p-[6px] bg-amber-50 border border-amber-200 rounded-[4px] text-amber-800 text-[12px] text-center font-[500]")
                                                <i class="fa-solid fa-triangle-exclamation mr-[4px]"></i> Việc làm này hiện đã ngừng tuyển

                                    div(class="pt-[14px] mt-[14px] border-t border-gray-100 flex items-center justify-between gap-[8px]")
                                        span(class="text-[11px] text-gray-400") Đã lưu: #{formatDate(item.savedAt)}
                                        if item.isAvailable
                                            a(href="/jobs/" + job.slug class="bg-[#0088FF] hover:bg-[#0070d6] text-white rounded-[6px] py-[6px] px-[14px] text-[12px] font-[600] shadow-2xs inline-flex items-center gap-[4px] transition-colors")
                                                span Ứng tuyển
                                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                        else
                                            button(disabled class="bg-gray-200 text-gray-500 rounded-[6px] py-[6px] px-[14px] text-[12px] font-[600] cursor-not-allowed") Đã đóng
                    
                    if pagination && pagination.totalPages > 1
                        div(class="mt-[30px]")
                            select(class="pagination-select border border-[#DEDEDE] rounded-[8px] py-[10px] px-[16px] font-[400] text-[14px] text-[#414042] cursor-pointer")
                                - for (let i = 1; i <= pagination.totalPages; i++)
                                    option(value=i selected=(pagination.currentPage === i)) Trang #{i}
                else
                    div(class="py-[60px] text-center bg-white rounded-[10px] border border-gray-200 p-[30px]")
                        div(class="w-[64px] h-[64px] rounded-full bg-blue-50 text-[#0088FF] flex items-center justify-center text-[28px] mx-auto mb-[14px]")
                            <i class="fa-regular fa-bookmark"></i>
                        h3(class="text-[18px] font-[700] text-gray-800 mb-[6px]") Bạn chưa lưu việc làm nào
                        p(class="text-[14px] text-gray-500 max-w-[450px] mx-auto mb-[20px]") Khi tìm thấy công việc ưng ý nhưng chưa sẵn sàng nộp CV, hãy bấm biểu tượng Lưu để xem lại tại đây bất cứ lúc nào!
                        a(href="/search" class="inline-flex items-center gap-[6px] bg-[#0088FF] hover:bg-[#0070d6] text-white px-[20px] py-[10px] rounded-[6px] text-[14px] font-[600] shadow-xs")
                            <i class="fa-solid fa-magnifying-glass"></i>
                            span Khám Phá Việc Làm IT Ngay
