extends ../layouts/default.pug
include ../mixins/company-card.pug

block title 
    title #{title || "Danh sách công ty"}

block main
    //- Danh sách công ty
    div(class="py-[60px]")
        .contain
            h1(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] text-center mb-[30px]") Danh sách công ty
            div(class="grid lg:grid-cols-3 grid-cols-2 sm:gap-x-[20px] gap-x-[10px] gap-y-[20px]")
                if employers && employers.length > 0
                    each emp in employers
                        +companyCard(emp)
                else
                    div(class="col-span-full py-[40px] text-center text-[#717171] text-[16px]") Chưa có thông tin công ty nào.

            if pagination && pagination.totalPages > 1
                nav(class="mt-[36px] flex items-center justify-center gap-[8px] flex-wrap" aria-label="Phân trang")
                    if pagination.currentPage > 1
                        a(href=`?page=${pagination.currentPage - 1}` class="px-[14px] py-[8px] rounded-[8px] border border-[#DEDEDE] bg-white hover:border-[#0088FF] hover:text-[#0088FF] text-[#414042] text-[14px] font-[500] transition-colors")
                            i(class="fa-solid fa-chevron-left text-[12px] mr-[4px]")
                            | Trước
                    - for (let i = 1; i <= pagination.totalPages; i++)
                        if i === pagination.currentPage
                            span(class="px-[14px] py-[8px] rounded-[8px] bg-[#0088FF] text-white text-[14px] font-[700] shadow-xs" aria-current="page") #{i}
                        else
                            a(href=`?page=${i}` class="px-[14px] py-[8px] rounded-[8px] border border-[#DEDEDE] bg-white hover:border-[#0088FF] hover:text-[#0088FF] text-[#414042] text-[14px] font-[500] transition-colors") #{i}
                    if pagination.currentPage < pagination.totalPages
                        a(href=`?page=${pagination.currentPage + 1}` class="px-[14px] py-[8px] rounded-[8px] border border-[#DEDEDE] bg-white hover:border-[#0088FF] hover:text-[#0088FF] text-[#414042] text-[14px] font-[500] transition-colors")
                            | Sau
                            i(class="fa-solid fa-chevron-right text-[12px] ml-[4px]")
    //- Hết Danh sách công ty
