extends ../layouts/default.pug
include ../mixins/company-card.pug

block title 
    title #{title || "Danh sách công ty"}

block main
    //- Danh sách công ty
    div(class="py-[60px]")
        .contain
            h1(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] text-center mb-[30px]") Danh sách công ty
            div(class="grid lg:grid-cols-3 grid-cols-2 sm:gap-x-[20px] gap-x-[10px] gap-y-[20px]")
                if employers && employers.length > 0
                    each emp in employers
                        +companyCard(emp)
                else
                    div(class="col-span-full py-[40px] text-center text-[#717171] text-[16px]") Chưa có thông tin công ty nào.

            if pagination && pagination.totalPages > 1
                div(class="mt-[30px]")
                    select(class="pagination-select border border-[#DEDEDE] rounded-[8px] px-[18px] py-[12px] font-[400] text-[16px] text-[#414042] cursor-pointer") 
                        - for (let i = 1; i <= pagination.totalPages; i++)
                            option(value=i selected=(pagination.currentPage === i)) Trang #{i}
    //- Hết Danh sách công ty
