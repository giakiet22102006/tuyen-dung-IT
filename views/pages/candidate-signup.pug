extends ../layouts/default.pug

block title 
    title Đăng ký (Ứng viên)

block main
    //- Đăng kí
    div(class="py-[60px]")
        .contain 
            div(class="border border-[#DEDEDE] rounded-[8px] py-[50px] px-[20px] max-w-[602px] mx-auto")
                h1(class="font-[700] text-[20px] text-center") Đăng ký (Ứng viên)

                if flash && flash.error
                    div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[4px] text-[14px]") #{flash.error}

                form(action="/candidate/signup" method="POST" class="mt-[20px]") 
                    input(type="hidden" name="_csrf" value=csrfToken)

                    div(class="")
                        label(for="fullName" class="font-[500] text-[14px]") Họ tên *
                        input(type="text" id="fullName" name="fullName" value=(old && old.fullName ? old.fullName : "") required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.fullName
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.fullName}

                    div(class="")
                        label(for="email" class="font-[500] text-[14px]") Email *  
                        input(type="email" id="email" name="email" value=(old && old.email ? old.email : "") required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.email
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.email}

                    div(class="")
                        label(for="password" class="font-[500] text-[14px]") Mật khẩu *
                        input(type="password" id="password" name="password" required class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full") 
                        if errors && errors.password
                            div(class="text-[#FF0000] text-[13px] mt-[-10px] mb-[10px]") #{errors.password}

                    div(class="") 
                        button(type="submit" class="bg-[#0088FF] py-[14px] rounded-[4px] font-[700] text-[16px] text-white text-center w-full cursor-pointer") Đăng ký

                div(class="mt-[15px] text-center font-[400] text-[14px] text-[#414042]") Đã có tài khoản? 
                    a(href="/candidate/login" class="text-[#0088FF] font-[600] ml-[4px]") Đăng nhập ngay
    //- Hết Đăng kí
