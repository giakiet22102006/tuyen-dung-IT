extends ../layouts/default.pug

block title 
    title Đăng ký (Ứng viên)

block main
    //- Đăng ký (Ứng viên) - Modern Split-Screen Layout
    div(class="py-[30px] sm:py-[50px] lg:py-[60px]")
        .contain 
            div(class="max-w-[1040px] w-full mx-auto bg-white rounded-[16px] shadow-xl border border-gray-200/80 overflow-hidden grid grid-cols-1 lg:grid-cols-12")
                //- Panel Trái: Giới thiệu thương hiệu & Số liệu uy tín (Desktop)
                div(class="hidden lg:flex lg:col-span-5 flex-col justify-between p-[40px] bg-gradient-to-br from-[#000071] via-[#000085] to-[#0055CC] text-white relative overflow-hidden")
                    //- Hiệu ứng ánh sáng nền
                    div(class="absolute -top-[60px] -right-[60px] w-[200px] h-[200px] rounded-full bg-blue-400/20 blur-2xl pointer-events-none")
                    div(class="absolute -bottom-[80px] -left-[80px] w-[220px] h-[220px] rounded-full bg-cyan-400/15 blur-2xl pointer-events-none")

                    div(class="relative z-10")
                        div(class="flex items-center gap-[10px] mb-[28px]")
                            img(src="/assets/images/logo.svg?v=20261108" alt="VN.ITJobs Logo" class="w-[36px] h-[36px] rounded-[10px] shadow-sm object-contain")
                            span(class="font-[800] text-[22px] tracking-tight text-white") VN.ITJobs

                        h2(class="font-[800] text-[24px] leading-snug mb-[12px]")
                            | Khởi tạo hồ sơ &amp; kết nối việc làm IT mơ ước
                        p(class="text-[13.5px] text-blue-100/90 leading-relaxed")
                            | Trải nghiệm hệ thống tìm việc IT thế hệ mới với AI Matchmaking, chuẩn hóa CV tự động và phản hồi phỏng vấn tức thì.

                        //- Điểm nổi bật
                        div(class="mt-[32px] space-y-[14px]")
                            div(class="flex items-start gap-[12px]")
                                div(class="w-[28px] h-[28px] rounded-full bg-blue-400/25 text-[#93C5FD] flex items-center justify-center text-[13px] shrink-0 mt-0.5")
                                    <i class="fa-solid fa-check"></i>
                                p(class="text-[13px] text-blue-50")
                                    strong(class="text-white") 1-Click Apply:
                                    |  Ứng tuyển thần tốc với hồ sơ IT Profile trực tuyến.

                            div(class="flex items-start gap-[12px]")
                                div(class="w-[28px] h-[28px] rounded-full bg-blue-400/25 text-[#93C5FD] flex items-center justify-center text-[13px] shrink-0 mt-0.5")
                                    <i class="fa-solid fa-check"></i>
                                p(class="text-[13px] text-blue-50")
                                    strong(class="text-white") AI Career Assist:
                                    |  Đo lường độ phù hợp CV và luyện phỏng vấn với AI.

                            div(class="flex items-start gap-[12px]")
                                div(class="w-[28px] h-[28px] rounded-full bg-blue-400/25 text-[#93C5FD] flex items-center justify-center text-[13px] shrink-0 mt-0.5")
                                    <i class="fa-solid fa-check"></i>
                                p(class="text-[13px] text-blue-50")
                                    strong(class="text-white") Bảo mật thông tin:
                                    |  Dữ liệu cá nhân &amp; CV được mã hóa an toàn tuyệt đối.

                    div(class="relative z-10 pt-[24px] border-t border-white/15 text-[12px] text-blue-200/80 flex items-center justify-between")
                        span © 2026 VN.ITJobs Platform
                        span Miễn phí trọn đời cho Dev

                //- Panel Phải: Form Đăng ký
                div(class="lg:col-span-7 p-[24px] sm:p-[40px] md:p-[48px] flex flex-col justify-center")
                    div(class="max-w-[460px] w-full mx-auto")
                        h1(class="font-[800] text-[24px] sm:text-[26px] text-slate-900 tracking-tight") Đăng ký tài khoản Ứng viên
                        p(class="text-[14px] text-slate-500 mt-[4px]") Chỉ mất 30 giây để bắt đầu hành trình công nghệ mới

                        if flash && flash.error
                            div(class="mt-[15px] p-[12px] bg-[#FFEBEE] border border-[#FFCDD2] text-[#C62828] rounded-[6px] text-[13.5px] flex items-center gap-[8px]")
                                <i class="fa-solid fa-circle-exclamation"></i>
                                span #{flash.error}

                        //- Đăng ký nhanh với Google
                        div(class="mt-[20px]")
                            a(href="/candidate/auth/google" class="flex items-center justify-center gap-[10px] w-full py-[11px] px-[20px] border border-gray-300 hover:border-gray-400 hover:bg-gray-50 rounded-[8px] font-[600] text-[14px] text-slate-700 transition-all shadow-2xs")
                                svg(class="w-[18px] h-[18px]" viewBox="0 0 24 24")
                                    path(fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z")
                                    path(fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z")
                                    path(fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z")
                                    path(fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z")
                                span Đăng ký nhanh với Google

                        div(class="my-[18px] flex items-center gap-[10px]")
                            div(class="flex-1 h-[1px] bg-gray-200")
                            span(class="text-[12.5px] text-gray-400 font-[500]") hoặc tạo tài khoản bằng email
                            div(class="flex-1 h-[1px] bg-gray-200")

                        form(action="/candidate/signup" method="POST" class="space-y-[14px]") 
                            input(type="hidden" name="_csrf" value=csrfToken)

                            div
                                label(for="fullName" class="font-[600] text-[13.5px] text-slate-800 block mb-[6px]") Họ và tên *
                                input(type="text" id="fullName" name="fullName" value=(old && old.fullName ? old.fullName : "") required placeholder="Nguyễn Văn A" class="border border-gray-300 rounded-[8px] py-[10px] px-[16px] text-[14px] text-slate-900 block w-full focus:outline-none focus:border-[#0088FF] focus:ring-2 focus:ring-blue-100 transition-all") 
                                if errors && errors.fullName
                                    div(class="text-[#FF0000] text-[12.5px] mt-[4px]") #{errors.fullName}

                            div
                                label(for="email" class="font-[600] text-[13.5px] text-slate-800 block mb-[6px]") Email nhận mã kích hoạt *  
                                input(type="email" id="email" name="email" value=(old && old.email ? old.email : "") required placeholder="developer@gmail.com" class="border border-gray-300 rounded-[8px] py-[10px] px-[16px] text-[14px] text-slate-900 block w-full focus:outline-none focus:border-[#0088FF] focus:ring-2 focus:ring-blue-100 transition-all") 
                                if errors && errors.email
                                    div(class="text-[#FF0000] text-[12.5px] mt-[4px]") #{errors.email}

                            div
                                label(for="password" class="font-[600] text-[13.5px] text-slate-800 block mb-[6px]") Mật khẩu *
                                div(class="relative")
                                    input(type="password" id="password" name="password" required placeholder="Tối thiểu 8 ký tự, có chữ và số" class="border border-gray-300 rounded-[8px] py-[10px] pl-[16px] pr-[44px] text-[14px] text-slate-900 block w-full focus:outline-none focus:border-[#0088FF] focus:ring-2 focus:ring-blue-100 transition-all") 
                                    button(type="button" class="btn-toggle-password absolute right-[12px] top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 p-[4px] cursor-pointer transition-colors" data-target="password" title="Ẩn/Hiện mật khẩu" aria-label="Ẩn/Hiện mật khẩu")
                                        <i class="fa-regular fa-eye-slash text-[16px]"></i>
                                if errors && errors.password
                                    div(class="text-[#FF0000] text-[12.5px] mt-[4px]") #{errors.password}

                            div
                                label(for="confirmPassword" class="font-[600] text-[13.5px] text-slate-800 block mb-[6px]") Nhập lại mật khẩu *
                                div(class="relative")
                                    input(type="password" id="confirmPassword" name="confirmPassword" required placeholder="Nhập lại chính xác mật khẩu" class="border border-gray-300 rounded-[8px] py-[10px] pl-[16px] pr-[44px] text-[14px] text-slate-900 block w-full focus:outline-none focus:border-[#0088FF] focus:ring-2 focus:ring-blue-100 transition-all") 
                                    button(type="button" class="btn-toggle-password absolute right-[12px] top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 p-[4px] cursor-pointer transition-colors" data-target="confirmPassword" title="Ẩn/Hiện mật khẩu" aria-label="Ẩn/Hiện mật khẩu")
                                        <i class="fa-regular fa-eye-slash text-[16px]"></i>
                                div(id="confirmPasswordClientError" class="text-[#FF0000] text-[12.5px] mt-[4px] hidden") Mật khẩu nhập lại không khớp
                                if errors && errors.confirmPassword
                                    div(class="text-[#FF0000] text-[12.5px] mt-[4px]") #{errors.confirmPassword}

                            div(class="pt-[6px]") 
                                button(type="submit" class="bg-[#0088FF] hover:bg-[#0070d6] py-[12px] px-[20px] rounded-[8px] font-[700] text-[15px] sm:text-[16px] text-white text-center w-full cursor-pointer shadow-sm hover:shadow-md transition-all") Hoàn tất đăng ký

                        div(class="mt-[20px] text-center font-[400] text-[14px] text-slate-600") Đã có tài khoản? 
                            a(href="/candidate/login" class="text-[#0088FF] font-[600] hover:underline ml-[4px]") Đăng nhập ngay
    //- Hết Đăng ký
