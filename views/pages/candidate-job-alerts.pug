extends ../layouts/default.pug

block title
    title #{title || "Thông Báo Việc Làm (Job Alerts) | VN.ITJobs"}

block main
    div(class="py-[35px] sm:py-[50px] bg-[#F4F5F7] min-h-[600px]")
        .contain
            div(class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-[16px] mb-[25px]")
                div
                    h1(class="font-[800] text-[24px] sm:text-[30px] text-[#121212] flex items-center gap-[10px]")
                        i(class="fa-solid fa-bell text-[#0088FF]")
                        | Thông Báo Việc Làm (Job Alerts)
                    p(class="text-[14px] text-gray-500 mt-[4px]")
                        | Nhận thông báo qua email ngay khi có việc làm IT mới khớp với tiêu chí bạn quan tâm.
                a(href="/search" class="bg-[#0088FF] hover:bg-[#0070D2] text-white font-[600] text-[13px] sm:text-[14px] py-[9px] px-[18px] rounded-[8px] transition flex items-center gap-[6px]")
                    i(class="fa-solid fa-plus")
                    | Tạo thông báo mới từ tìm kiếm

            if alerts && alerts.length > 0
                div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[18px]")
                    each alert in alerts
                        div(class=`bg-white rounded-[12px] p-[20px] shadow-sm border transition relative ${alert.isActive ? 'border-gray-200' : 'border-gray-200 opacity-60 bg-gray-50'}`)
                            div(class="flex items-start justify-between gap-[10px] mb-[12px]")
                                div(class="flex items-center gap-[8px]")
                                    span(class=`w-[10px] h-[10px] rounded-full ${alert.isActive ? 'bg-emerald-500 animate-pulse' : 'bg-gray-400'}`)
                                    span(class="text-[12px] font-[600] uppercase text-gray-600")
                                        | #{alert.isActive ? 'Đang nhận thông báo' : 'Tạm dừng'}
                                span(class="text-[11px] text-gray-400") #{alert.frequency === 'daily' ? 'Hàng ngày' : 'Tức thì'}

                            div(class="space-y-[8px] mb-[16px]")
                                div(class="text-[15px] font-[700] text-gray-800")
                                    if alert.keyword
                                        | Từ khóa: <span class="text-[#0088FF]">#{alert.keyword}</span>
                                    else
                                        | Mọi từ khóa công nghệ
                                div(class="text-[13px] text-gray-600 flex items-center gap-[6px]")
                                    i(class="fa-solid fa-location-dot text-gray-400 text-[12px]")
                                    span Khu vực: <strong>#{alert.city ? alert.city : 'Toàn quốc'}</strong>
                                div(class="text-[13px] text-gray-600 flex items-center gap-[6px]")
                                    i(class="fa-solid fa-layer-group text-gray-400 text-[12px]")
                                    span Cấp bậc: <strong>#{alert.position ? alert.position : 'Tất cả cấp bậc'}</strong>
                                div(class="text-[12px] text-gray-500 flex items-center gap-[6px]")
                                    i(class="fa-solid fa-envelope text-gray-400 text-[12px]")
                                    span Gửi đến: <span class="font-mono text-gray-700">#{alert.email}</span>

                            div(class="pt-[14px] border-t border-gray-100 flex items-center justify-between text-[13px]")
                                form(action=`/candidate/job-alerts/${alert._id}/toggle` method="POST")
                                    input(type="hidden" name="_csrf" value=csrfToken)
                                    button(type="submit" class=`font-[600] cursor-pointer hover:underline ${alert.isActive ? 'text-amber-600' : 'text-emerald-600'}`)
                                        if alert.isActive
                                            i(class="fa-solid fa-pause mr-[4px]")
                                            | Tạm dừng
                                        else
                                            i(class="fa-solid fa-play mr-[4px]")
                                            | Bật lại

                                form(action=`/candidate/job-alerts/${alert._id}/delete` method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thông báo này?');")
                                    input(type="hidden" name="_csrf" value=csrfToken)
                                    button(type="submit" class="text-red-500 hover:text-red-700 font-[500] cursor-pointer")
                                        i(class="fa-solid fa-trash mr-[4px]")
                                        | Xóa
            else
                div(class="bg-white rounded-[12px] p-[50px] text-center shadow-sm border border-gray-100")
                    div(class="w-[70px] h-[70px] rounded-full bg-blue-50 text-[#0088FF] flex items-center justify-center mx-auto mb-[18px] text-[32px]")
                        i(class="fa-regular fa-bell")
                    h2(class="font-[700] text-[20px] text-gray-800 mb-[8px]") Bạn chưa có thông báo việc làm nào
                    p(class="text-[14px] text-gray-500 max-w-[480px] mx-auto mb-[22px]")
                        | Đăng ký nhận thông báo việc làm giúp bạn là người đầu tiên biết đến những công việc IT đãi ngộ tốt và mức lương hấp dẫn nhất.
                    div(class="flex flex-col sm:flex-row gap-[12px] justify-center")
                        a(href="/search" class="bg-[#0088FF] hover:bg-[#0070D2] text-white font-[600] text-[14px] py-[10px] px-[22px] rounded-[8px] transition")
                            i(class="fa-solid fa-magnifying-glass mr-[6px]")
                            | Tìm việc làm & Tạo thông báo
                        a(href="/salary" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-[600] text-[14px] py-[10px] px-[20px] rounded-[8px] transition")
                            i(class="fa-solid fa-calculator mr-[6px]")
                            | Tra cứu lương IT
