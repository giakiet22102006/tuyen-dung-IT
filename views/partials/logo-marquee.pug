    //- Marquee Slider Wrapper
    div(class="marquee-container relative w-full overflow-hidden")
        //- Left & Right Gradient Shadows for seamless fade effect
        div(class="pointer-events-none absolute left-0 top-0 bottom-0 w-[40px] sm:w-[120px] bg-gradient-to-r from-[#F8FAFC] to-transparent z-10")
        div(class="pointer-events-none absolute right-0 top-0 bottom-0 w-[40px] sm:w-[120px] bg-gradient-to-l from-[#F8FAFC] to-transparent z-10")

        //- Continuous Marquee Track (Double tracks for infinite loop)
        div(class="animate-marquee flex gap-[14px] sm:gap-[20px] items-center w-max py-[6px]")
            //- Track 1: Lấy trực tiếp từ Database
            each emp in displayEmployers
                a(href=`/companies/${emp.slug}` class="partner-marquee-item group inline-flex items-center gap-[12px] bg-white border border-[#E2E8F0] hover:border-[#0088FF] hover:shadow-lg px-[16px] sm:px-[18px] py-[10px] rounded-[14px] transition-all cursor-pointer shrink-0")
