//- views/partials/logo-marquee.pug
- 
    let displayEmployers = (marqueeEmployers && marqueeEmployers.length > 0) ? marqueeEmployers : [];
    if (displayEmployers.length === 0) {
        displayEmployers = [
            { companyName: 'FPT Software', slug: 'fpt-software', city: 'ha-noi', companyModel: 'Cloud & AI', jobCount: 0 },
            { companyName: 'Techcombank', slug: 'techcombank', city: 'ha-noi', companyModel: 'Digital Banking', jobCount: 0 },
            { companyName: 'MoMo Fintech', slug: 'momo', city: 'ho-chi-minh', companyModel: 'Fintech', jobCount: 0 },
            { companyName: 'VNG Corporation', slug: 'vng', city: 'ho-chi-minh', companyModel: 'Gaming & Cloud', jobCount: 0 },
            { companyName: 'Viettel Solutions', slug: 'viettel', city: 'ha-noi', companyModel: 'Chuyển đổi số', jobCount: 0 },
            { companyName: 'Shopee Việt Nam', slug: 'shopee', city: 'ho-chi-minh', companyModel: 'E-Commerce', jobCount: 0 },
            { companyName: 'LG CNS Việt Nam', slug: 'lg-cns-viet-nam', city: 'ha-noi', companyModel: 'Giải pháp IT', jobCount: 0, logo: { url: '/assets/images/demo/image1.png' } },
            { companyName: 'KMS Technology', slug: 'kms-technology', city: 'da-nang', companyModel: 'Dịch vụ phần mềm', jobCount: 0 }
        ];
    } else {
        while (displayEmployers.length < 10) {
            displayEmployers = displayEmployers.concat(displayEmployers);
        }
    }

div(class="bg-[#F8FAFC] py-[20px] sm:py-[28px] border-y border-[#E2E8F0] overflow-hidden select-none")
    div(class="contain mb-[14px] text-center")
        div(class="inline-flex items-center gap-[8px] text-[13px] sm:text-[14px] font-[500] text-[#475569]")
            <i class="fa-solid fa-handshake text-[#0088FF]"></i>
            span Nhà tuyển dụng &amp; Đối tác công nghệ
    
    //- Marquee Slider Wrapper
    div(class="marquee-container relative w-full overflow-hidden")
        div(class="pointer-events-none absolute left-0 top-0 bottom-0 w-[40px] sm:w-[100px] bg-gradient-to-r from-[#F8FAFC] to-transparent z-10")
        div(class="pointer-events-none absolute right-0 top-0 bottom-0 w-[40px] sm:w-[100px] bg-gradient-to-l from-[#F8FAFC] to-transparent z-10")

        //- Continuous Marquee Track (Double tracks for infinite loop)
        div(class="animate-marquee flex gap-[14px] sm:gap-[18px] items-center w-max py-[4px]")
            each trackIndex in [1, 2]
                each emp in displayEmployers
                    - const isLgMismatch = emp.logo && emp.logo.url && emp.logo.url.includes('/assets/images/demo/image1.png') && (!emp.companyName || !emp.companyName.toLowerCase().includes('lg'))
                    - const hasValidLogo = emp.logo && emp.logo.url && !isLgMismatch
                    a(href=`/companies/${emp.slug}` class="partner-marquee-item group inline-flex items-center gap-[12px] bg-white border border-[#E2E8F0] hover:border-[#0088FF] px-[14px] sm:px-[16px] py-[10px] rounded-[10px] transition-colors cursor-pointer shrink-0")
                        div(class="w-[40px] sm:w-[44px] h-[40px] sm:h-[44px] rounded-[8px] bg-white border border-[#E2E8F0] p-[3px] flex items-center justify-center shrink-0 overflow-hidden")
                            if hasValidLogo
                                img(src=emp.logo.url alt=emp.companyName class="w-full h-full object-contain" loading="lazy")
                            else
                                div(class="w-full h-full rounded-[6px] bg-[#0088FF] text-white flex items-center justify-center font-[600] text-[14px]")
                                    | #{emp.companyName ? emp.companyName.charAt(0).toUpperCase() : 'IT'}
                        div(class="text-left")
                            div(class="font-[600] text-[13.5px] sm:text-[14px] text-[#1E293B] group-hover:text-[#0088FF] transition-colors leading-tight max-w-[170px] truncate") #{emp.companyName}
                            div(class="flex items-center gap-[6px] mt-[3px]")
                                span(class="text-[12px] text-[#64748B] max-w-[120px] truncate") #{emp.companyModel || (labels ? labels.getCityLabel(emp.city) : emp.city) || 'Công nghệ IT'}
                                if emp.jobCount > 0
                                    span(class="text-[11px] font-[500] bg-blue-50 text-[#0088FF] border border-blue-100 px-[6px] py-[1px] rounded-full tabular-nums") #{emp.jobCount} việc
