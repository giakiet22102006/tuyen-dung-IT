div(class="bg-[#000065] py-[28px] sm:py-[40px]")
    .contain 
        h1(class="font-[600] text-[22px] sm:text-[26px] lg:text-[30px] text-white text-center mb-[12px] leading-tight text-balance") VN.ITJobs - Nền tảng tuyển dụng IT &amp; Việc làm cho Developer tại Việt Nam
        p(class="text-white/85 text-[14px] sm:text-[16px] text-center max-w-[760px] mx-auto mb-[20px] sm:mb-[24px] font-[400] tabular-nums")
            if totalPublicJobs && totalPublicJobs > 0
                | #{totalPublicJobs} cơ hội việc làm IT đang tuyển dụng tại Hà Nội, TP.HCM, Đà Nẵng và Remote. Tích hợp AI Matching so khớp CV, tra cứu lương thị trường và kết nối trực tiếp với nhà tuyển dụng công nghệ.
            else
                | Cơ hội việc làm IT tại Hà Nội, TP.HCM, Đà Nẵng và Remote. Tích hợp AI Matching so khớp CV, tra cứu lương thị trường và kết nối trực tiếp với nhà tuyển dụng công nghệ.
        form(action="/search" method="GET" class="grid grid-cols-1 md:grid-cols-[220px_minmax(0,1fr)_180px] gap-[10px] sm:gap-[12px] relative" id="headerSearchForm")
            //- Giữ lại bộ lọc đang áp dụng khi tìm lại từ thanh search (QA-M05)
            if locals.selectedSkills && locals.selectedSkills.length
                each sk in locals.selectedSkills
                    input(type="hidden" name="skill" value=sk)
            else if locals.selectedSkill
                input(type="hidden" name="skill" value=locals.selectedSkill)
            if locals.selectedCompany
                input(type="hidden" name="company" value=locals.selectedCompany)
            if locals.selectedBenefit
                input(type="hidden" name="benefit" value=locals.selectedBenefit)
            if locals.selectedPosition
                input(type="hidden" name="position" value=locals.selectedPosition)
            if locals.selectedWorkingForm
                input(type="hidden" name="workingForm" value=locals.selectedWorkingForm)
            div(class="relative w-full")
                select(name="city" aria-label="Chọn thành phố" class="w-full h-[48px] sm:h-[52px] rounded-[6px] bg-white font-[500] text-[15px] sm:text-[16px] px-[14px] py-0 leading-[48px] sm:leading-[52px] text-[#121212] border border-transparent cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0088FF]")
                    option(value="") Tất cả thành phố
                    if cities && cities.length > 0
                        each c in cities
                            option(value=c.value selected=(selectedCity === c.value)) #{c.label}
                    else
                        option(value="ha-noi" selected=(selectedCity === 'ha-noi')) Hà Nội
                        option(value="da-nang" selected=(selectedCity === 'da-nang')) Đà Nẵng
                        option(value="ho-chi-minh" selected=(selectedCity === 'ho-chi-minh')) TP. Hồ Chí Minh
                        option(value="khac" selected=(selectedCity === 'khac')) Khác

            div(class="w-full min-w-0 relative")
                input(type="text" name="keyword" id="searchKeywordInput" value=(keyword || "") placeholder="Tìm việc IT (React, Node...)" autocomplete="off" class="w-full h-[48px] sm:h-[52px] rounded-[6px] bg-white font-[500] text-[15px] sm:text-[16px] px-[16px] text-[#121212] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0088FF]")
                div(id="searchSuggestionsDropdown" class="hidden absolute left-0 right-0 top-[52px] sm:top-[56px] bg-white rounded-[6px] shadow-lg border border-gray-200 z-50 overflow-hidden text-left")

            button(type="submit" class="w-full h-[48px] sm:h-[52px] bg-[#0088FF] hover:bg-[#0070d6] transition-colors font-[600] text-[15px] sm:text-[16px] text-white flex justify-center items-center gap-[8px] rounded-[6px] cursor-pointer")
                <i class="fa-solid fa-magnifying-glass text-[16px]"></i> Tìm Kiếm

        div(class="mt-[20px] sm:mt-[30px] flex items-center gap-[8px] sm:gap-[12px] flex-wrap")
            div(class="font-[500] text-[13px] sm:text-[15px] text-[#DEDEDE]") Mọi người đang tìm kiếm:
            div(class="flex gap-[6px] sm:gap-[8px] flex-wrap")
                if topSkills && topSkills.length > 0
                    each sk in topSkills
                        a(href="/search?skill=" + sk.slug class="bg-[#121212] hover:bg-[#414042] border border-[#414042] py-[5px] sm:py-[6px] px-[10px] sm:px-[12px] font-[500] text-[12px] sm:text-[14px] text-[#DEDEDE] hover:text-white rounded-[20px] transition-colors") #{sk.name}
                else
                    a(href="/search?skill=javascript" class="bg-[#121212] hover:bg-[#414042] border border-[#414042] py-[5px] sm:py-[6px] px-[10px] sm:px-[12px] font-[500] text-[12px] sm:text-[14px] text-[#DEDEDE] hover:text-white rounded-[20px] transition-colors") Javascript
                    a(href="/search?skill=reactjs" class="bg-[#121212] hover:bg-[#414042] border border-[#414042] py-[5px] sm:py-[6px] px-[10px] sm:px-[12px] font-[500] text-[12px] sm:text-[14px] text-[#DEDEDE] hover:text-white rounded-[20px] transition-colors") ReactJS
                    a(href="/search?skill=nodejs" class="bg-[#121212] hover:bg-[#414042] border border-[#414042] py-[5px] sm:py-[6px] px-[10px] sm:px-[12px] font-[500] text-[12px] sm:text-[14px] text-[#DEDEDE] hover:text-white rounded-[20px] transition-colors") NodeJS
