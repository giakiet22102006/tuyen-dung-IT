footer(class="site-footer bg-[#000065] py-[36px] mt-auto w-full text-white/90")
    .contain 
        div(class="grid md:grid-cols-4 sm:grid-cols-2 grid-cols-1 gap-[24px] mb-[28px] text-[14px]")
            div
                div(class="font-[800] text-[24px] text-white mb-[8px]") VN.ITJobs
                p(class="text-white/70 text-[13px] leading-relaxed mb-[12px]")
                    | #{(siteSetting && siteSetting.subtitle) || "Nền tảng tuyển dụng IT và kết nối nhân tài công nghệ hàng đầu Việt Nam. Tích hợp AI Matching, tra cứu lương chuẩn xác và bảo mật tối đa."}
                div(class="text-[12px] text-white/60 space-y-[4px]")
                    div Trụ sở: #{(siteSetting && siteSetting.headOffice) || "Tòa Keangnam Landmark 72, Hà Nội"}
                    div Hotline: #{(siteSetting && siteSetting.hotline) || "+84-24-3768-9999"}
                    div Email: #{(siteSetting && siteSetting.email) || "contact@vn-itjobs.com"}

            div
                div(class="font-[700] text-white mb-[10px] text-[15px]") Khám phá cơ hội
                ul(class="space-y-[8px] text-white/75 text-[13px]")
                    li: a(href="/search" class="hover:text-white transition-colors") Việc Làm IT cho Developer
                    li: a(href="/companies" class="hover:text-white transition-colors") Danh sách Công Ty Công Nghệ
                    li: a(href="/salary" class="hover:text-white transition-colors") Tra Cứu Mức Lương IT 2026
                    li: a(href="/blog" class="hover:text-white transition-colors") Cẩm Nang Nghề Nghiệp Lập Trình

            div
                div(class="font-[700] text-white mb-[10px] text-[15px]") Về chúng tôi &amp; Pháp lý
                ul(class="space-y-[8px] text-white/75 text-[13px]")
                    li: a(href="/about" class="hover:text-white transition-colors") Giới thiệu về VN.ITJobs
                    li: a(href="/contact" class="hover:text-white transition-colors") Liên hệ Ban Quản Trị
                    li: a(href="/privacy" class="hover:text-white transition-colors") Chính sách bảo mật thông tin
                    li: a(href="/sitemap.xml" class="hover:text-white transition-colors") Sơ đồ trang (Sitemap.xml)

            div
                div(class="font-[700] text-white mb-[10px] text-[15px]") Dành cho Lập trình viên &amp; AI
                ul(class="space-y-[8px] text-white/75 text-[13px]")
                    li: a(href="/docs" class="hover:text-white transition-colors") Tài liệu API &amp; Agent Portal
                    li: a(href="/openapi.json" class="hover:text-white transition-colors" target="_blank") OpenAPI 3.1 Specification
                    li: a(href="/mcp" class="hover:text-white transition-colors") Model Context Protocol (MCP)
                    li: a(href="/llms.txt" class="hover:text-white transition-colors" target="_blank") Hướng dẫn AI Agent (llms.txt)

        div(class="pt-[20px] border-t border-white/10 text-center text-[13px] text-white/60")
            | Copyright © 2026 #{(siteSetting && siteSetting.companyName) || "VN.ITJobs"}. Nền tảng tuyển dụng IT và Việc làm Developer hàng đầu Việt Nam. #{(siteSetting && siteSetting.businessCode ? "Giấy phép ĐKDN " + siteSetting.businessCode : "Giấy phép ĐKDN số 0109988776.")}
