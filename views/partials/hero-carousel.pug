//- views/partials/hero-carousel.pug
div(class="py-[16px] sm:py-[24px] bg-[#000055]")
    div(class="w-full max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8")
        div(id="heroCarousel" class="relative overflow-hidden rounded-[12px] sm:rounded-[16px] border border-white/15 bg-[#081542] select-none")
            
            //- Slide 1: AI Smart Matching
            div(class="hero-carousel-slide active bg-[#081542] px-[44px] sm:px-[72px] lg:px-[88px] py-[28px] sm:py-[40px] lg:py-[44px] text-white")
                div(class="grid grid-cols-1 lg:grid-cols-12 gap-[24px] lg:gap-[32px] items-center relative z-10")
                    div(class="lg:col-span-7 slide-content-left min-w-0")
                        h2(class="font-[600] text-[22px] sm:text-[30px] lg:text-[34px] leading-tight mb-[12px] text-white")
                            | Sự nghiệp IT bứt phá 
                            br(class="hidden sm:inline")
                            span(class="text-[#93C5FD]") cùng công nghệ AI
                        p(class="text-white/80 text-[14px] sm:text-[15.5px] max-w-[540px] mb-[20px] leading-relaxed font-[400]")
                            | Tự động phân tích CV, so khớp kỹ năng thực tế với mô tả công việc (JD) và gợi ý cơ hội việc làm IT phù hợp với trình độ của bạn.
                        div(class="flex items-center gap-[12px] flex-wrap")
                            a(href="/candidate/it-profile" class="inline-flex items-center gap-[8px] bg-[#0088FF] hover:bg-[#0070D6] text-white font-[600] text-[14px] sm:text-[15px] px-[20px] py-[10px] sm:py-[12px] rounded-[8px] transition-colors cursor-pointer")
                                <i class="fa-solid fa-file-code"></i>
                                span Tạo Hồ Sơ IT Profile
                                <i class="fa-solid fa-arrow-right text-[12px]"></i>
                            a(href="/search" class="inline-flex items-center gap-[8px] bg-white/10 hover:bg-white/15 border border-white/20 text-white font-[500] text-[14px] sm:text-[15px] px-[18px] py-[10px] sm:py-[12px] rounded-[8px] transition-colors")
                                <i class="fa-solid fa-magnifying-glass text-[12px]"></i>
                                span Tìm việc theo kỹ năng
                    
                    div(class="lg:col-span-5 slide-content-right")
                        div(class="max-w-[340px] mx-auto bg-[#0D1E54] border border-white/15 p-[20px] rounded-[12px]")
                            div(class="flex items-center justify-between pb-[12px] border-b border-white/10 mb-[14px]")
                                div(class="flex items-center gap-[8px]")
                                    span(class="w-[8px] h-[8px] rounded-full bg-emerald-400 inline-block")
                                    span(class="font-[600] text-[13px] text-emerald-300") AI Matching Engine
                                span(class="text-[11px] text-white/75 bg-white/10 px-[8px] py-[2px] rounded font-[500]") v3.8 Flash
                            
                            div(class="flex items-center justify-between mb-[10px]")
                                span(class="text-[13px] text-white/80") Độ tương thích CV:
                                span(class="text-[18px] font-[600] text-[#9FDB7C] tabular-nums") 98% Match
                            
                            div(class="w-full bg-white/15 h-[6px] rounded-full overflow-hidden mb-[16px]")
                                div(class="bg-[#0088FF] h-full rounded-full w-[98%]")
                            
                            div(class="space-y-[8px]")
                                div(class="text-[12px] text-white/75 font-[500]") Kỹ năng đáp ứng:
                                div(class="flex flex-wrap gap-[6px]")
                                    each skillName in ['ReactJS', 'NodeJS', 'Docker', 'TypeScript']
                                        span(class="inline-flex items-center gap-[4px] bg-white/10 border border-white/15 text-emerald-200 text-[12px] font-[500] px-[8px] py-[2px] rounded-full")
                                            <i class="fa-solid fa-check text-[10px]"></i>
                                            span #{skillName}

            //- Slide 2: Salary Benchmark
            div(class="hero-carousel-slide bg-[#081542] px-[44px] sm:px-[72px] lg:px-[88px] py-[28px] sm:py-[40px] lg:py-[44px] text-white")
                div(class="grid grid-cols-1 lg:grid-cols-12 gap-[24px] lg:gap-[32px] items-center relative z-10")
                    div(class="lg:col-span-7 slide-content-left min-w-0")
                        h2(class="font-[600] text-[22px] sm:text-[30px] lg:text-[34px] leading-tight mb-[12px] text-white")
                            | Tra cứu mức lương IT 
                            br(class="hidden sm:inline")
                            span(class="text-[#93C5FD]") theo thị trường Việt Nam
                        p(class="text-white/80 text-[14px] sm:text-[15.5px] max-w-[540px] mb-[20px] leading-relaxed font-[400]")
                            | Tham khảo dữ liệu thu nhập theo vị trí, cấp bậc (Junior - Middle - Senior - Lead) và từng công nghệ cốt lõi trên hệ thống.
                        div(class="flex items-center gap-[12px] flex-wrap")
                            a(href="/salary" class="inline-flex items-center gap-[8px] bg-[#0088FF] hover:bg-[#0070D6] text-white font-[600] text-[14px] sm:text-[15px] px-[20px] py-[10px] sm:py-[12px] rounded-[8px] transition-colors cursor-pointer")
                                <i class="fa-solid fa-magnifying-glass-chart"></i>
                                span Tra cứu lương ngay
                                <i class="fa-solid fa-arrow-right text-[12px]"></i>
                            a(href="/companies" class="inline-flex items-center gap-[8px] bg-white/10 hover:bg-white/15 border border-white/20 text-white font-[500] text-[14px] sm:text-[15px] px-[18px] py-[10px] sm:py-[12px] rounded-[8px] transition-colors")
                                <i class="fa-solid fa-building text-[12px]"></i>
                                span Xem danh sách công ty
                    
                    div(class="lg:col-span-5 slide-content-right")
                        div(class="max-w-[340px] mx-auto bg-[#0D1E54] border border-white/15 p-[20px] rounded-[12px]")
                            div(class="flex items-center justify-between pb-[10px] border-b border-white/10 mb-[12px]")
                                span(class="font-[600] text-[13px] text-[#93C5FD] flex items-center gap-[6px]")
                                    <i class="fa-solid fa-chart-simple"></i> Dải lương tham khảo 2026
                                span(class="text-[11px] text-white/60") VNĐ / tháng
                            
                            div(class="space-y-[12px]")
                                div
                                    div(class="flex justify-between text-[12px] mb-[4px]")
                                        span(class="font-[500] text-white") AI / Machine Learning
                                        span(class="font-[600] text-[#9FDB7C] tabular-nums") 45 - 85 Triệu
                                    div(class="w-full bg-white/15 h-[6px] rounded-full overflow-hidden")
                                        div(class="bg-[#0088FF] h-full rounded-full w-[90%]")
                                
                                div
                                    div(class="flex justify-between text-[12px] mb-[4px]")
                                        span(class="font-[500] text-white") Senior Golang / Backend
                                        span(class="font-[600] text-[#9FDB7C] tabular-nums") 40 - 70 Triệu
                                    div(class="w-full bg-white/15 h-[6px] rounded-full overflow-hidden")
                                        div(class="bg-[#60A5FA] h-full rounded-full w-[80%]")

                                div
                                    div(class="flex justify-between text-[12px] mb-[4px]")
                                        span(class="font-[500] text-white") Fullstack React &amp; Node
                                        span(class="font-[600] text-[#9FDB7C] tabular-nums") 25 - 50 Triệu
                                    div(class="w-full bg-white/15 h-[6px] rounded-full overflow-hidden")
                                        div(class="bg-[#93C5FD] h-full rounded-full w-[65%]")

            //- Slide 3: Top Employers
            div(class="hero-carousel-slide bg-[#081542] px-[44px] sm:px-[72px] lg:px-[88px] py-[28px] sm:py-[40px] lg:py-[44px] text-white")
                div(class="grid grid-cols-1 lg:grid-cols-12 gap-[24px] lg:gap-[32px] items-center relative z-10")
                    div(class="lg:col-span-7 slide-content-left min-w-0")
                        h2(class="font-[600] text-[22px] sm:text-[30px] lg:text-[34px] leading-tight mb-[12px] text-white")
                            | Kết nối trực tiếp với 
                            br(class="hidden sm:inline")
                            span(class="text-[#93C5FD]") doanh nghiệp công nghệ
                        p(class="text-white/80 text-[14px] sm:text-[15.5px] max-w-[540px] mb-[20px] leading-relaxed font-[400]")
                            | Khám phá môi trường làm việc linh hoạt Remote / Hybrid, chế độ đãi ngộ rõ ràng và các dự án phần mềm quy mô lớn.
                        div(class="flex items-center gap-[12px] flex-wrap")
                            a(href="/companies" class="inline-flex items-center gap-[8px] bg-[#0088FF] hover:bg-[#0070D6] text-white font-[600] text-[14px] sm:text-[15px] px-[20px] py-[10px] sm:py-[12px] rounded-[8px] transition-colors cursor-pointer")
                                <i class="fa-solid fa-building"></i>
                                span Khám phá công ty
                                <i class="fa-solid fa-arrow-right text-[12px]"></i>
                            a(href="/search" class="inline-flex items-center gap-[8px] bg-white/10 hover:bg-white/15 border border-white/20 text-white font-[500] text-[14px] sm:text-[15px] px-[18px] py-[10px] sm:py-[12px] rounded-[8px] transition-colors")
                                <i class="fa-solid fa-briefcase text-[12px]"></i>
                                span Việc làm đang tuyển
                    
                    div(class="lg:col-span-5 slide-content-right")
                        div(class="max-w-[340px] mx-auto bg-[#0D1E54] border border-white/15 p-[16px] rounded-[12px] divide-y divide-white/10")
                            if topEmployers && topEmployers.length >= 3
                                each emp in topEmployers.slice(0, 3)
                                    - const isLgLogo = emp.logo && emp.logo.url && emp.logo.url.includes('/assets/images/demo/image1.png') && (!emp.companyName || !emp.companyName.toLowerCase().includes('lg'))
                                    - const hasValidLogo = emp.logo && emp.logo.url && !isLgLogo
                                    a(href=`/companies/${emp.slug}` class="flex items-center gap-[12px] py-[10px] first:pt-0 last:pb-0 hover:text-[#93C5FD] transition-colors text-white")
                                        div(class="w-[38px] h-[38px] rounded-[8px] bg-white p-[3px] flex items-center justify-center shrink-0 overflow-hidden")
                                            if hasValidLogo
                                                img(src=emp.logo.url alt=emp.companyName class="w-full h-full object-contain")
                                            else
                                                div(class="w-full h-full rounded-[6px] bg-[#0088FF] text-white flex items-center justify-center font-[600] text-[13px]") #{emp.companyName ? emp.companyName.charAt(0).toUpperCase() : 'IT'}
                                        div(class="flex-1 min-w-0")
                                            div(class="font-[600] text-[13px] text-white truncate") #{emp.companyName}
                                            div(class="text-[11px] text-white/70 truncate tabular-nums") #{emp.jobCount > 0 ? (emp.jobCount + ' vị trí đang tuyển') : (emp.companyModel || (labels ? labels.getCityLabel(emp.city) : emp.city) || 'Đang mở tuyển')}
                                        <i class="fa-solid fa-chevron-right text-[11px] text-white/50"></i>
                            else
                                div(class="flex items-center gap-[12px] py-[10px] first:pt-0")
                                    div(class="w-[38px] h-[38px] rounded-[8px] bg-[#0088FF] text-white flex items-center justify-center font-[600] text-[13px] shrink-0") FPT
                                    div(class="flex-1 min-w-0")
                                        div(class="font-[600] text-[13px] text-white truncate") FPT Software
                                        div(class="text-[11px] text-white/70") Outsourcing &amp; Dịch vụ
                                div(class="flex items-center gap-[12px] py-[10px]")
                                    div(class="w-[38px] h-[38px] rounded-[8px] bg-[#0088FF] text-white flex items-center justify-center font-[600] text-[13px] shrink-0") MM
                                    div(class="flex-1 min-w-0")
                                        div(class="font-[600] text-[13px] text-white truncate") MoMo Fintech
                                        div(class="text-[11px] text-white/70") Sản phẩm (Fintech)
                                div(class="flex items-center gap-[12px] py-[10px] last:pb-0")
                                    div(class="w-[38px] h-[38px] rounded-[8px] bg-[#0088FF] text-white flex items-center justify-center font-[600] text-[13px] shrink-0") TCB
                                    div(class="flex-1 min-w-0")
                                        div(class="font-[600] text-[13px] text-white truncate") Techcombank
                                        div(class="text-[11px] text-white/70") Ngân hàng số

            //- Nút chuyển Slide Trước / Sau
            button(type="button" id="carouselPrevBtn" class="carousel-nav-btn prev-btn absolute left-[10px] sm:left-[16px] top-1/2 -translate-y-1/2 w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center border border-white/20 hover:border-white/40 transition-colors cursor-pointer z-20" aria-label="Slide trước")
                <i class="fa-solid fa-chevron-left text-[13px] sm:text-[14px] text-white"></i>
            button(type="button" id="carouselNextBtn" class="carousel-nav-btn next-btn absolute right-[10px] sm:right-[16px] top-1/2 -translate-y-1/2 w-[36px] sm:w-[40px] h-[36px] sm:h-[40px] rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center border border-white/20 hover:border-white/40 transition-colors cursor-pointer z-20" aria-label="Slide tiếp theo")
                <i class="fa-solid fa-chevron-right text-[13px] sm:text-[14px] text-white"></i>

            //- Chấm tròn chỉ báo (Pagination Dots)
            div(id="carouselDots" class="absolute bottom-[12px] sm:bottom-[14px] left-1/2 -translate-x-1/2 flex items-center gap-[8px] z-20 px-[10px] py-[5px] rounded-full bg-black/30 border border-white/15")
                button(type="button" class="carousel-dot active w-[24px] h-[8px] rounded-full bg-white transition-colors cursor-pointer" data-index="0" aria-label="Slide 1")
                button(type="button" class="carousel-dot w-[8px] h-[8px] rounded-full bg-white/40 hover:bg-white/80 transition-colors cursor-pointer" data-index="1" aria-label="Slide 2")
                button(type="button" class="carousel-dot w-[8px] h-[8px] rounded-full bg-white/40 hover:bg-white/80 transition-colors cursor-pointer" data-index="2" aria-label="Slide 3")
