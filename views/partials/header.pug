header(class="bg-[#000071] py-[14px] sticky top-0 z-50 shadow-md")
    div(class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8")
        div(class="flex justify-between items-center gap-4 xl:gap-8")
            a(href="/" class="font-[800] sm:text-[26px] text-[20px] text-white tracking-tight shrink-0 hover:opacity-95 transition-opacity") VN.ITJobs
            nav(class="menu lg:block hidden")
                ul(class="flex items-center gap-[20px] xl:gap-[30px]")
                    li
                        a(href="/search" class="hover:text-[#9FDB7C] transition-colors") Việc Làm IT 
                        <i class="fa-solid fa-angle-down text-[12px] opacity-80"></i>
                        ul 
                            li 
                                a(href="/search") Việc làm IT theo kỹ năng
                                <i class="fa-solid fa-angle-right"></i>
                                ul 
                                    if menuData && menuData.skills && menuData.skills.length > 0
                                        each sk in menuData.skills
                                            li 
                                                a(href="/search?skill=" + sk.slug) #{sk.name}
                                    else
                                        li: a(href="/search?skill=reactjs") ReactJS
                                        li: a(href="/search?skill=nodejs") NodeJS
                                        li: a(href="/search?skill=javascript") Javascript
                                        li: a(href="/search?skill=html5") HTML5
                                        li: a(href="/search?skill=css3") CSS3
                            li
                                a(href="/companies") Việc làm IT theo công ty
                                <i class="fa-solid fa-angle-right"></i>
                                ul
                                    if menuData && menuData.topEmployers && menuData.topEmployers.length > 0
                                        each emp in menuData.topEmployers
                                            li: a(href="/companies/" + emp.slug) #{emp.companyName}
                            li
                                a(href="/search") Việc làm IT theo thành phố
                                <i class="fa-solid fa-angle-right"></i> 
                                ul
                                    if menuData && menuData.cities && menuData.cities.length > 0
                                        each c in menuData.cities
                                            li: a(href="/search?city=" + c.value) #{c.label}

                    li
                        a(href="/companies" class="hover:text-[#9FDB7C] transition-colors") Top Công Ty IT 
                        <i class="fa-solid fa-angle-down text-[12px] opacity-80"></i>
                        ul 
                            if menuData && menuData.topEmployers && menuData.topEmployers.length > 0
                                each emp in menuData.topEmployers
                                    li 
                                        a(href="/companies/" + emp.slug) #{emp.companyName}
                            else
                                li: a(href="/companies") FPT Software
                                li: a(href="/companies") Techcombank
                                li: a(href="/companies") MoMo

                    li
                        a(href="/salary" class="flex items-center gap-[6px] text-[#9FDB7C] hover:text-white transition-colors")
                            i(class="fa-solid fa-calculator text-[14px]")
                            span Tra Cứu Lương
                            span(class="bg-[#EA1E30] text-white text-[10px] font-bold px-[5px] py-[1px] rounded-full") HOT

                    li
                        a(href="/blog" class="hover:text-[#9FDB7C] transition-colors") Cẩm Nang IT

                    if !currentUser || role !== 'employer'
                        li
                            a(href="/employer/login" class="hover:text-[#9FDB7C] transition-colors") Nhà Tuyển Dụng 
                            <i class="fa-solid fa-angle-down text-[12px] opacity-80"></i>
                            ul 
                                li 
                                    a(href="/employer/login") Đăng Nhập
                                li 
                                    a(href="/employer/signup") Đăng Ký

            if currentUser
                div(class="flex items-center gap-[8px] sm:gap-[12px] shrink-0")
                    //- Notification Bell Dropdown
                    div(class="relative" id="notifDropdownContainer")
                        button(type="button" id="notifBellBtn" class="relative text-white/90 hover:text-white p-[7px] sm:p-[8px] rounded-full hover:bg-white/10 transition-colors cursor-pointer flex items-center justify-center focus:outline-none" aria-label="Thông báo")
                            <i class="fa-solid fa-bell text-[18px]"></i>
                            span(id="notifBadge" class=(unreadNotificationCount > 0 ? "" : "hidden") class="absolute -top-[2px] -right-[2px] bg-[#EA1E30] text-white text-[10px] font-[800] min-w-[18px] h-[18px] rounded-full flex items-center justify-center px-[4px] border-2 border-[#000065] shadow-sm") #{unreadNotificationCount}
                        
                        //- Dropdown Menu Popup
                        div(id="notifDropdownMenu" class="hidden absolute right-0 sm:-right-[40px] mt-[10px] w-[310px] sm:w-[380px] bg-white text-[#1E293B] rounded-[12px] shadow-2xl border border-gray-100 z-50 overflow-hidden text-left")
                            div(class="p-[12px] sm:p-[14px] bg-[#F8FAFC] border-b border-gray-100 flex items-center justify-between")
                                div(class="font-[700] text-[13.5px] sm:text-[14.5px] flex items-center gap-[6px] text-[#000065]")
                                    <i class="fa-solid fa-bell text-[#0088FF]"></i>
                                    span Thông báo
                                button(type="button" id="notifMarkAllReadBtn" class="text-[12px] text-[#0088FF] hover:underline font-[600] cursor-pointer") Đánh dấu đã đọc
                            div(id="notifListContainer" class="max-h-[360px] overflow-y-auto divide-y divide-gray-100")
                                div(class="py-[30px] text-center text-[#94A3B8] text-[13px]")
                                    <i class="fa-solid fa-spinner fa-spin mr-[6px]"></i>
                                    | Đang tải thông báo...

                    //- User Dropdown Menu
                    div(class="menu")
                        ul
                            li(class="relative py-[5px]")
                                div(class="flex items-center gap-[8px] bg-white/10 hover:bg-white/15 px-[10px] py-[6px] rounded-[6px] text-white font-[600] sm:text-[15px] text-[12px] cursor-pointer transition")
                                    <i class="fa-solid fa-circle-user text-[18px] text-[#9FDB7C]"></i>
                                    span(class="max-w-[140px] sm:max-w-[220px] truncate") #{role === 'employer' ? (currentUser.currentMember ? `${currentUser.companyName} (${currentUser.currentMember.fullName})` : currentUser.companyName) : currentUser.fullName}
                                    <i class="fa-solid fa-angle-down text-[11px] opacity-80"></i>
                                ul(class="user-dropdown-menu")
                                    if role === 'candidate'
                                        li: a(href="/candidate/profile" class="block w-full whitespace-nowrap") <i class="fa-solid fa-user mr-[6px]"></i> Thông tin cá nhân
                                        li: a(href="/candidate/it-profile" class="block w-full text-[#9FDB7C] whitespace-nowrap") <i class="fa-solid fa-file-code mr-[6px]"></i> Hồ sơ IT Profile
                                        li: a(href="/candidate/saved-jobs" class="block w-full whitespace-nowrap") <i class="fa-solid fa-bookmark mr-[6px]"></i> Việc làm đã lưu
                                        li: a(href="/candidate/followed-companies" class="block w-full whitespace-nowrap") <i class="fa-solid fa-heart mr-[6px]"></i> Công ty theo dõi
                                        li: a(href="/candidate/job-alerts" class="block w-full whitespace-nowrap") <i class="fa-solid fa-bell mr-[6px]"></i> Thông báo việc làm
                                        li: a(href="/candidate/applied-jobs" class="block w-full whitespace-nowrap") <i class="fa-solid fa-file-lines mr-[6px]"></i> CV đã gửi
                                        li: a(href="/candidate/change-password" class="block w-full whitespace-nowrap") <i class="fa-solid fa-key mr-[6px]"></i> Đổi mật khẩu
                                        li
                                            form(action="/candidate/logout" method="POST" class="w-full m-0")
                                                input(type="hidden" name="_csrf" value=csrfToken)
                                                button(type="submit" class="text-left w-full text-white cursor-pointer font-[500] text-[14.5px] whitespace-nowrap flex items-center gap-[6px]") <i class="fa-solid fa-right-from-bracket mr-[6px]"></i> Đăng xuất
                                    else if role === 'employer'
                                        li: a(href="/employer/company-profile" class="block w-full whitespace-nowrap") <i class="fa-solid fa-building mr-[6px]"></i> Thông tin công ty
                                        li: a(href="/employer/jobs" class="block w-full whitespace-nowrap") <i class="fa-solid fa-briefcase mr-[6px]"></i> Quản lý công việc
                                        li: a(href="/employer/pipeline" class="block w-full text-[#9FDB7C] whitespace-nowrap") <i class="fa-solid fa-table-columns mr-[6px]"></i> Hiring Pipeline (Kanban)
                                        li: a(href="/employer/candidates" class="block w-full text-[#60A5FA] whitespace-nowrap font-[600]") <i class="fa-solid fa-users-viewfinder mr-[6px]"></i> Săn Ứng Viên IT (Talent)
                                        li: a(href="/employer/cvs" class="block w-full whitespace-nowrap") <i class="fa-solid fa-id-card mr-[6px]"></i> Quản lý CV
                                        li: a(href="/employer/analytics" class="block w-full whitespace-nowrap") <i class="fa-solid fa-chart-line mr-[6px]"></i> Báo cáo tuyển dụng
                                        li: a(href="/employer/team" class="block w-full whitespace-nowrap") <i class="fa-solid fa-user-group mr-[6px]"></i> Nhóm tuyển dụng (HR)
                                        li: a(href="/employer/change-password" class="block w-full whitespace-nowrap") <i class="fa-solid fa-key mr-[6px]"></i> Đổi mật khẩu
                                        li
                                            form(action="/employer/logout" method="POST" class="w-full m-0")
                                                input(type="hidden" name="_csrf" value=csrfToken)
                                                button(type="submit" class="text-left w-full text-white cursor-pointer font-[500] text-[14.5px] whitespace-nowrap flex items-center gap-[6px]") <i class="fa-solid fa-right-from-bracket mr-[6px]"></i> Đăng xuất
            else
                div(class="font-[600] sm:text-[15px] text-[12px] text-white flex gap-[8px] items-center shrink-0")
                    a(href="/candidate/login" class="hover:text-[#9FDB7C] px-[10px] py-[6px] rounded hover:bg-white/10 transition") Đăng Nhập
                    span(class="opacity-40") |
                    a(href="/candidate/signup" class="bg-[#0088FF] hover:bg-[#0077E6] text-white px-[12px] py-[6px] rounded-[6px] font-[600] transition shadow-sm") Đăng Ký
            
            button(id="mobileMenuBtn" class="lg:hidden text-white text-[24px] ml-[10px] p-[6px] rounded hover:bg-white/10 cursor-pointer focus:outline-none transition-colors" aria-label="Toggle mobile menu")
                <i class="fa-solid fa-bars"></i>

        //- Mobile Navigation Menu (Drawer/Accordion xổ xuống trên mobile)
        div(id="mobileNav" class="hidden lg:hidden mt-[15px] pt-[15px] border-t border-[#1E1E8E] text-white transition-all")
            ul(class="flex flex-col gap-[10px] font-[500] text-[15px]")
                li
                    a(href="/search" class="flex items-center gap-[10px] py-[8px] px-[10px] rounded hover:bg-white/10 transition") <i class="fa-solid fa-briefcase text-[16px] text-[#0088FF]"></i> Việc Làm IT
                li
                    a(href="/companies" class="flex items-center gap-[10px] py-[8px] px-[10px] rounded hover:bg-white/10 transition") <i class="fa-solid fa-building text-[16px] text-[#0088FF]"></i> Top Công Ty IT
                li
                    a(href="/salary" class="flex items-center gap-[10px] py-[8px] px-[10px] rounded hover:bg-white/10 transition text-[#9FDB7C]") <i class="fa-solid fa-calculator text-[16px] text-[#9FDB7C]"></i> Tra Cứu Lương IT <span class="bg-[#EA1E30] text-white text-[10px] font-bold px-[5px] py-[1px] rounded-full ml-auto">HOT</span>
                li
                    a(href="/blog" class="flex items-center gap-[10px] py-[8px] px-[10px] rounded hover:bg-white/10 transition") <i class="fa-solid fa-book-open text-[16px] text-[#0088FF]"></i> Cẩm Nang IT
                
                //- Kỹ năng hot tìm nhanh trên mobile
                li(class="py-[4px]")
                    div(class="text-[12px] font-[600] text-[#A6A6A6] uppercase px-[10px] mb-[6px]") Tìm nhanh theo kỹ năng
                    div(class="flex flex-wrap gap-[6px] px-[10px]")
                        each sk in ['ReactJS', 'NodeJS', 'Python', 'Java', 'DevOps', 'Golang']
                            a(href=`/search?skill=${sk.toLowerCase()}` class="bg-white/10 hover:bg-white/20 text-white text-[12px] py-[4px] px-[10px] rounded-[14px]") #{sk}

                if currentUser
                    li(class="border-t border-[#1E1E8E] pt-[12px] mt-[4px]")
                        div(class="font-[600] text-[#0088FF] text-[14px] mb-[6px] px-[10px]") <i class="fa-solid fa-circle-user mr-[6px]"></i> #{role === 'employer' ? (currentUser.currentMember ? `${currentUser.companyName} (${currentUser.currentMember.fullName})` : currentUser.companyName) : currentUser.fullName}
                    if role === 'candidate'
                        li: a(href="/candidate/profile" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-user mr-[8px] text-[14px]"></i> Thông tin cá nhân
                        li: a(href="/candidate/it-profile" class="block py-[6px] px-[10px] rounded hover:bg-white/10 text-[#9FDB7C]") <i class="fa-solid fa-file-code mr-[8px] text-[14px]"></i> Hồ sơ IT Profile
                        li: a(href="/candidate/saved-jobs" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-bookmark mr-[8px] text-[14px]"></i> Việc làm đã lưu
                        li: a(href="/candidate/followed-companies" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-heart mr-[8px] text-[14px]"></i> Công ty theo dõi
                        li: a(href="/candidate/job-alerts" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-bell mr-[8px] text-[14px]"></i> Thông báo việc làm
                        li: a(href="/candidate/applied-jobs" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-file-lines mr-[8px] text-[14px]"></i> CV đã gửi
                        li: a(href="/candidate/change-password" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-key mr-[8px] text-[14px]"></i> Đổi mật khẩu
                        li
                            form(action="/candidate/logout" method="POST" class="px-[10px] mt-[4px]")
                                input(type="hidden" name="_csrf" value=csrfToken)
                                button(type="submit" class="text-left text-[#FF4D4F] hover:underline font-[500] text-[14px] cursor-pointer py-[4px]") <i class="fa-solid fa-right-from-bracket mr-[8px]"></i> Đăng xuất
                    else if role === 'employer'
                        li: a(href="/employer/company-profile" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-building-user mr-[8px] text-[14px]"></i> Thông tin công ty
                        li: a(href="/employer/jobs" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-list-check mr-[8px] text-[14px]"></i> Quản lý việc làm
                        li: a(href="/employer/pipeline" class="block py-[6px] px-[10px] rounded hover:bg-white/10 text-[#9FDB7C]") <i class="fa-solid fa-table-columns mr-[8px] text-[14px]"></i> Hiring Pipeline (Kanban)
                        li: a(href="/employer/cvs" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-address-card mr-[8px] text-[14px]"></i> Quản lý CV
                        li: a(href="/employer/change-password" class="block py-[6px] px-[10px] rounded hover:bg-white/10") <i class="fa-solid fa-key mr-[8px] text-[14px]"></i> Đổi mật khẩu
                        li
                            form(action="/employer/logout" method="POST" class="px-[10px] mt-[4px]")
                                input(type="hidden" name="_csrf" value=csrfToken)
                                button(type="submit" class="text-left text-[#FF4D4F] hover:underline font-[500] text-[14px] cursor-pointer py-[4px]") <i class="fa-solid fa-right-from-bracket mr-[8px]"></i> Đăng xuất
                else
                    li(class="border-t border-[#1E1E8E] pt-[12px] mt-[4px] px-[10px]")
                        div(class="font-[600] text-[#A6A6A6] text-[12px] uppercase mb-[8px]") Dành cho Ứng viên
                        div(class="grid grid-cols-2 gap-[10px]")
                            a(href="/candidate/login" class="bg-[#0088FF] text-white py-[8px] px-[12px] rounded-[4px] text-[13px] font-[600] text-center") Đăng nhập
                            a(href="/candidate/signup" class="border border-white/60 text-white py-[8px] px-[12px] rounded-[4px] text-[13px] font-[600] text-center") Đăng ký
                    li(class="pt-[8px] px-[10px]")
                        div(class="font-[600] text-[#A6A6A6] text-[12px] uppercase mb-[8px]") Dành cho Nhà tuyển dụng
                        div(class="grid grid-cols-2 gap-[10px]")
                            a(href="/employer/login" class="bg-[#121212] border border-[#414042] text-white py-[8px] px-[12px] rounded-[4px] text-[13px] font-[600] text-center") Đăng nhập NTD
                            a(href="/employer/signup" class="border border-[#414042] text-white py-[8px] px-[12px] rounded-[4px] text-[13px] font-[600] text-center") Đăng ký NTD
