header(class="bg-[#000071] py-[15px]")
    .contain 
        div(class="flex justify-between items-center")
            a(href="/" class="font-[800] sm:text-[28px] text-[20px] text-white lg:flex-none flex-1") VN.ITJobs
            nav(class="menu lg:block hidden")
                ul 
                    li
                        a(href="/search") Việc Làm IT 
                        <i class="fa-solid fa-angle-down"></i>
                        ul 
                            li 
                                a(href="/search") Việc làm IT theo kỹ năng
                                <i class="fa-solid fa-angle-right"></i>
                                ul 
                                    if menuData && menuData.skills && menuData.skills.length > 0
                                        each sk in menuData.skills
                                            li 
                                                a(href="/search?skill=" + sk.slug) #{sk.name}
                                    else
                                        li: a(href="/search?skill=reactjs") ReactJS
                                        li: a(href="/search?skill=nodejs") NodeJS
                                        li: a(href="/search?skill=javascript") Javascript
                                        li: a(href="/search?skill=html5") HTML5
                                        li: a(href="/search?skill=css3") CSS3
                            li
                                a(href="/companies") Việc làm IT theo công ty
                                <i class="fa-solid fa-angle-right"></i>
                                ul
                                    if menuData && menuData.topEmployers && menuData.topEmployers.length > 0
                                        each emp in menuData.topEmployers
                                            li: a(href="/companies/" + emp.slug) #{emp.companyName}
                            li
                                a(href="/search") Việc làm IT theo thành phố
                                <i class="fa-solid fa-angle-right"></i> 
                                ul
                                    if menuData && menuData.cities && menuData.cities.length > 0
                                        each c in menuData.cities
                                            li: a(href="/search?city=" + c.value) #{c.label}

                    li
                        a(href="/companies") Top Công Ty IT 
                        <i class="fa-solid fa-angle-down"></i>
                        ul 
                            if menuData && menuData.topEmployers && menuData.topEmployers.length > 0
                                each emp in menuData.topEmployers
                                    li 
                                        a(href="/companies/" + emp.slug) #{emp.companyName}
                            else
                                li: a(href="/companies") FPT Software
                                li: a(href="/companies") Techcombank
                                li: a(href="/companies") MoMo

                    li
                        a(href="/employer/login") Nhà Tuyển Dụng 
                        <i class="fa-solid fa-angle-down"></i>
                        ul 
                            li 
                                a(href="/employer/login") Đăng Nhập
                            li 
                                a(href="/employer/signup") Đăng Ký

            if currentUser
                div(class="menu")
                    ul
                        li(class="relative py-[5px]")
                            div(class="flex items-center gap-[6px] text-white font-[600] sm:text-[16px] text-[12px] cursor-pointer")
                                <i class="fa-solid fa-circle-user text-[18px]"></i>
                                span(class="max-w-[140px] sm:max-w-[180px] truncate") #{role === 'employer' ? currentUser.companyName : currentUser.fullName}
                                <i class="fa-solid fa-angle-down text-[12px]"></i>
                            ul(class="right-0 left-auto w-[220px] rounded-[4px] shadow-lg z-50")
                                if role === 'candidate'
                                    li: a(href="/candidate/profile" class="block w-full") Thông tin cá nhân
                                    li: a(href="/candidate/applied-jobs" class="block w-full") CV đã gửi
                                    li: a(href="/candidate/change-password" class="block w-full") Đổi mật khẩu
                                    li
                                        form(action="/candidate/logout" method="POST" class="w-full")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            button(type="submit" class="text-left w-full text-white cursor-pointer font-[600] text-[16px]") Đăng xuất
                                else if role === 'employer'
                                    li: a(href="/employer/company-profile" class="block w-full") Thông tin công ty
                                    li: a(href="/employer/jobs" class="block w-full") Quản lý công việc
                                    li: a(href="/employer/cvs" class="block w-full") Quản lý CV
                                    li: a(href="/employer/change-password" class="block w-full") Đổi mật khẩu
                                    li
                                        form(action="/employer/logout" method="POST" class="w-full")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            button(type="submit" class="text-left w-full text-white cursor-pointer font-[600] text-[16px]") Đăng xuất
            else
                div(class="font-[600] sm:text-[16px] text-[12px] text-white flex gap-[5px] items-center")
                    a(href="/candidate/login") Đăng Nhập
                    span /
                    a(href="/candidate/signup") Đăng Ký
            
            button(id="mobileMenuBtn" class="lg:hidden text-white text-[22px] ml-[12px] cursor-pointer")
                <i class="fa-solid fa-bars"></i>
