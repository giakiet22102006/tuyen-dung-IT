header(class="bg-[#000071] py-[15px] sticky top-0 z-50 shadow-md")
    .contain 
        div(class="flex justify-between items-center")
            a(href="/" class="font-[800] sm:text-[28px] text-[20px] text-white lg:flex-none flex-1") VN.ITJobs
            nav(class="menu lg:block hidden")
                ul 
                    li
                        a(href="/search") Việc Làm IT 
                        <i class="fa-solid fa-angle-down"></i>
                        ul 
                            li 
                                a(href="/search") Việc làm IT theo kỹ năng
                                <i class="fa-solid fa-angle-right"></i>
                                ul 
                                    if menuData && menuData.skills && menuData.skills.length > 0
                                        each sk in menuData.skills
                                            li 
                                                a(href="/search?skill=" + sk.slug) #{sk.name}
                                    else
                                        li: a(href="/search?skill=reactjs") ReactJS
                                        li: a(href="/search?skill=nodejs") NodeJS
                                        li: a(href="/search?skill=javascript") Javascript
                                        li: a(href="/search?skill=html5") HTML5
                                        li: a(href="/search?skill=css3") CSS3
                            li
                                a(href="/companies") Việc làm IT theo công ty
                                <i class="fa-solid fa-angle-right"></i>
                                ul
                                    if menuData && menuData.topEmployers && menuData.topEmployers.length > 0
                                        each emp in menuData.topEmployers
                                            li: a(href="/companies/" + emp.slug) #{emp.companyName}
                            li
                                a(href="/search") Việc làm IT theo thành phố
                                <i class="fa-solid fa-angle-right"></i> 
                                ul
                                    if menuData && menuData.cities && menuData.cities.length > 0
                                        each c in menuData.cities
                                            li: a(href="/search?city=" + c.value) #{c.label}

                    li
                        a(href="/companies") Top Công Ty IT 
                        <i class="fa-solid fa-angle-down"></i>
                        ul 
                            if menuData && menuData.topEmployers && menuData.topEmployers.length > 0
                                each emp in menuData.topEmployers
                                    li 
                                        a(href="/companies/" + emp.slug) #{emp.companyName}
                            else
                                li: a(href="/companies") FPT Software
                                li: a(href="/companies") Techcombank
                                li: a(href="/companies") MoMo

                    li
                        a(href="/employer/login") Nhà Tuyển Dụng 
                        <i class="fa-solid fa-angle-down"></i>
                        ul 
                            li 
                                a(href="/employer/login") Đăng Nhập
                            li 
                                a(href="/employer/signup") Đăng Ký

            if currentUser
                div(class="menu")
                    ul
                        li(class="relative py-[5px]")
                            div(class="flex items-center gap-[6px] text-white font-[600] sm:text-[16px] text-[12px] cursor-pointer")
                                <i class="fa-solid fa-circle-user text-[18px]"></i>
                                span(class="max-w-[140px] sm:max-w-[180px] truncate") #{role === 'employer' ? currentUser.companyName : currentUser.fullName}
                                <i class="fa-solid fa-angle-down text-[12px]"></i>
                            ul(class="right-0 left-auto w-[220px] rounded-[4px] shadow-lg z-50")
                                if role === 'candidate'
                                    li: a(href="/candidate/profile" class="block w-full") Thông tin cá nhân
                                    li: a(href="/candidate/applied-jobs" class="block w-full") CV đã gửi
                                    li: a(href="/candidate/change-password" class="block w-full") Đổi mật khẩu
                                    li
                                        form(action="/candidate/logout" method="POST" class="w-full")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            button(type="submit" class="text-left w-full text-white cursor-pointer font-[600] text-[16px]") Đăng xuất
                                else if role === 'employer'
                                    li: a(href="/employer/company-profile" class="block w-full") Thông tin công ty
                                    li: a(href="/employer/jobs" class="block w-full") Quản lý công việc
                                    li: a(href="/employer/cvs" class="block w-full") Quản lý CV
                                    li: a(href="/employer/change-password" class="block w-full") Đổi mật khẩu
                                    li
                                        form(action="/employer/logout" method="POST" class="w-full")
                                            input(type="hidden" name="_csrf" value=csrfToken)
                                            button(type="submit" class="text-left w-full text-white cursor-pointer font-[600] text-[16px]") Đăng xuất
            else
                div(class="font-[600] sm:text-[16px] text-[12px] text-white flex gap-[5px] items-center")
                    a(href="/candidate/login") Đăng Nhập
                    span /
                    a(href="/candidate/signup") Đăng Ký
            
            button(id="mobileMenuBtn" class="lg:hidden text-white text-[22px] ml-[12px] cursor-pointer" aria-label="Toggle mobile menu")
                <i class="fa-solid fa-bars"></i>

        //- Mobile Navigation Menu (Drawer/Accordion xổ xuống trên mobile)
        div(id="mobileNav" class="hidden lg:hidden mt-[15px] pt-[15px] border-t border-[#1E1E8E] text-white transition-all")
            ul(class="flex flex-col gap-[12px] font-[500] text-[15px]")
                li
                    a(href="/search" class="block py-[6px] hover:text-[#0088FF] transition") <i class="fa-solid fa-briefcase mr-[8px] text-[14px]"></i> Việc Làm IT
                li
                    a(href="/companies" class="block py-[6px] hover:text-[#0088FF] transition") <i class="fa-solid fa-building mr-[8px] text-[14px]"></i> Top Công Ty IT
                
                if currentUser
                    li(class="border-t border-[#1E1E8E] pt-[12px] mt-[4px]")
                        div(class="font-[600] text-[#0088FF] text-[14px] mb-[6px]") Tài khoản: #{role === 'employer' ? currentUser.companyName : currentUser.fullName}
                    if role === 'candidate'
                        li: a(href="/candidate/profile" class="block py-[4px] pl-[12px] hover:text-[#0088FF]") <i class="fa-solid fa-user mr-[8px]"></i> Thông tin cá nhân
                        li: a(href="/candidate/applied-jobs" class="block py-[4px] pl-[12px] hover:text-[#0088FF]") <i class="fa-solid fa-file-lines mr-[8px]"></i> CV đã gửi
                        li: a(href="/candidate/change-password" class="block py-[4px] pl-[12px] hover:text-[#0088FF]") <i class="fa-solid fa-key mr-[8px]"></i> Đổi mật khẩu
                        li
                            form(action="/candidate/logout" method="POST" class="pl-[12px] mt-[4px]")
                                input(type="hidden" name="_csrf" value=csrfToken)
                                button(type="submit" class="text-left text-[#FF4D4F] hover:underline font-[500] text-[14px] cursor-pointer") <i class="fa-solid fa-right-from-bracket mr-[8px]"></i> Đăng xuất
                    else if role === 'employer'
                        li: a(href="/employer/company-profile" class="block py-[4px] pl-[12px] hover:text-[#0088FF]") <i class="fa-solid fa-building-user mr-[8px]"></i> Thông tin công ty
                        li: a(href="/employer/jobs" class="block py-[4px] pl-[12px] hover:text-[#0088FF]") <i class="fa-solid fa-list-check mr-[8px]"></i> Quản lý việc làm
                        li: a(href="/employer/cvs" class="block py-[4px] pl-[12px] hover:text-[#0088FF]") <i class="fa-solid fa-address-card mr-[8px]"></i> Quản lý CV
                        li: a(href="/employer/change-password" class="block py-[4px] pl-[12px] hover:text-[#0088FF]") <i class="fa-solid fa-key mr-[8px]"></i> Đổi mật khẩu
                        li
                            form(action="/employer/logout" method="POST" class="pl-[12px] mt-[4px]")
                                input(type="hidden" name="_csrf" value=csrfToken)
                                button(type="submit" class="text-left text-[#FF4D4F] hover:underline font-[500] text-[14px] cursor-pointer") <i class="fa-solid fa-right-from-bracket mr-[8px]"></i> Đăng xuất
                else
                    li(class="border-t border-[#1E1E8E] pt-[12px] mt-[4px]")
                        div(class="font-[600] text-[#A6A6A6] text-[13px] uppercase mb-[8px]") Dành cho Ứng viên
                        div(class="flex gap-[10px]")
                            a(href="/candidate/login" class="bg-[#0088FF] text-white py-[8px] px-[16px] rounded-[4px] text-[14px] font-[600]") Đăng nhập
                            a(href="/candidate/signup" class="border border-white text-white py-[8px] px-[16px] rounded-[4px] text-[14px] font-[600]") Đăng ký
                    li(class="pt-[8px]")
                        div(class="font-[600] text-[#A6A6A6] text-[13px] uppercase mb-[8px]") Dành cho Nhà tuyển dụng
                        div(class="flex gap-[10px]")
                            a(href="/employer/login" class="bg-[#121212] border border-[#414042] text-white py-[8px] px-[16px] rounded-[4px] text-[14px] font-[600]") Đăng nhập NTD
                            a(href="/employer/signup" class="border border-[#414042] text-white py-[8px] px-[16px] rounded-[4px] text-[14px] font-[600]") Đăng ký NTD
